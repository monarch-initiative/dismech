// Minimal hypothalamic-pituitary-thyroid (HPT) negative-feedback model.
//
// A didactic two-state model of thyroid homeostasis authored for dismech-perturb
// (in the same spirit as the hand-authored CKD-MBD Antimony extension). It is not
// a BioModels deposit; it encodes the textbook HPT feedback loop so that congenital
// hypothyroidism and its treatment (levothyroxine) can be explored as parameter
// perturbations. Calibrated to a euthyroid steady state of TSH ~1.5 mU/L and
// free T4 ~15 pmol/L.
//
//   dTSH/dt = P_pit * TSH_prod / (1 + (FT4/Kfb)^n) - kdeg_TSH * TSH
//   dFT4/dt = secr * S_thy * TSH + LT4 - kdeg_T4 * FT4
//
// Pituitary TSH output is suppressed by free T4 (negative feedback); the thyroid
// secretes T4 in proportion to TSH scaled by secretory capacity S_thy. Levothyroxine
// (LT4) is an exogenous, TSH-independent T4 source.

model hpt_feedback_axis()
  species TSH, FT4;
  TSH = 1.5;      // thyroid-stimulating hormone (mU/L)
  FT4 = 15;       // free thyroxine (pmol/L)

  TSH_prod = 100; // maximal pituitary TSH output
  kdeg_TSH = 1.0; // TSH clearance rate
  Kfb = 6.49;     // free-T4 feedback set-point
  n = 5;          // feedback steepness (Hill coefficient)
  secr = 0.5;     // T4 secreted per unit TSH * thyroid capacity
  S_thy = 1.0;    // thyroid secretory capacity (1 = normal; the disease-severity dial)
  kdeg_T4 = 0.05; // free-T4 clearance rate
  LT4 = 0.01;     // exogenous levothyroxine T4 supply (~0 = untreated; raised by treatment)
  P_pit = 1.0;    // pituitary TSH-production capacity (reduced in central hypothyroidism)

  TSH_synthesis: -> TSH; P_pit * TSH_prod / (1 + (FT4/Kfb)^n) - kdeg_TSH * TSH;
  T4_synthesis:  -> FT4; secr * S_thy * TSH + LT4 - kdeg_T4 * FT4;
end
