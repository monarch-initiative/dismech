<?xml version="1.0" encoding="UTF-8"?>
<sbml xmlns="http://www.sbml.org/sbml/level3/version2/core" level="3" version="2">
  <model metaid="urate_homeostasis" id="urate_homeostasis">
    <listOfCompartments>
      <compartment sboTerm="SBO:0000410" id="default_compartment" spatialDimensions="3" size="1" constant="true"/>
    </listOfCompartments>
    <listOfSpecies>
      <species id="U" compartment="default_compartment" initialConcentration="5" hasOnlySubstanceUnits="false" boundaryCondition="false" constant="false"/>
    </listOfSpecies>
    <listOfParameters>
      <parameter id="k_prod" value="5" constant="true"/>
      <parameter id="P" value="1" constant="true"/>
      <parameter id="XO" value="1" constant="true"/>
      <parameter id="k_exc" value="1" constant="true"/>
      <parameter id="f_exc" value="1" constant="true"/>
      <parameter id="k_uricase" value="0.001" constant="true"/>
    </listOfParameters>
    <listOfReactions>
      <reaction id="production" reversible="true">
        <listOfProducts>
          <speciesReference species="U" stoichiometry="1" constant="true"/>
        </listOfProducts>
        <kineticLaw>
          <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
              <times/>
              <ci> k_prod </ci>
              <ci> P </ci>
              <ci> XO </ci>
            </apply>
          </math>
        </kineticLaw>
      </reaction>
      <reaction id="clearance" reversible="true">
        <listOfReactants>
          <speciesReference species="U" stoichiometry="1" constant="true"/>
        </listOfReactants>
        <kineticLaw>
          <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
              <times/>
              <apply>
                <plus/>
                <apply>
                  <times/>
                  <ci> k_exc </ci>
                  <ci> f_exc </ci>
                </apply>
                <ci> k_uricase </ci>
              </apply>
              <ci> U </ci>
            </apply>
          </math>
        </kineticLaw>
      </reaction>
    </listOfReactions>
  </model>
</sbml>
