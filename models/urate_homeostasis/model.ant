// Minimal urate (serum uric acid) homeostasis model.
//
// A single-compartment steady-state balance of urate production and elimination,
// authored for dismech-perturb (like the CKD-MBD Antimony component; not a
// BioModels deposit). Calibrated to a normal serum urate of ~5 mg/dL.
//
//   dU/dt = k_prod * P * XO - (k_exc * f_exc + k_uricase) * U
//
// Production is purine turnover (P) processed by xanthine oxidase (XO, the
// allopurinol/febuxostat target). Elimination is renal/gut excretion scaled by
// fractional excretion (f_exc, lowered by ABCG2 loss, raised by uricosurics or
// URAT1/GLUT9 loss) plus uricase activity (k_uricase; humans have essentially
// none, but recombinant uricase / pegloticase supplies it).

model urate_homeostasis()
  species U;
  U = 5;              // serum urate (mg/dL)

  k_prod = 5.0;       // base urate production rate
  P = 1.0;            // purine load / production capacity (raised in overproduction)
  XO = 1.0;           // xanthine oxidase activity (allopurinol/febuxostat target)
  k_exc = 1.0;        // base renal/gut excretion rate constant
  f_exc = 1.0;        // fractional excretion (the disease-severity dial)
  k_uricase = 0.001;  // uricase activity (~0 in humans; raised by pegloticase)

  production: -> U; k_prod * P * XO;
  clearance:  U -> ; (k_exc * f_exc + k_uricase) * U;
end
