{# One ontology-bound descriptor as a tag pill with its CURIE chip and plain-
   language tooltip. Wrapped by render_descriptor_tag on the disorder and module
   pages; expects `descriptor`, `tag_class`, `role`, plus pill_tips,
   render_curie_link and render_descriptor_qualifiers in context. #}
{% if descriptor %}
{% set term_label = descriptor.term.label if descriptor.term else '' %}
{% set display = descriptor.preferred_term or term_label or descriptor.name or '' %}
{% set tooltip = term_tooltip(descriptor, role) %}
{% if display %}
{% set pill_tips.n = pill_tips.n + 1 %}{% set tip_id = "pill-tip-" ~ pill_tips.n %}
{# The chip is conditional, so the pill only needs its own tab stop when no
   chip renders -- otherwise the chip is the single stop that both reveals
   the tooltip (via :focus-within) and announces it (via aria-describedby). #}
{% set has_chip = descriptor.term and descriptor.term.id %}
<span class="tag {{ tag_class }}"{% if tooltip and not has_chip %} tabindex="0" aria-describedby="{{ tip_id }}"{% endif %}>
    {% if has_chip %}
    {{ display }} {{ render_curie_link(descriptor.term.id, describedby=tip_id) }}
    {% else %}
    {{ display }}
    {% endif %}
    {% if tooltip %}<span class="pill-tip" role="tooltip" id="{{ tip_id }}">{{ tooltip }}</span>{% endif %}
</span>
{{ render_descriptor_qualifiers(descriptor) }}
{% endif %}
{% endif %}
