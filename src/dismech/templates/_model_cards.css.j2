        /* Model cards (experimental, animal, computational) and the readout,
           findings and pathograph-link blocks inside them. Shared by the
           disorder and module pages through _model_cards.html.j2 (#13123). */

        .crosslink-meta {
            color: #0f766e;
            font-size: 0.78rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.03em;
            margin-left: 6px;
        }

        .tag-phenotype {
            background: #dcfce7;
            color: #166534;
        }

        .tag-biomarker {
            background: #ffedd5;
            color: #c2410c;
        }

        .tag-dataset {
            background: #e0f2fe;
            color: #0369a1;
        }

        .mapping-notes {
            font-size: 0.85rem;
            color: var(--text-muted);
            margin-top: 6px;
        }

        .findings-section {
            margin-top: 12px;
        }

        .findings-title {
            font-size: 0.75rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            color: var(--text-muted);
            margin-bottom: 6px;
        }

        .finding-item {
            padding: 10px 12px;
            background: #f8fafc;
            border-radius: 8px;
            margin-bottom: 8px;
            border: 1px solid #e2e8f0;
            font-size: 0.9rem;
        }

        .finding-statement {
            font-weight: 600;
            color: var(--text);
            margin-bottom: 6px;
            line-height: 1.5;
        }

        .finding-supporting {
            font-size: 0.85rem;
            color: var(--text-muted);
            margin-top: 6px;
            padding-left: 12px;
            border-left: 2px solid #cbd5e1;
            font-style: italic;
            line-height: 1.5;
        }

        .experiment-section {
            margin-top: 12px;
            padding-top: 10px;
            border-top: 1px solid #e2e8f0;
        }

        .experiment-section-title {
            font-size: 0.74rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            color: #475569;
            margin-bottom: 6px;
        }

        .experiment-subitem {
            padding: 10px 12px;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            background: #f8fafc;
            margin-bottom: 8px;
            font-size: 0.88rem;
            line-height: 1.5;
        }

        .experiment-subitem-name {
            font-weight: 700;
            color: #334155;
            margin-bottom: 4px;
        }

        /* Experimental Models */
        .exp-model-box {
            background: #fffbeb;
            border-left: 4px solid #f59e0b;
        }
        .exp-model-box .item-name { color: #92400e; }
        .exp-model-box .item-desc { color: #b45309; }

        .tag-exp-model-type {
            background: #fef3c7;
            color: #92400e;
        }
        .tag-namo-type {
            background: #ffedd5;
            color: #c2410c;
        }
        .tag-condition {
            background: #fef3c7;
            color: #92400e;
        }

        .model-detail-list {
            display: grid;
            gap: 8px;
            margin-top: 12px;
        }
        .model-detail-row {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            font-size: 0.88rem;
        }
        .model-detail-label {
            font-weight: 600;
            color: var(--text);
            min-width: 110px;
        }
        .model-detail-value {
            color: var(--text-muted);
            flex: 1;
            min-width: 0;
        }
        .model-detail-value a {
            color: inherit;
        }

        /* Computational Models */
        .comp-model-box {
            background: #f0fdf4;
            border-left: 4px solid #22c55e;
        }
        .comp-model-box .item-name { color: #166534; }
        .comp-model-box .item-desc { color: #15803d; }

        .tag-format {
            background: #dcfce7;
            color: #166534;
        }
        .tag-software {
            background: #d1fae5;
            color: #065f46;
        }
        .tag-model-type {
            background: #e0f2fe;
            color: #0369a1;
        }

        .model-variables-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 12px;
            font-size: 0.85rem;
        }
        .model-variables-table th {
            background: #f0fdf4;
            color: #166534;
            padding: 8px 12px;
            text-align: left;
            border-bottom: 2px solid #86efac;
            font-weight: 600;
        }
        .model-variables-table td {
            padding: 8px 12px;
            border-bottom: 1px solid #e5e7eb;
            vertical-align: top;
        }
        .model-variables-table tr:hover td {
            background: #f0fdf4;
        }
        .model-var-name {
            font-weight: 600;
            color: #166534;
        }
        .model-var-desc {
            font-size: 0.8rem;
            color: var(--text-muted);
        }
        .model-var-id {
            font-family: 'Fira Code', 'Consolas', monospace;
            font-size: 0.8rem;
            background: #f1f5f9;
            padding: 2px 6px;
            border-radius: 4px;
        }

        /* Simulation-run results (derived, from exports/model_runs/) */
        .model-run-block {
            margin-top: 12px;
            border: 1px solid #86efac;
            border-radius: 6px;
            background: #f7fef9;
        }
        .model-run-summary {
            padding: 8px 12px;
            cursor: pointer;
            font-weight: 600;
            color: #166534;
            font-size: 0.9rem;
        }
        .model-run-summary:hover { background: #ecfdf5; }
        .model-run-note {
            display: block;
            font-weight: 400;
            font-size: 0.78rem;
            color: var(--text-muted);
            margin-top: 2px;
        }
        .model-run-scroll { overflow-x: auto; }
        .model-run-table { margin-top: 0; }
        .model-run-table td { white-space: nowrap; }
        .model-run-baseline td {
            background: #ecfdf5;
            font-weight: 500;
        }
        .model-run-caveat {
            margin: 10px 12px;
            padding: 10px 12px;
            background: #fffbeb;
            border-left: 4px solid #f59e0b;
            border-radius: 4px;
            font-size: 0.82rem;
            color: #78350f;
            line-height: 1.5;
        }
        .model-run-provenance {
            padding: 8px 12px 10px;
            font-size: 0.75rem;
            color: var(--text-muted);
            border-top: 1px solid #d1fae5;
        }
        .severity-pill a { color: inherit; text-decoration: none; }
        .severity-pill a:hover { text-decoration: underline; }

        .severity-pill {
            display: inline-block;
            padding: 2px 8px;
            border-radius: 10px;
            font-size: 0.75rem;
            font-weight: 500;
            margin: 2px;
        }
        .severity-mild { background: #fef9c3; color: #854d0e; }
        .severity-moderate { background: #fed7aa; color: #9a3412; }
        .severity-severe { background: #fecaca; color: #991b1b; }
        .severity-other { background: #f3f4f6; color: #374151; }

        .ontology-mapping-tag {
            display: inline-block;
            padding: 2px 8px;
            border-radius: 10px;
            font-size: 0.75rem;
            background: #e0f2fe;
            color: #0369a1;
            margin: 2px;
        }
        .ontology-mapping-tag a {
            color: inherit;
            text-decoration: none;
        }
        .ontology-mapping-tag a:hover {
            text-decoration: underline;
        }

        /* Per-link scale and typed divergences (ModelMechanismLink). */
        .model-link-scale {
            display: inline-block;
            font-size: 0.72rem;
            padding: 1px 6px;
            border-radius: 4px;
            background: #eef2ff;
            color: #3730a3;
            margin-left: 4px;
        }
        .model-divergence {
            margin-top: 6px;
            font-size: 0.85rem;
            line-height: 1.5;
        }
        .model-divergence-type {
            font-family: 'Fira Code', 'Consolas', monospace;
            font-size: 0.72rem;
            padding: 1px 6px;
            border-radius: 4px;
            background: #f1f5f9;
            color: #334155;
        }
        .model-materiality {
            font-size: 0.72rem;
            padding: 1px 6px;
            border-radius: 4px;
            margin-left: 4px;
        }
        .model-materiality-INVALIDATING { background: #fecaca; color: #991b1b; }
        .model-materiality-QUALIFYING { background: #fef3c7; color: #92400e; }
        .model-materiality-IMMATERIAL { background: #f3f4f6; color: #374151; }
        .model-notes-details summary {
            cursor: pointer;
            font-size: 0.85rem;
            color: var(--text-muted);
            margin-top: 8px;
        }
        .model-page-link {
            display: inline-block;
            margin-left: 16px;
            font-size: 0.85rem;
            font-weight: 600;
            color: var(--secondary);
        }
