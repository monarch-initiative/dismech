{# Shared by disorder cards and mechanism-module cards. Region landmarks are
   sequence locations, separate from affected genes and regulatory targets. #}
{% macro render_region_gene(gene) -%}
{% if gene %}
{% set term = gene.term or {} %}
<span class="tag tag-gene">{{ gene.preferred_term or term.label or term.id }}{% if term.id %} <a href="{{ term.id | curie_to_url }}" target="_blank" class="curie-chip" title="Open {{ term.id }}">{{ term.id }}</a>{% endif %}</span>
{% endif %}
{%- endmacro %}

{% macro render_affected_regions(regions) %}
{% if regions %}
<div class="affected-regions">
    <div class="item-meta"><strong>Affected regions (reference genome)</strong></div>
    {% for region in regions %}
    <div class="affected-region">
        <div class="item-meta">
            <strong>{{ region.name }}</strong>
            {% if region.chromosomal_region %}<span class="tag tag-classification">{{ region.chromosomal_region }}</span>{% endif %}
            {% if region.regulatory_element_type %}<span class="tag tag-classification">{{ region.regulatory_element_type | replace('_', ' ') | lower }}</span>{% endif %}
        </div>
        {% if region.between_genes %}
        <div class="item-meta" title="Unordered landmarks on opposite sides; these need not be the nearest genes or the region endpoints.">
            <span>Between genes:</span>
            {% for gene in region.between_genes %}{{ render_region_gene(gene) }}{% endfor %}
        </div>
        {% endif %}
        {% if region.within_gene %}
        <div class="item-meta"><span>Within gene:</span> {{ render_region_gene(region.within_gene) }}</div>
        {% endif %}
        {% if region.overlaps_genes %}
        <div class="item-meta"><span>Overlaps genes:</span>
            {% for gene in region.overlaps_genes %}{{ render_region_gene(gene) }}{% endfor %}
        </div>
        {% endif %}
        {% if region.adjacent_to_genes %}
        <div class="item-meta" title="The region and gene share a sequence boundary without overlapping."><span>Abuts genes (shared boundary):</span>
            {% for gene in region.adjacent_to_genes %}{{ render_region_gene(gene) }}{% endfor %}
        </div>
        {% endif %}
        {% if region.description %}<div class="item-desc">{{ region.description }}</div>{% endif %}
    </div>
    {% endfor %}
</div>
{% endif %}
{% endmacro %}
