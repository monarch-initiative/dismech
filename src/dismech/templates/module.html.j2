    <div class="container">
        <div class="breadcrumb">
            <a href="../../app/index.html">Browse All</a>
            <span> / </span>
            <a href="index.html">Modules</a>
            <span> / </span>
            <span>{{ module.name }}</span>
        </div>

        <header class="page-header">
            <h1>{{ module.name }}</h1>
            <div class="header-meta">
                <span class="badge badge-category">{{ module.category or 'Module' }}</span>
                <span class="badge badge-module">{{ module_id }}</span>
                <span class="badge badge-count">{{ disorder_usage | length }} disorder{{ '' if disorder_usage | length == 1 else 's' }}</span>
                {% if pathograph_node_count %}
                <a class="badge badge-pathograph" href="#pathograph">Pathograph {{ pathograph_node_count }}</a>
                {% endif %}
            </div>
            {% if module.description %}
            <div class="header-description">{{ module.description }}</div>
            {% endif %}
        </header>

        <div class="section-grid">
            <div class="card">
                <div class="card-header">
                    <div class="card-icon" style="background: #fef3c7; color: #d97706;">⚙</div>
                    <h2 class="card-title">Pathophysiology Nodes</h2>
                    <span class="card-count">{{ module._pathophysiology_count }}</span>
                </div>
                <div class="empty-state">
                    {{ module._pathophysiology_count }} shared node{{ '' if module._pathophysiology_count == 1 else 's' }} are defined in this module.
                </div>
            </div>

            <div class="card">
                <div class="card-header">
                    <div class="card-icon" style="background: #fce7f3; color: #be185d;">◉</div>
                    <h2 class="card-title">Cell Types</h2>
                    <span class="card-count">{{ module._cell_types | length }}</span>
                </div>
                {% if module._cell_types %}
                <div class="tag-list">
                    {% for cell in module._cell_types %}
                    {% set tooltip = term_tooltip(cell, "module.cell_types") %}
                    {% set pill_tips.n = pill_tips.n + 1 %}{% set tip_id = "pill-tip-" ~ pill_tips.n %}
                    <span class="tag tag-cell">
                        {{ cell.label }}
                        {% if cell.id %}
                        {{ render_curie_link(cell.id, describedby=tip_id) }}
                        {% endif %}
                        {% if tooltip %}<span class="pill-tip" role="tooltip" id="{{ tip_id }}">{{ tooltip }}</span>{% endif %}
                    </span>
                    {{ render_descriptor_qualifiers(cell) }}
                    {% endfor %}
                </div>
                {% else %}
                <div class="empty-state">No cell types are annotated for this module.</div>
                {% endif %}
            </div>

            <div class="card">
                <div class="card-header">
                    <div class="card-icon" style="background: #fef3c7; color: #d97706;">⇄</div>
                    <h2 class="card-title">Biological Processes</h2>
                    <span class="card-count">{{ module._biological_processes | length }}</span>
                </div>
                {% if module._biological_processes %}
                <div class="tag-list">
                    {% for process in module._biological_processes %}
                    {% set tooltip = term_tooltip(process, "module.biological_processes") %}
                    {% set pill_tips.n = pill_tips.n + 1 %}{% set tip_id = "pill-tip-" ~ pill_tips.n %}
                    <span class="tag tag-bio">
                        {{ process.label }}
                        {% if process.id %}
                        {{ render_curie_link(process.id, describedby=tip_id) }}
                        {% endif %}
                        {% if tooltip %}<span class="pill-tip" role="tooltip" id="{{ tip_id }}">{{ tooltip }}</span>{% endif %}
                    </span>
                    {{ render_descriptor_qualifiers(process) }}
                    {% endfor %}
                </div>
                {% else %}
                <div class="empty-state">No biological processes are annotated for this module.</div>
                {% endif %}
            </div>
        </div>

        {% if module.notes %}
        <div class="card">
            <div class="card-header">
                <div class="card-icon" style="background: #e0f2fe; color: #0369a1;">i</div>
                <h2 class="card-title">Notes</h2>
            </div>
            <div class="item-desc">{{ module.notes }}</div>
        </div>
        {% endif %}

        {% if module.mechanistic_hypotheses %}
        <div class="card" id="mechanistic-hypotheses">
            <div class="card-header">
                <div class="card-icon" style="background: #d1fae5; color: #059669;">H</div>
                <h2 class="card-title">Mechanistic Hypotheses</h2>
                <span class="card-count">{{ module.mechanistic_hypotheses | length }}</span>
            </div>
            {% for hypothesis in module.mechanistic_hypotheses %}
            <div class="item-box hypothesis-box anchor-target{% if hypothesis.status == 'DEPRECATED' %} hypothesis-deprecated{% endif %}"{% if hypothesis.hypothesis_group_id %} id="hypothesis-{{ hypothesis.hypothesis_group_id }}"{% endif %}>
                <div class="item-name">{{ hypothesis.hypothesis_label or hypothesis.hypothesis_group_id }}</div>
                <div class="item-meta">
                    {% if hypothesis.hypothesis_group_id %}
                    <span class="tag" style="background:#f3f4f6;color:#374151;">{{ hypothesis.hypothesis_group_id }}</span>
                    {% endif %}
                    {% if hypothesis.status %}
                    <span class="tag tag-hypothesis-{{ hypothesis.status }}">{% if hypothesis.status == 'DEPRECATED' %}⚠ {% endif %}{{ hypothesis.status }}</span>
                    {% endif %}
                    {% for subtype in hypothesis.applies_to_subtypes or [] %}
                    <span class="tag" style="background:#fef3c7;color:#b45309;">{{ subtype }}</span>
                    {% endfor %}
                    {% if hypothesis.evidence %}
                    <span class="tag" style="background:#ecfeff;color:#155e75;">Evidence: {{ hypothesis.evidence | length }}</span>
                    {% endif %}
                </div>
                {% if hypothesis.status == 'DEPRECATED' %}
                <div class="hypothesis-overturned">
                    <div class="hypothesis-overturned-title">⚠ Overturned model &mdash; shown for reference, not as current mechanism</div>
                    <p>
                        DisMech records superseded hypotheses explicitly rather than deleting
                        them, so that claims still circulating in the literature can be checked
                        against an assessment. This model is <strong>not</strong> part of the
                        mechanism DisMech asserts.
                    </p>
                    <p>
                        Citation volume does not decide standing here. A hypothesis may retain
                        more supporting than refuting citations simply because the supporting
                        literature accumulated for decades before the refutation landed; where
                        the two conflict, DisMech follows the more recent and more direct
                        evidence.
                    </p>
                </div>
                {% endif %}
                {% if hypothesis._evidence_tally %}
                <div class="hypothesis-evidence-balance">
                    <span class="hypothesis-evidence-balance-label">Evidence balance</span>
                    {% for bucket in hypothesis._evidence_tally %}
                    <span class="evidence-support support-{{ bucket.supports }}">{{ bucket.count }} {{ bucket.supports | replace('_', ' ') | lower }}</span>
                    {% endfor %}
                </div>
                {% endif %}
                {% if hypothesis.description %}
                <div class="item-desc" style="margin-top: 8px;">{{ hypothesis.description }}</div>
                {% endif %}
                {% if hypothesis.notes %}
                <div class="hypothesis-notes">{{ hypothesis.notes }}</div>
                {% endif %}
            </div>
            {% endfor %}
        </div>
        {% endif %}

        {% if module.discussions %}
        <div class="card" id="discussions">
            <div class="card-header">
                <div class="card-icon" style="background: #eef2ff; color: #4f46e5;">?</div>
                <h2 class="card-title">Discussions and Knowledge Gaps</h2>
                <span class="card-count">{{ module.discussions | length }}</span>
            </div>
            {% for discussion in module.discussions %}
            <div class="item-box anchor-target"{% if discussion.discussion_id %} id="{{ discussion.discussion_id }}"{% endif %}>
                <div class="item-name">{{ discussion.prompt }}</div>
                <div class="item-meta">
                    {% if discussion.kind %}
                    <span class="tag" style="background:#eef2ff;color:#4338ca;">{{ discussion.kind | replace('_', ' ') }}</span>
                    {% endif %}
                    {% if discussion.status %}
                    <span class="tag" style="background:#ecfdf5;color:#047857;">{{ discussion.status | replace('_', ' ') }}</span>
                    {% endif %}
                    {% if discussion.discussion_id %}
                    <span class="tag" style="background:#f3f4f6;color:#374151;">{{ discussion.discussion_id }}</span>
                    {% endif %}
                </div>
                {% if discussion.attaches_to %}
                <div class="item-meta" style="margin-top: 8px;">
                    <strong style="font-size: 0.8rem; color: #6b7280;">Attached to:</strong>
                    {% for ref in discussion.attaches_to %}
                    <span class="tag" style="background:#fef3c7;color:#b45309;">{{ ref.split('#')[-1] }}</span>
                    {% endfor %}
                </div>
                {% endif %}
                {% if discussion.rationale %}
                <div class="item-desc" style="margin-top: 10px;">{{ discussion.rationale }}</div>
                {% endif %}
                {% if discussion.proposed_experiments %}
                <div class="item-meta" style="margin-top: 8px;">
                    <strong style="font-size: 0.8rem; color: #6b7280;">Proposed experiments:</strong>
                    {% for experiment in discussion.proposed_experiments %}
                    <span class="tag" style="background:#e0f2fe;color:#0369a1;">{{ experiment.name }}</span>
                    {% endfor %}
                </div>
                {% endif %}
            </div>
            {% endfor %}
        </div>
        {% endif %}

        {% if module.computational_models %}
        <div class="card" id="models">
            <div class="card-header">
                <div class="card-icon" style="background: #f0fdf4; color: #22c55e;">🧮</div>
                <h2 class="card-title">Computational Models</h2>
                <span class="card-count">{{ module.computational_models | length }}</span>
            </div>
            {% for model in module.computational_models %}
            <div class="item-box anchor-target"{% if model._anchor_id %} id="{{ model._anchor_id }}"{% endif %} data-dismech-node="{{ model.name | e }}" data-dismech-type="computational_model">
                <div class="item-name">
                    {{ model.name }}
                    <span class="tag-list" style="display: inline-flex; margin-left: 8px; vertical-align: middle;">
                        {% if model.model_type %}
                        <span class="tag tag-role">{{ model.model_type }}</span>
                        {% endif %}
                        {% if model.model_format %}
                        <span class="tag tag-component">{{ model.model_format }}</span>
                        {% endif %}
                        {% if model.model_software %}
                        <span class="tag tag-bio">{{ model.model_software }}</span>
                        {% endif %}
                    </span>
                </div>
                {% if model.description %}
                <div class="item-desc">{{ model.description }}</div>
                {% endif %}
                {% if model.modeled_mechanisms %}
                <div class="item-meta">
                    Models:
                    {% for link in model.modeled_mechanisms %}{% if loop.index > 1 %}, {% endif %}{{ link.target }}{% endfor %}
                </div>
                {% endif %}
                <div class="item-meta">
                    {% if model.repository_url %}
                    <a href="{{ model.repository_url }}" target="_blank" class="linkout">Repository ↗</a>
                    {% endif %}
                    {% if model.publication %}
                    {{ render_curie_link(model.publication) }}
                    {% endif %}
                    {% if model.base_model %}
                    <span>Base model: {{ model.base_model }}</span>
                    {% endif %}
                </div>
                {% if model.notes %}
                <div class="item-desc">{{ model.notes }}</div>
                {% endif %}
            </div>
            {% endfor %}
        </div>
        {% endif %}

        {% if module.experimental_models %}
        <div class="card" id="experimental-models">
            <div class="card-header">
                <div class="card-icon" style="background: #eef2ff; color: #4f46e5;">🧫</div>
                <h2 class="card-title">Experimental Models / Non-animal Systems</h2>
                <span class="card-count">{{ module.experimental_models | length }}</span>
            </div>
            {% for model in module.experimental_models %}
            <div class="item-box anchor-target"{% if model._anchor_id %} id="{{ model._anchor_id }}"{% endif %} data-dismech-node="{{ model.name | e }}" data-dismech-type="experimental_model">
                <div class="item-name">
                    {{ model.name }}
                    {% if model.experimental_model_type %}
                    <span class="tag tag-role" style="margin-left: 8px;">{{ model.experimental_model_type | replace('_', ' ') }}</span>
                    {% endif %}
                </div>
                {% if model.description %}
                <div class="item-desc">{{ model.description }}</div>
                {% endif %}
                {% if model.modeled_mechanisms %}
                <div class="item-meta">
                    Models:
                    {% for link in model.modeled_mechanisms %}{% if loop.index > 1 %}, {% endif %}{{ link.target }}{% if link.relationship %} ({{ link.relationship | replace('_', ' ') | lower }}){% endif %}{% endfor %}
                </div>
                {% endif %}
                <div class="item-meta">
                    {% if model.publication %}
                    {{ render_curie_link(model.publication) }}
                    {% endif %}
                    {% if is_preprint(model.publication) %}
                    <span class="badge-preprint" title="This publication is a preprint and has not been peer-reviewed.">Preprint · not peer-reviewed</span>
                    {% endif %}
                </div>
                {% if model.notes %}
                <div class="item-desc" style="color: #6b7280;">{{ model.notes }}</div>
                {% endif %}
            </div>
            {% endfor %}
        </div>
        {% endif %}

        <div class="card">
            <div class="card-header">
                <div class="card-icon" style="background: #e0f2fe; color: #0369a1;">↗</div>
                <h2 class="card-title">Used By Disorder Entries</h2>
                <span class="card-count">{{ disorder_usage | length }}</span>
            </div>
            {% if disorder_usage %}
            <div class="crosslink-list">
                {% for disorder in disorder_usage %}
                <div class="crosslink-item">
                    <a href="{{ disorder.href }}">{{ disorder.name }}</a>
                    {% if disorder.matches %}
                    <span class="crosslink-desc">
                        via
                        {% for match in disorder.matches %}
                        {% if loop.index > 1 %}, {% endif %}
                        {% if match.disorder_node_name and match.disorder_node_name != match.module_node_name %}
                        {{ match.disorder_node_name }} → {{ match.module_node_name }}
                        {% else %}
                        {{ match.module_node_name }}
                        {% endif %}
                        {% endfor %}
                    </span>
                    {% endif %}
                </div>
                {% endfor %}
            </div>
            {% else %}
            <div class="empty-state">No disorder entries currently reference this module via <code>conforms_to</code>.</div>
            {% endif %}
        </div>

        {% if pathograph_data %}
        <div class="card">
            <div class="card-header">
                <div class="card-icon" style="background: #e0e7ff; color: #4f46e5;">⬡</div>
                <h2 class="card-title">Pathograph</h2>
            </div>
            <div class="graph-note">Use the checkboxes to hide or show graph categories. Hover nodes for evidence-backed metadata.</div>
            {% if graph_issues %}
            <div class="graph-warning">
                <strong>Referential integrity issues ({{ graph_issues | length }}):</strong>
                <ul>
                    {% for issue in graph_issues[:5] %}
                    <li>{{ issue }}</li>
                    {% endfor %}
                    {% if graph_issues | length > 5 %}
                    <li><em>... and {{ graph_issues | length - 5 }} more</em></li>
                    {% endif %}
                </ul>
            </div>
            {% endif %}
            <div class="pathograph-container" id="pathograph">
                <div class="pathograph-legend" id="pathograph-legend"></div>
                <svg id="pathograph-svg" role="img">
                    <title>Pathograph: causal mechanism network for {{ module.name }}</title>
                    <desc>Interactive directed graph showing how this shared module's pathophysiology nodes connect.</desc>
                </svg>
                <div class="pathograph-tooltip" id="pathograph-tooltip"></div>
            </div>
            <script>
            (function() {
                var graphData = JSON.parse({{ pathograph_data | tojson }});
                renderPathograph("pathograph", graphData);
            })();
            </script>
        </div>
        {% endif %}

        {% if module.pathophysiology %}
        <div class="card" id="pathophysiology">
            <div class="card-header">
                <div class="card-icon" style="background: #fef3c7; color: #d97706;">⚙</div>
                <h2 class="card-title">Pathophysiology</h2>
                <span class="card-count">{{ module.pathophysiology | length }}</span>
            </div>
            {% for patho in module.pathophysiology %}
            <div class="item-box anchor-target" id="{{ patho._anchor_id }}" data-dismech-node="{{ patho.name | e }}" data-dismech-type="pathophysiology">
                <div class="item-name">{{ patho.name }}</div>
                <div class="item-meta">
                    {% if patho.role %}
                    <span class="tag tag-role">{{ patho.role | replace('_', ' ') }}</span>
                    {% endif %}
                </div>
                {% if patho.description %}
                <div class="item-desc">{{ patho.description }}</div>
                {% endif %}

                {% if patho.cell_types %}
                <div class="item-meta">
                    {% for ct in patho.cell_types %}
                    {% set tooltip = term_tooltip(ct, "pathophysiology.cell_types") %}
                    {% set pill_tips.n = pill_tips.n + 1 %}{% set tip_id = "pill-tip-" ~ pill_tips.n %} {% set has_chip = ct.term and ct.term.id %}
                    <span class="tag tag-cell"{% if tooltip and not has_chip %} tabindex="0" aria-describedby="{{ tip_id }}"{% endif %}>
                        {{ ct.preferred_term or ct.term.label }}
                        {% if has_chip %}
                        {{ render_curie_link(ct.term.id, describedby=tip_id) }}
                        {% endif %}
                        {% if tooltip %}<span class="pill-tip" role="tooltip" id="{{ tip_id }}">{{ tooltip }}</span>{% endif %}
                    </span>
                    {{ render_descriptor_qualifiers(ct) }}
                    {% endfor %}
                </div>
                {% endif %}

                {% if patho.biological_processes %}
                <div class="item-meta">
                    {% for bp in patho.biological_processes %}
                    {% set tooltip = term_tooltip(bp, "pathophysiology.biological_processes") %}
                    {% set pill_tips.n = pill_tips.n + 1 %}{% set tip_id = "pill-tip-" ~ pill_tips.n %} {% set has_chip = bp.term and bp.term.id %}
                    <span class="tag tag-bio"{% if tooltip and not has_chip %} tabindex="0" aria-describedby="{{ tip_id }}"{% endif %}>
                        {{ bp.preferred_term or bp.term.label }}
                        {% if has_chip %}
                        {{ render_curie_link(bp.term.id, describedby=tip_id) }}
                        {% endif %}
                        {% if tooltip %}<span class="pill-tip" role="tooltip" id="{{ tip_id }}">{{ tooltip }}</span>{% endif %}
                    </span>
                    {{ render_descriptor_qualifiers(bp) }}
                    {% endfor %}
                </div>
                {% endif %}

                {% if patho.cellular_components %}
                <div class="item-meta">
                    {% for cc in patho.cellular_components %}
                    {% set tooltip = term_tooltip(cc, "pathophysiology.cellular_components") %}
                    {% set pill_tips.n = pill_tips.n + 1 %}{% set tip_id = "pill-tip-" ~ pill_tips.n %} {% set has_chip = cc.term and cc.term.id %}
                    <span class="tag tag-component"{% if tooltip and not has_chip %} tabindex="0" aria-describedby="{{ tip_id }}"{% endif %}>
                        {{ cc.preferred_term or cc.term.label }}
                        {% if has_chip %}
                        {{ render_curie_link(cc.term.id, describedby=tip_id) }}
                        {% endif %}
                        {% if tooltip %}<span class="pill-tip" role="tooltip" id="{{ tip_id }}">{{ tooltip }}</span>{% endif %}
                    </span>
                    {% endfor %}
                </div>
                {% endif %}

                {% if patho._disorder_links %}
                <div class="crosslink-block">
                    <div class="crosslink-title">Used by disorders</div>
                    <div class="crosslink-list">
                        {% for link in patho._disorder_links %}
                        <div class="crosslink-item">
                            <a href="{{ link.href }}">{{ link.name }}</a>
                            {% if link.disorder_node_name and link.disorder_node_name != patho.name %}
                            <span class="crosslink-desc">as {{ link.disorder_node_name }}</span>
                            {% endif %}
                        </div>
                        {% endfor %}
                    </div>
                </div>
                {% endif %}

                {% if patho.downstream %}
                <div class="crosslink-block">
                    <div class="crosslink-title">Downstream</div>
                    <ul class="flow-list">
                        {% for edge in patho.downstream %}
                        <li class="crosslink-item">
                            <span class="flow-target">{{ edge.target }}</span>
                            {% if edge.description %}
                            <span class="crosslink-desc">{{ edge.description }}</span>
                            {% endif %}
                        </li>
                        {% endfor %}
                    </ul>
                </div>
                {% endif %}
            </div>
            {% endfor %}
        </div>
        {% endif %}

        <footer class="page-footer">
            <p>
                Generated from <a href="https://github.com/monarch-initiative/dismech" target="_blank">dismech</a>
                shared mechanism modules
