<script>
    /* Ontology pill tooltips (issue #8355). Showing and hiding is pure CSS
       (:hover / :focus-within); this only adds the dismissal WCAG 2.1 SC 1.4.13
       requires of hover-or-focus content -- Escape must hide it without moving
       the pointer or the focus. The tooltip returns the next time that pill is
       hovered or focused, so nothing is permanently lost. */
    (function () {
        var PILL = '.tag';

        document.addEventListener('keydown', function (event) {
            if (event.key !== 'Escape') { return; }
            var showing = document.querySelectorAll(
                '*:hover > .pill-tip:not([hidden]), *:focus-within > .pill-tip:not([hidden])'
            );
            if (!showing.length) { return; }
            Array.prototype.forEach.call(showing, function (tip) { tip.hidden = true; });
        });

        /* Keep the tooltip inside the viewport. A pill near either edge would
           otherwise push its tooltip off-screen, and CSS cannot measure. The
           element is measured while forced visible-but-transparent, so this does
           not depend on :hover having been applied before the event fires. */
        function place(pill) {
            var tip = pill.querySelector(':scope > .pill-tip');
            if (!tip) { return; }
            tip.style.transform = '';
            var wasHidden = getComputedStyle(tip).display === 'none';
            if (wasHidden) {
                tip.style.visibility = 'hidden';
                tip.style.display = 'block';
            }
            var box = tip.getBoundingClientRect();
            var width = document.documentElement.clientWidth;
            var shift = 0;
            if (box.right > width - 8) { shift = (width - 8) - box.right; }
            if (box.left + shift < 8) { shift = 8 - box.left; }
            if (wasHidden) {
                tip.style.display = '';
                tip.style.visibility = '';
            }
            if (shift) { tip.style.transform = 'translateX(' + Math.round(shift) + 'px)'; }
        }
        ['mouseover', 'focusin'].forEach(function (type) {
            document.addEventListener(type, function (event) {
                if (!event.target || !event.target.closest) { return; }
                var pill = event.target.closest(PILL);
                if (pill) { place(pill); }
            }, true);
        });

        /* Re-arm once the pointer or focus actually leaves the pill -- not on
           every move between its children, which would undo the dismissal while
           the user is still on it. */
        ['mouseout', 'focusout'].forEach(function (type) {
            document.addEventListener(type, function (event) {
                var target = event.target;
                if (!target || !target.closest) { return; }
                var pill = target.closest(PILL);
                if (!pill) { return; }
                if (event.relatedTarget && pill.contains(event.relatedTarget)) { return; }
                Array.prototype.forEach.call(
                    pill.querySelectorAll('.pill-tip[hidden]'),
                    function (tip) { tip.hidden = false; }
                );
            }, true);
        });
    })();
</script>
