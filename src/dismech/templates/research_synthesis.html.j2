<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Cross-provider synthesis: {{ synthesis.display_name }}</title>
    <style>
        :root {
            --gray-100: #f5f6f8;
            --gray-200: #e7e9ee;
            --gray-300: #d5d8e0;
            --gray-600: #5b6270;
            --gray-800: #23262e;
            --ink: #1a1c22;
            --concordant: #1f8a4c;
            --concordant-bg: #e6f5ec;
            --partial: #b8860b;
            --partial-bg: #fbf1d6;
            --contradictory: #c0392b;
            --contradictory-bg: #fbe5e2;
            --silent: #6b7280;
            --silent-bg: #eef0f3;
        }
        * { box-sizing: border-box; }
        body {
            margin: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            color: var(--ink);
            background: #fff;
            line-height: 1.5;
        }
        main { max-width: 1040px; margin: 0 auto; padding: 32px 20px 80px; }
        a { color: #1a5fb4; }
        .crumbs { font-size: 0.85rem; margin-bottom: 18px; color: var(--gray-600); }
        h1 { font-size: 1.7rem; margin: 0 0 6px; }
        .subtitle { color: var(--gray-600); margin: 0 0 18px; font-size: 0.95rem; }
        .meta { display: flex; flex-wrap: wrap; gap: 8px 18px; font-size: 0.85rem; color: var(--gray-600); margin-bottom: 24px; }
        .providers { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 28px; }
        .provider-chip {
            border: 1px solid var(--gray-300); border-radius: 999px;
            padding: 4px 12px; font-size: 0.82rem; background: var(--gray-100);
        }
        .provider-chip b { font-weight: 600; }
        h2 { font-size: 1.15rem; margin: 34px 0 12px; border-bottom: 1px solid var(--gray-200); padding-bottom: 6px; }
        .finding {
            border: 1px solid var(--gray-200); border-radius: 10px;
            padding: 16px 18px; margin-bottom: 16px; background: #fff;
        }
        .finding-head { display: flex; flex-wrap: wrap; gap: 8px; align-items: baseline; margin-bottom: 6px; }
        .finding-statement { font-weight: 600; font-size: 1.02rem; margin: 0; flex: 1 1 320px; }
        .pill { border-radius: 999px; padding: 2px 10px; font-size: 0.72rem; font-weight: 600; white-space: nowrap; }
        .section-tag {
            display: inline-block; background: var(--gray-100); border: 1px solid var(--gray-200);
            border-radius: 6px; padding: 1px 7px; font-size: 0.72rem; color: var(--gray-600); margin: 2px 4px 2px 0;
        }
        .tags { margin: 4px 0 12px; }
        .consensus-unanimous { background: var(--concordant-bg); color: var(--concordant); }
        .consensus-majority { background: var(--partial-bg); color: var(--partial); }
        .consensus-single { background: var(--silent-bg); color: var(--silent); }
        .consensus-conflict { background: var(--contradictory-bg); color: var(--contradictory); }
        .status { background: var(--gray-100); border: 1px solid var(--gray-200); color: var(--gray-600); }
        table.support { width: 100%; border-collapse: collapse; margin-top: 6px; }
        table.support th, table.support td {
            text-align: left; vertical-align: top; padding: 8px 10px; font-size: 0.86rem;
            border-top: 1px solid var(--gray-200);
        }
        table.support th { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.03em; color: var(--gray-600); }
        .stance { font-weight: 600; }
        .stance-concordant { color: var(--concordant); }
        .stance-partial { color: var(--partial); }
        .stance-contradictory { color: var(--contradictory); }
        .stance-silent { color: var(--silent); }
        tr.row-concordant td:first-child { border-left: 3px solid var(--concordant); }
        tr.row-partial td:first-child { border-left: 3px solid var(--partial); }
        tr.row-contradictory td:first-child { border-left: 3px solid var(--contradictory); }
        tr.row-silent td:first-child { border-left: 3px solid var(--silent); }
        .quote { color: var(--gray-800); font-style: italic; }
        .quote::before { content: "\201C"; }
        .quote::after { content: "\201D"; }
        .expl { color: var(--gray-600); margin-top: 4px; font-size: 0.82rem; }
        .cites { margin-top: 4px; font-size: 0.76rem; color: var(--gray-600); }
        .narrative p { margin: 0 0 10px; }
        .narrative h3 { font-size: 0.95rem; margin: 16px 0 4px; }
        .legend { display: flex; flex-wrap: wrap; gap: 6px 14px; font-size: 0.78rem; color: var(--gray-600); margin-bottom: 20px; }
        .legend .stance { margin-right: 4px; }
        .notes { font-size: 0.85rem; color: var(--gray-600); border-top: 1px solid var(--gray-200); margin-top: 28px; padding-top: 14px; }
    </style>
</head>
<body>
<main>
    <div class="crumbs">
        <a href="index.html">← Research index</a>
        &nbsp;·&nbsp; <a href="{{ disorder_page_href }}">Disorder page</a>
        {% if synthesis.source_url %}&nbsp;·&nbsp; <a href="{{ synthesis.source_url }}">Source YAML</a>{% endif %}
    </div>

    <h1>Cross-provider research synthesis</h1>
    <p class="subtitle">{{ synthesis.display_name }}</p>

    <div class="meta">
        {% if synthesis.mondo_id %}<span>{% if synthesis.mondo_url %}<a href="{{ synthesis.mondo_url }}">{{ synthesis.mondo_id }}</a>{% else %}{{ synthesis.mondo_id }}{% endif %}</span>{% endif %}
        {% if synthesis.generated %}<span>Curated {{ synthesis.generated }}</span>{% endif %}
        <span>{{ synthesis.findings | length }} harmonized findings</span>
    </div>

    <div class="providers">
        {% for provider in synthesis.providers %}
        <span class="provider-chip"><b>{{ provider.name }}</b>{% if provider.citation_count is not none %} · {{ provider.citation_count }} citations{% endif %}</span>
        {% endfor %}
    </div>

    <div class="legend">
        <span><span class="stance stance-concordant">Concordant</span> asserts the finding</span>
        <span><span class="stance stance-partial">Partial</span> supports a weaker/qualified form</span>
        <span><span class="stance stance-contradictory">Contradictory</span> conflicts with it</span>
        <span><span class="stance stance-silent">Silent</span> does not address it</span>
    </div>

    <h2>Harmonized findings</h2>
    {% for finding in synthesis.findings %}
    <article class="finding">
        <div class="finding-head">
            <p class="finding-statement">{{ finding.statement }}</p>
            <span class="pill consensus-{{ finding.consensus_key }}">{{ finding.consensus }}</span>
            {% if finding.curation_status %}<span class="pill status">{{ finding.curation_status }}</span>{% endif %}
        </div>
        <div class="tags">
            {% for section in finding.sections %}<span class="section-tag">{{ section }}</span>{% endfor %}
        </div>
        <table class="support">
            <thead>
                <tr><th>Provider</th><th>Stance</th><th>Score</th><th>Evidence</th></tr>
            </thead>
            <tbody>
                {% for support in finding.provider_support %}
                <tr class="row-{{ support.stance_key }}">
                    <td><b>{{ support.provider }}</b></td>
                    <td><span class="stance stance-{{ support.stance_key }}">{{ support.stance }}</span></td>
                    <td>{% if support.score_pct is not none %}{{ support.score_pct }}%{% else %}—{% endif %}</td>
                    <td>
                        {% if support.best_matching_text %}<span class="quote">{{ support.best_matching_text }}</span>{% endif %}
                        {% if support.explanation %}<div class="expl">{{ support.explanation }}</div>{% endif %}
                        {% if support.citations %}<div class="cites">{{ support.citations | join(", ") }}</div>{% endif %}
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
        {% if finding.notes %}<div class="expl">{{ finding.notes }}</div>{% endif %}
    </article>
    {% endfor %}

    {% if synthesis.narrative %}
    <h2>Narrative</h2>
    <div class="narrative">
        {% if synthesis.narrative.overview %}<h3>Overview</h3><p>{{ synthesis.narrative.overview }}</p>{% endif %}
        {% if synthesis.narrative.agreement %}<h3>Agreement</h3><p>{{ synthesis.narrative.agreement }}</p>{% endif %}
        {% if synthesis.narrative.divergence %}<h3>Divergence</h3><p>{{ synthesis.narrative.divergence }}</p>{% endif %}
        {% if synthesis.narrative.integration %}<h3>Integration</h3><p>{{ synthesis.narrative.integration }}</p>{% endif %}
        {% if synthesis.narrative.not_integrated %}<h3>Not integrated (leads)</h3><p>{{ synthesis.narrative.not_integrated }}</p>{% endif %}
    </div>
    {% endif %}

    {% if synthesis.notes %}
    <div class="notes">{{ synthesis.notes }}</div>
    {% endif %}
</main>
</body>
</html>
