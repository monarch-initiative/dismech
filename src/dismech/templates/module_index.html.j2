<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Modules - dismech</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin="anonymous">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous">
    <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        {% include '_palette.css.j2' %}
        {% include '_disclaimer.css.j2' %}
        body { font-family: var(--font); color: var(--gray-800); line-height: 1.6; background: linear-gradient(180deg, #fff 0%, var(--gray-50) 100%); }
        a { color: var(--teal); text-decoration: none; }
        a:hover { text-decoration: underline; }
        nav { position: sticky; top: 0; z-index: 100; padding: .75rem 1.5rem; background: rgba(255,255,255,.96); border-bottom: 1px solid var(--gray-200); backdrop-filter: blur(12px); }
        .nav-inner { max-width: 1120px; margin: auto; display: flex; justify-content: space-between; align-items: center; gap: 1rem; }
        .nav-logo { font-weight: 700; color: var(--teal); }
        .nav-links { display: flex; flex-wrap: wrap; gap: 1.1rem; font-size: .875rem; }
        .nav-links a { color: var(--gray-600); }
        .nav-links .active { color: var(--teal); font-weight: 700; }
        .hero-bg { background: var(--teal-50); border-bottom: 1px solid var(--gray-200); }
        .hero { max-width: 1120px; margin: auto; padding: 4.8rem 1.5rem 2.8rem; }
        .hero h1 { color: var(--teal); font-size: 2.35rem; line-height: 1.15; letter-spacing: -.02em; }
        .hero-tagline { margin-top: .55rem; color: var(--gray-700); font-size: 1.1rem; font-style: italic; }
        .hero-sub { max-width: 720px; margin-top: .65rem; color: var(--gray-600); }
        .hero-stats, .summary-row { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: 1rem; }
        .stat { display: inline-flex; padding: .28rem .7rem; border: 1px solid var(--teal-light); border-radius: 999px; background: #fff; color: var(--teal); font-size: .78rem; font-weight: 700; }
        main { max-width: 1120px; margin: auto; padding: 2rem 1.5rem 4rem; }
        .breadcrumb { margin-bottom: 1.4rem; color: var(--gray-500); font-size: .88rem; }
        .panel { margin-bottom: 2rem; padding: 1.35rem; border: 1px solid var(--gray-200); border-radius: 12px; background: #fff; box-shadow: 0 1px 3px rgba(0,0,0,.04); }
        .section-heading { font-size: 1.25rem; margin-bottom: .3rem; }
        .section-intro { color: var(--gray-600); font-size: .92rem; }
        .collection-tree, .collection-children { list-style: none; }
        .collection-tree { display: grid; gap: .7rem; margin-top: 1rem; }
        .collection-node { position: relative; }
        .collection-row { display: flex; flex-wrap: wrap; align-items: center; gap: .55rem; min-height: 42px; padding: .6rem .8rem; border: 1px solid var(--gray-200); border-radius: 8px; background: var(--gray-50); }
        .collection-row a { color: var(--gray-800); font-weight: 700; }
        .collection-type { padding: .15rem .5rem; border-radius: 999px; background: #eef2ff; color: #4338ca; font-size: .68rem; font-weight: 700; text-transform: lowercase; }
        .collection-meta { color: var(--gray-500); font-size: .78rem; }
        .collection-children { display: grid; gap: .55rem; margin: .55rem 0 0 1.5rem; padding-left: 1rem; border-left: 2px solid var(--gray-200); }
        .controls { display: grid; grid-template-columns: minmax(220px, 1fr) minmax(210px, 280px); gap: .8rem; margin: 1rem 0; }
        .control { width: 100%; min-height: 42px; padding: .6rem .75rem; border: 1px solid var(--gray-300); border-radius: 8px; background: #fff; color: var(--gray-800); font: inherit; font-size: .9rem; }
        .control:focus { outline: 2px solid var(--teal-light); border-color: var(--teal); }
        .module-list { overflow: hidden; border: 1px solid var(--gray-200); border-radius: 10px; background: #fff; }
        .module-row { display: grid; grid-template-columns: minmax(220px, 1.1fr) minmax(260px, 1.9fr) minmax(150px, .8fr); gap: 1rem; align-items: start; padding: 1rem; border-bottom: 1px solid var(--gray-200); }
        .module-row:last-child { border-bottom: 0; }
        .module-row:hover { background: var(--gray-50); }
        .module-name { color: var(--gray-900); font-weight: 700; }
        .module-id { display: block; margin-top: .18rem; color: var(--gray-500); font-family: var(--mono); font-size: .72rem; overflow-wrap: anywhere; }
        .module-desc { color: var(--gray-600); font-size: .88rem; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 3; overflow: hidden; }
        .module-meta { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: .35rem; }
        .pill { display: inline-flex; padding: .18rem .5rem; border-radius: 999px; background: var(--teal-50); color: var(--teal); font-size: .7rem; font-weight: 700; }
        .collection-pill { background: #eef2ff; color: #4338ca; }
        .category-pills { display: flex; flex-wrap: wrap; gap: .35rem; margin-top: .45rem; }
        .category-pill { display: inline-flex; padding: .16rem .5rem; border: 1px solid; border-radius: 999px; font-size: .68rem; font-weight: 700; cursor: help; }
        .category-legend { margin-bottom: 1.5rem; padding: 1rem 1.2rem; border: 1px solid var(--gray-200); border-radius: 10px; background: #fff; }
        .category-legend summary { color: var(--gray-700); font-size: .9rem; font-weight: 700; cursor: pointer; }
        .category-legend dl { display: grid; gap: .7rem; margin-top: .8rem; }
        .category-legend dt { margin-bottom: .2rem; }
        .category-legend dd { color: var(--gray-600); font-size: .86rem; }
        .empty { display: none; padding: 2rem; color: var(--gray-500); text-align: center; }
        [hidden] { display: none !important; }
        @media (max-width: 760px) {
            nav { padding: .7rem 1rem; }
            .hero { padding: 4rem 1rem 2.2rem; }
            .hero h1 { font-size: 1.8rem; }
            main { padding: 1.3rem 1rem 3rem; }
            .controls { grid-template-columns: 1fr; }
            .module-row { grid-template-columns: 1fr; gap: .55rem; }
            .module-meta { justify-content: flex-start; }
        }
    </style>
</head>
<body>
    {% include '_disclaimer.html.j2' %}
    <nav>
        <div class="nav-inner">
            <a href="../../" class="nav-logo">dismech</a>
            <div class="nav-links">
                <a href="../../app/index.html">Browse</a>
                <a href="index.html" class="active">Modules</a>
                <a href="../module-collections/">Collections</a>
                <a href="../groupings/">Disease groupings</a>
                <a href="../../details/">Docs</a>
                <a href="https://github.com/monarch-initiative/dismech">GitHub</a>
            </div>
        </div>
    </nav>

    <div class="hero-bg">
        <section class="hero">
            <h1>Shared Pathophysiology Modules</h1>
            <p class="hero-tagline">Conserved mechanism patterns, organized for exploration</p>
            <p class="hero-sub">Browse curated module collections and search the complete module registry. Collections provide many-to-many navigation without turning a scientific framework into a mechanism or a disease grouping.</p>
            <div class="hero-stats">
                <span class="stat">{{ modules | length }} modules</span>
                <span class="stat">{{ collections | length }} collection{{ '' if collections | length == 1 else 's' }}</span>
                <span class="stat">{{ collected_module_count }} in collections</span>
            </div>
        </section>
    </div>

    <main>
        <div class="breadcrumb"><a href="../../">Home</a> / Modules</div>

        {% if category_legend %}
        <details class="category-legend">
            <summary>What do the category labels mean?</summary>
            <dl>
                {% for category in category_legend %}
                <div>
                    <dt><span class="category-pill" style="background: {{ category.background }}; border-color: {{ category.border }}; color: {{ category.text }};">{{ category.label }}</span></dt>
                    <dd>{{ category.description }}</dd>
                </div>
                {% endfor %}
            </dl>
        </details>
        {% endif %}

        {% if collection_tree.roots %}
        <section class="panel" aria-labelledby="collections-heading">
            <h2 class="section-heading" id="collections-heading">Module collections</h2>
            <p class="section-intro">Curated frameworks and navigational families. A module may appear in more than one collection.</p>
            <div class="summary-row">
                <span class="stat">{{ collection_tree.root_count }} root{{ '' if collection_tree.root_count == 1 else 's' }}</span>
                <span class="stat">{{ collection_tree.edge_count }} nested relation{{ '' if collection_tree.edge_count == 1 else 's' }}</span>
            </div>
            <ol class="collection-tree">
                {% for node in collection_tree.roots recursive %}
                <li class="collection-node">
                    <div class="collection-row">
                        <a href="{{ node.href }}">{{ node.display_name or node.name }}</a>
                        <span class="collection-type">{{ node.collection_type | replace('_', ' ') }}</span>
                        <span class="collection-meta">{{ node.module_count }} module{{ '' if node.module_count == 1 else 's' }}</span>
                        {% if node.is_shared %}<span class="collection-meta">multiple parents</span>{% endif %}
                    </div>
                    {% if node.children %}<ol class="collection-children">{{ loop(node.children) }}</ol>{% endif %}
                </li>
                {% endfor %}
            </ol>
        </section>
        {% endif %}

        <section aria-labelledby="all-modules-heading">
            <h2 class="section-heading" id="all-modules-heading">All modules</h2>
            <p class="section-intro">Search names and descriptions, or narrow the registry to a curated collection.</p>
            <div class="controls">
                <input class="control" id="module-search" type="search" placeholder="Search modules…" aria-label="Search modules">
                <select class="control" id="collection-filter" aria-label="Filter by module collection">
                    <option value="">All collections</option>
                    {% for collection in collections %}<option value="{{ collection.name }}">{{ collection.display_name or collection.name }}</option>{% endfor %}
                    <option value="__unclassified__">Not yet in a collection</option>
                </select>
            </div>
            <p class="section-intro" id="result-count" aria-live="polite">{{ modules | length }} modules</p>
            <div class="module-list" id="module-list">
                {% for module in modules %}
                <article class="module-row" data-module-row data-search="{{ module.name }} {{ module.id }} {{ module.description or '' }}{% for collection in module.collections %} {{ collection.name }}{% endfor %}" data-collections="{% for collection in module.collections %}{% if not loop.first %}|||{% endif %}{{ collection.name }}{% endfor %}">
                    <div>
                        <a class="module-name" href="{{ module.href }}">{{ module.name }}</a>
                        <span class="module-id">{{ module.id }}</span>
                        {% if module.categories %}
                        <div class="category-pills">
                            {% for category in module.categories %}
                            <span class="category-pill" title="{{ category.description }}" style="background: {{ category.background }}; border-color: {{ category.border }}; color: {{ category.text }};">{{ category.label }}</span>
                            {% endfor %}
                        </div>
                        {% endif %}
                    </div>
                    <div>
                        {% if module.description %}<p class="module-desc">{{ module.description }}</p>{% endif %}
                        {% if module.collections %}<div class="summary-row">{% for collection in module.collections %}<a class="pill collection-pill" href="{{ collection.href }}">{{ collection.display_name or collection.name }}</a>{% endfor %}</div>{% endif %}
                    </div>
                    <div class="module-meta">
                        <span class="pill">{{ module.pathophysiology_count }} nodes</span>
                        <span class="pill">{{ module.disorder_count }} disorders</span>
                    </div>
                </article>
                {% endfor %}
                <div class="empty" id="empty-state">No modules match these filters.</div>
            </div>
        </section>
    </main>

    <script>
        (() => {
            const search = document.getElementById('module-search');
            const filter = document.getElementById('collection-filter');
            const rows = [...document.querySelectorAll('[data-module-row]')];
            const count = document.getElementById('result-count');
            const empty = document.getElementById('empty-state');
            const update = () => {
                const query = search.value.trim().toLocaleLowerCase();
                const selected = filter.value;
                let visible = 0;
                rows.forEach((row) => {
                    const collections = row.dataset.collections ? row.dataset.collections.split('|||') : [];
                    const collectionMatch = !selected || (selected === '__unclassified__' ? collections.length === 0 : collections.includes(selected));
                    const searchMatch = !query || row.dataset.search.toLocaleLowerCase().includes(query);
                    row.hidden = !(collectionMatch && searchMatch);
                    if (!row.hidden) visible += 1;
                });
                count.textContent = `${visible} module${visible === 1 ? '' : 's'}`;
                empty.style.display = visible ? 'none' : 'block';
            };
            search.addEventListener('input', update);
            filter.addEventListener('change', update);
        })();
    </script>
</body>
</html>
