{% for mapping in omimps_mappings %}
<div class="mapping-item">
    <div class="mapping-title">
        <a href="{{ mapping.term.id | curie_to_url }}">{{ mapping.term.id }} &middot; {{ mapping.term.label }}</a>
        <span class="predicate">{{ mapping.mapping_predicate }}</span>
    </div>
    {% if mapping.mapping_source %}<p>Source: {{ mapping.mapping_source }}</p>{% endif %}
    <p class="mapping-notes">{{ mapping.mapping_justification }}</p>
</div>
{% endfor %}
