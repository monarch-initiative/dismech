        /* Reader-facing AI-curation / not-medical-advice disclaimer.
           Styles the bar emitted by _disclaimer.html.j2. Deliberately neutral
           (grey, not amber) so it reads as distinct from the dismissible
           pre-alpha ".notice-banner" it may sit alongside. Palette variables
           carry literal fallbacks so this partial also renders correctly in
           templates that do not include _palette.css.j2. */
        .dismech-disclaimer {
            display: block;
            width: 100%;
            box-sizing: border-box;
            margin: 0;
            padding: 10px 16px;
            background: var(--gray-100, #f3f4f6);
            color: var(--gray-700, #374151);
            border-bottom: 1px solid var(--gray-300, #d1d5db);
            font-family: inherit;
            font-size: 0.85rem;
            line-height: 1.5;
            text-align: center;
        }

        .dismech-disclaimer p {
            max-width: var(--max-width, 960px);
            margin: 0 auto;
        }

        .dismech-disclaimer strong {
            color: var(--gray-900, #111827);
        }

        .dismech-disclaimer a {
            color: var(--primary, #00838f);
            text-decoration: underline;
        }
