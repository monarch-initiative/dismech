        /* Reader-facing AI-curation / not-medical-advice disclaimer.
           Styles the bar emitted by _disclaimer.html.j2. Deliberately neutral
           (grey, not amber) so it reads as distinct from the pre-alpha
           ".notice-banner" it may sit alongside. Palette variables carry literal
           fallbacks so this partial also renders correctly in templates that do
           not include _palette.css.j2. */
        .dismech-disclaimer {
            /* Flex rather than an absolutely positioned button: the dismiss
               control stays in flow, so it can never overlap the text however
               the bar wraps on a narrow screen. */
            display: flex;
            align-items: center;
            gap: 8px;
            width: 100%;
            box-sizing: border-box;
            margin: 0;
            padding: 10px 16px;
            background: var(--gray-100, #f3f4f6);
            color: var(--gray-700, #374151);
            border-bottom: 1px solid var(--gray-300, #d1d5db);
            font-family: inherit;
            font-size: 0.85rem;
            line-height: 1.5;
            text-align: center;
        }

        /* `display: flex` above outranks the UA rule for the `hidden`
           attribute, so dismissal needs this to actually hide the bar. */
        .dismech-disclaimer[hidden] {
            display: none;
        }

        .dismech-disclaimer p {
            flex: 1 1 auto;
            min-width: 0;
            max-width: var(--max-width, 960px);
            margin: 0 auto;
        }

        .dismech-disclaimer strong {
            color: var(--gray-900, #111827);
        }

        .dismech-disclaimer a {
            color: var(--primary, #00838f);
            text-decoration: underline;
        }

        /* Hidden until the script confirms it can act on a click, so a reader
           without JavaScript is never shown a dead control. */
        .dismech-disclaimer-dismiss {
            display: none;
        }

        .dismech-disclaimer.is-dismissible .dismech-disclaimer-dismiss {
            display: flex;
            flex: 0 0 auto;
            /* Clears the Hypothes.is sidebar, which mounts a toolbar over the
               rightmost ~33px of every page that embeds the annotation client
               (disorder.html.j2, module.html.j2) and swallows clicks there. The
               offset is applied on every surface for consistency; it is only
               whitespace on the pages without the client. Measured in headless
               Chromium at 1280w: toolbar x 1247-1280, button right edge 44px. */
            margin-right: 28px;
            align-items: center;
            justify-content: center;
            width: 28px;
            height: 28px;
            padding: 0;
            border: 0;
            border-radius: 4px;
            background: none;
            color: inherit;
            font: inherit;
            font-size: 1.15rem;
            line-height: 1;
            cursor: pointer;
        }

        .dismech-disclaimer-dismiss:hover {
            background: var(--gray-300, #d1d5db);
        }

        .dismech-disclaimer-dismiss:focus-visible {
            outline: 2px solid var(--primary, #00838f);
            outline-offset: 2px;
        }

        /* The button's footprint (28px wide + 28px clearance) sits only on the
           right, so the centred text lands about half that left of true centre.
           Mirroring the footprint fixes it, but costs the same width again — so
           it is only applied where there is room to spare. Below this, a small
           optical offset beats losing 56px of text width on a phone. */
        @media (min-width: 900px) {
            .dismech-disclaimer.is-dismissible::before {
                content: "";
                flex: 0 0 auto;
                width: 28px;
                margin-left: 28px;
            }
        }

        /* Non-dismissible footer line (_disclaimer_footer.html.j2). The bar can
           be dismissed for the session; this cannot, so the page never ends up
           carrying no disclaimer at all. */
        .dismech-disclaimer-footer {
            margin-top: 8px;
            font-size: 0.8rem;
            color: var(--gray-600, #4b5563);
        }

        /* `p.` is load-bearing. Both templates that use this partial also define
           `.page-footer a` (teal, no underline) — equal specificity, but declared
           thousands of lines later, so it would win. The extra type selector puts
           this rule ahead of it. */
        p.dismech-disclaimer-footer a {
            color: inherit;
            text-decoration: underline;
        }
