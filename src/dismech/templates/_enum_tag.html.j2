{# One enum value as a tag pill with the same hover tooltip descriptor pills use.
   Wrapped by render_enum_tag on the disorder and module pages; expects `value`,
   `enum_name`, `prefix`, `suffix`, `tag_class`, `tag_style`, plus pill_tips. #}
{% if value %}
{% set tooltip = enum_tooltip(value, enum_name) %}
{% set pill_tips.n = pill_tips.n + 1 %}{% set tip_id = "pill-tip-" ~ pill_tips.n %}
<span class="tag{% if tag_class %} {{ tag_class }}{% endif %}"{% if tag_style %} style="{{ tag_style }}"{% endif %}{% if tooltip %} tabindex="0" aria-describedby="{{ tip_id }}"{% endif %}>{{ prefix }}{{ value | enum_label(enum_name) }}{{ suffix }}{% if tooltip %}<span class="pill-tip" role="tooltip" id="{{ tip_id }}">{{ tooltip }}</span>{% endif %}</span>
{% endif %}
