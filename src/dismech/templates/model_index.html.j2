{# Index of the per-model pages (dismech.model_pages, issue #13123). #}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Models - dismech</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin="anonymous">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous">
    <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        {% include '_palette.css.j2' %}
        {% include '_disclaimer.css.j2' %}
        body { font-family: var(--font); color: var(--gray-800); line-height: 1.6; background: linear-gradient(180deg, #fff 0%, var(--gray-50) 100%); }
        a { color: var(--teal); text-decoration: none; }
        a:hover { text-decoration: underline; }
        nav { position: sticky; top: 0; z-index: 100; padding: .75rem 1.5rem; background: rgba(255,255,255,.96); border-bottom: 1px solid var(--gray-200); backdrop-filter: blur(12px); }
        .nav-inner { max-width: 1120px; margin: auto; display: flex; justify-content: space-between; align-items: center; gap: 1rem; }
        .nav-logo { font-weight: 700; color: var(--teal); }
        .nav-links { display: flex; flex-wrap: wrap; gap: 1.1rem; font-size: .875rem; }
        .nav-links a { color: var(--gray-600); }
        .nav-links .active { color: var(--teal); font-weight: 700; }
        .hero-bg { background: var(--teal-50); border-bottom: 1px solid var(--gray-200); }
        .hero { max-width: 1120px; margin: auto; padding: 3.2rem 1.5rem 2.2rem; }
        .hero h1 { color: var(--teal); font-size: 2.1rem; line-height: 1.15; }
        .hero-sub { max-width: 780px; margin-top: .65rem; color: var(--gray-600); }
        main { max-width: 1120px; margin: auto; padding: 2rem 1.5rem 4rem; }
        .breadcrumb { margin-bottom: 1.4rem; color: var(--gray-500); font-size: .88rem; }
        .model-list { overflow: hidden; border: 1px solid var(--gray-200); border-radius: 10px; background: #fff; }
        .model-row { display: grid; grid-template-columns: minmax(240px, 1.2fr) minmax(240px, 1.6fr) minmax(170px, .8fr); gap: 1rem; padding: 1rem; border-bottom: 1px solid var(--gray-200); }
        .model-row:last-child { border-bottom: 0; }
        .model-name { font-weight: 700; color: var(--gray-900); }
        .model-id { display: block; color: var(--gray-500); font-family: var(--mono); font-size: .72rem; }
        .model-used { color: var(--gray-600); font-size: .88rem; }
        .pills { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: .35rem; }
        .pill { display: inline-flex; padding: .18rem .5rem; border-radius: 999px; background: var(--teal-50); color: var(--teal); font-size: .7rem; font-weight: 700; }
        .pill-browser { background: #eef2ff; color: #4338ca; }
        @media (max-width: 760px) { .model-row { grid-template-columns: 1fr; } .pills { justify-content: flex-start; } }
    </style>
</head>
<body>
    {% include '_disclaimer.html.j2' %}
    <nav>
        <div class="nav-inner">
            <a href="../../" class="nav-logo">dismech</a>
            <div class="nav-links">
                <a href="../../app/index.html">Browse</a>
                <a href="../modules/index.html">Modules</a>
                <a href="index.html" class="active">Models</a>
                <a href="../../app/models/index.html">Models browser</a>
                <a href="../../details/">Docs</a>
                <a href="https://github.com/monarch-initiative/dismech">GitHub</a>
            </div>
        </div>
    </nav>
    <div class="hero-bg">
        <section class="hero">
            <h1>Models kept in this repository</h1>
            <p class="hero-sub">Each model whose files live under <code>models/</code>, with its rules, its committed runs and how to run it. The <a href="../../app/models/index.html">models browser</a> lists every computational model curated in the knowledge base, including the many that live elsewhere.</p>
        </section>
    </div>
    <main>
        <div class="breadcrumb"><a href="../../">Home</a> / Models</div>
        <div class="model-list">
            {% for m in models %}
            <div class="model-row">
                <div><a class="model-name" href="{{ m.model_id }}.html">{{ m.name }}</a><span class="model-id">{{ m.model_id }}</span></div>
                <div class="model-used">
                    {% if m.usage %}Curated on {% for u in m.usage %}<a href="{{ u.card_href }}">{{ u.entry_name }}</a>{% if not loop.last %}, {% endif %}{% endfor %}
                    {% elif m.source %}Curated on <a href="{{ m.source.page_href }}">{{ m.source.entry_name }}</a>
                    {% else %}Not yet curated on any entry{% endif %}
                </div>
                <div class="pills">
                    {% if m.kind == 'authored' %}<span class="pill">authored runner</span>{% elif m.kind == 'perturb' %}<span class="pill">dismech-perturb</span>{% endif %}
                    {% if m.column_viewer %}<span class="pill pill-browser">runs in browser</span>{% endif %}
                </div>
            </div>
            {% endfor %}
        </div>
        {% include "_disclaimer_footer.html.j2" %}
    </main>
</body>
</html>
