{#
  One page per model folder in models/<model_id>/ (issue #13123), rendered by
  dismech.model_pages. `m` is the context from model_pages.build_model_context.
#}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ m.name }} - dismech models</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin="anonymous">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous">
    <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        {% include '_palette.css.j2' %}
        {% include '_disclaimer.css.j2' %}
        {% include '_model_cards.css.j2' %}
        body { font-family: var(--font); color: var(--gray-800); line-height: 1.6; background: linear-gradient(180deg, #fff 0%, var(--gray-50) 100%); }
        a { color: var(--teal); text-decoration: none; }
        a:hover { text-decoration: underline; }
        code, .mono { font-family: var(--mono); font-size: .85em; }
        nav { position: sticky; top: 0; z-index: 100; padding: .75rem 1.5rem; background: rgba(255,255,255,.96); border-bottom: 1px solid var(--gray-200); backdrop-filter: blur(12px); }
        .nav-inner { max-width: 1120px; margin: auto; display: flex; justify-content: space-between; align-items: center; gap: 1rem; }
        .nav-logo { font-weight: 700; color: var(--teal); }
        .nav-links { display: flex; flex-wrap: wrap; gap: 1.1rem; font-size: .875rem; }
        .nav-links a { color: var(--gray-600); }
        .nav-links .active { color: var(--teal); font-weight: 700; }
        .hero-bg { background: var(--teal-50); border-bottom: 1px solid var(--gray-200); }
        .hero { max-width: 1120px; margin: auto; padding: 3.2rem 1.5rem 2.2rem; }
        .hero h1 { color: var(--teal); font-size: 2rem; line-height: 1.2; letter-spacing: -.02em; }
        .hero-id { margin-top: .3rem; color: var(--gray-500); font-family: var(--mono); font-size: .85rem; }
        .hero-sub { max-width: 820px; margin-top: .8rem; color: var(--gray-700); }
        .hero-stats { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: 1rem; }
        .stat { display: inline-flex; padding: .28rem .7rem; border: 1px solid var(--teal-light); border-radius: 999px; background: #fff; color: var(--teal); font-size: .78rem; font-weight: 700; }
        .stat-warn { border-color: #fcd34d; color: #92400e; }
        main { max-width: 1120px; margin: auto; padding: 2rem 1.5rem 4rem; }
        .breadcrumb { margin-bottom: 1.4rem; color: var(--gray-500); font-size: .88rem; }
        .panel { margin-bottom: 2rem; padding: 1.35rem; border: 1px solid var(--gray-200); border-radius: 12px; background: #fff; box-shadow: 0 1px 3px rgba(0,0,0,.04); }
        .panel h2 { font-size: 1.25rem; margin-bottom: .3rem; }
        .panel h3 { font-size: 1rem; margin: 1.2rem 0 .4rem; }
        .section-intro { color: var(--gray-600); font-size: .92rem; margin-bottom: .8rem; max-width: 860px; }
        .table-scroll { overflow-x: auto; }
        table.data { width: 100%; border-collapse: collapse; font-size: .85rem; }
        table.data th { text-align: left; padding: 7px 10px; border-bottom: 2px solid var(--gray-200); color: var(--gray-600); font-weight: 600; white-space: nowrap; }
        table.data td { padding: 7px 10px; border-bottom: 1px solid var(--gray-100); vertical-align: top; }
        table.data td.num { font-variant-numeric: tabular-nums; text-align: right; white-space: nowrap; }
        table.data th.num { text-align: right; }
        .muted { color: var(--gray-500); }
        .small { font-size: .8rem; }
        .pattern { display: inline-block; padding: 1px 8px; border-radius: 999px; font-size: .75rem; font-weight: 600; white-space: nowrap; }
        .pattern-normal { background: #dcfce7; color: #166534; }
        .pattern-delayed_lamination { background: #fef9c3; color: #854d0e; }
        .pattern-diffuse_ectopia { background: #fed7aa; color: #9a3412; }
        .pattern-band_heterotopia { background: #ede9fe; color: #5b21b6; }
        .pattern-migration_failure { background: #fecaca; color: #991b1b; }
        .hp-pill { display: inline-block; margin: 1px 2px; padding: 1px 7px; border-radius: 999px; background: #fef3c7; color: #92400e; font-size: .75rem; }
        .rule { padding: .8rem 1rem; margin-bottom: .6rem; border: 1px solid var(--gray-200); border-left: 4px solid var(--teal-light); border-radius: 8px; background: var(--gray-50); }
        .rule.assumption { border-left-color: #f59e0b; background: #fffbeb; }
        .rule-name { font-weight: 700; font-family: var(--mono); font-size: .88rem; }
        .rule-expr { margin: .3rem 0; font-family: var(--mono); font-size: .8rem; color: var(--gray-700); white-space: pre-wrap; }
        .rule-meta { font-size: .82rem; color: var(--gray-600); }
        .rule-meta ul { margin: .2rem 0 0 1.2rem; }
        .rule-decision { margin-top: .35rem; font-size: .82rem; color: var(--gray-700); }
        .badge-assumption { display: inline-block; margin-left: .4rem; padding: 0 6px; border-radius: 4px; background: #fde68a; color: #78350f; font-size: .7rem; font-weight: 700; font-family: var(--font); }
        .cmd { display: block; margin: .3rem 0; padding: .5rem .75rem; border-radius: 6px; background: #0f172a; color: #e2e8f0; font-family: var(--mono); font-size: .82rem; overflow-x: auto; white-space: pre; }
        .file-list { display: flex; flex-wrap: wrap; gap: .4rem; margin-top: .4rem; }
        .file-list a { padding: .15rem .55rem; border: 1px solid var(--gray-200); border-radius: 6px; font-family: var(--mono); font-size: .8rem; background: #fff; }
        .usage-list { list-style: none; display: grid; gap: .4rem; margin-top: .4rem; }
        .usage-kind { display: inline-block; min-width: 64px; color: var(--gray-500); font-size: .75rem; text-transform: uppercase; letter-spacing: .03em; }
        /* In-browser runner */
        .runner { display: grid; grid-template-columns: minmax(260px, 320px) 1fr; gap: 1.2rem; align-items: start; }
        .runner-controls label { display: block; margin-top: .7rem; font-size: .82rem; font-weight: 600; color: var(--gray-700); }
        .runner-controls .hint { font-weight: 400; color: var(--gray-500); font-size: .75rem; }
        .runner-controls select, .runner-controls input[type=range] { width: 100%; margin-top: .2rem; }
        .runner-controls select { padding: .35rem .5rem; border: 1px solid var(--gray-300); border-radius: 6px; font: inherit; font-size: .85rem; background: #fff; }
        .slider-row { display: flex; justify-content: space-between; align-items: baseline; }
        .slider-value { font-family: var(--mono); font-size: .8rem; color: var(--teal); }
        .runner-stage { min-width: 0; }
        .canvas-wrap { position: relative; border: 1px solid var(--gray-200); border-radius: 8px; background: #fff; }
        canvas#abm-canvas { display: block; width: 100%; height: 420px; }
        .playbar { display: flex; align-items: center; gap: .6rem; margin-top: .5rem; }
        .playbar button { padding: .3rem .8rem; border: 1px solid var(--teal); border-radius: 6px; background: var(--teal); color: #fff; font: inherit; font-size: .82rem; cursor: pointer; }
        .playbar button.secondary { background: #fff; color: var(--teal); }
        .playbar input[type=range] { flex: 1; }
        .playbar .t-label { font-family: var(--mono); font-size: .8rem; color: var(--gray-600); min-width: 92px; text-align: right; }
        .legend { display: flex; flex-wrap: wrap; gap: .8rem; margin-top: .5rem; font-size: .75rem; color: var(--gray-600); }
        .legend span { display: inline-flex; align-items: center; gap: .3rem; }
        .swatch { display: inline-block; width: 10px; height: 10px; border-radius: 50%; }
        .readout-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: .5rem; margin-top: .8rem; }
        .readout { padding: .45rem .6rem; border: 1px solid var(--gray-200); border-radius: 8px; background: var(--gray-50); }
        .readout .k { font-size: .7rem; color: var(--gray-500); text-transform: uppercase; letter-spacing: .03em; }
        .readout .v { font-family: var(--mono); font-size: .95rem; color: var(--gray-900); }
        .parity { margin-top: .6rem; font-size: .8rem; }
        .parity.ok { color: #166534; }
        .parity.custom { color: var(--gray-600); }
        .parity.bad { color: #991b1b; font-weight: 700; }
        [hidden] { display: none !important; }
        @media (max-width: 860px) {
            .runner { grid-template-columns: 1fr; }
            nav { padding: .7rem 1rem; }
            .hero { padding: 2.6rem 1rem 1.8rem; }
            main { padding: 1.3rem 1rem 3rem; }
        }
    </style>
</head>
<body>
    {% include '_disclaimer.html.j2' %}
    <nav>
        <div class="nav-inner">
            <a href="../../" class="nav-logo">dismech</a>
            <div class="nav-links">
                <a href="../../app/index.html">Browse</a>
                <a href="../modules/index.html">Modules</a>
                <a href="index.html" class="active">Models</a>
                <a href="../../app/models/index.html">Models browser</a>
                <a href="../../details/">Docs</a>
                <a href="https://github.com/monarch-initiative/dismech">GitHub</a>
            </div>
        </div>
    </nav>

    <div class="hero-bg">
        <section class="hero">
            <h1>{{ m.name }}</h1>
            <div class="hero-id">models/{{ m.model_id }}/</div>
            {% if m.description %}<p class="hero-sub">{{ m.description }}</p>{% endif %}
            <div class="hero-stats">
                {% if m.kind == 'authored' %}
                <span class="stat">Authored in this repository</span>
                {% elif m.kind == 'perturb' %}
                <span class="stat">Runs through dismech-perturb</span>
                {% endif %}
                {% if m.formalism %}<span class="stat">{{ m.formalism }}</span>{% elif m.model_type %}<span class="stat">{{ m.model_type | replace('_', ' ') | lower }}</span>{% endif %}
                {% if m.column_viewer %}<span class="stat">Runs in this page</span>{% endif %}
                {% if m.kind == 'authored' %}<span class="stat stat-warn">Not fitted to data</span>{% endif %}
            </div>
        </section>
    </div>

    <main>
        <div class="breadcrumb"><a href="../../">Home</a> / <a href="index.html">Models</a> / {{ m.model_id }}</div>

        <section class="panel">
            <h2>Where this model is curated</h2>
            <p class="section-intro">The entry card says what the model is for: which mechanism nodes it links to, how faithfully, and what it found. This page holds the model itself.</p>
            {% if m.usage %}
            <ul class="usage-list">
                {% for u in m.usage %}
                <li><span class="usage-kind">{{ u.kind }}</span> <a href="{{ u.card_href }}">{{ u.entry_name }}</a> <span class="muted small">{{ u.source_file }}</span></li>
                {% endfor %}
            </ul>
            {% elif m.source %}
            <ul class="usage-list"><li><span class="usage-kind">{{ m.source.kind }}</span> <a href="{{ m.source.page_href }}">{{ m.source.entry_name }}</a></li></ul>
            {% else %}
            <p class="muted">No KB entry names this model's <code>model_id</code> yet.</p>
            {% endif %}
        </section>

        {% if m.column_viewer %}
        {% include "_abm_column_runner.html.j2" %}
        {% endif %}

        {% if m.kind == 'authored' and m.results %}
        {% set results = m.results %}
        {% if results.sweeps %}
        {# --- Agent-based results: scenarios + sweeps --- #}
        <section class="panel" id="scenarios">
            <h2>Committed scenarios</h2>
            <p class="section-intro">From <code>{{ m.folder }}/results.json</code> (seed {{ results.seed }}). Readouts are scored when the developmental window closes. Every rate is a placeholder, so read these as orderings of regimes rather than quantities.</p>
            <div class="table-scroll">
            <table class="data">
                <thead><tr><th>Scenario</th><th class="num">Perturbation</th><th class="num">Affected</th><th class="num">Arrest rate</th><th class="num">Rescue</th><th class="num">Plate</th><th class="num">Arrested</th><th class="num">In transit</th><th class="num">Fidelity</th><th class="num">Delay</th><th class="num">Band</th><th>Outcome</th></tr></thead>
                <tbody>
                {% for name in m.spec.scenarios if name in results.scenarios %}
                {% set s = results.scenarios[name] %}
                {% set r = s.readouts %}
                <tr>
                    <td style="min-width:240px"><code>{{ name }}</code><div class="muted small">{{ s.description }}</div></td>
                    <td class="num">{{ s.params.perturbation }}</td>
                    <td class="num">{{ s.params.affected_fraction }}</td>
                    <td class="num">{{ s.params.arrest_rate }}</td>
                    <td class="num">{{ s.params.rescue }}</td>
                    <td class="num">{{ r.cortical_plate_fraction }}</td>
                    <td class="num">{{ r.arrested_fraction }}</td>
                    <td class="num">{{ r.in_transit_fraction }}</td>
                    <td class="num">{{ r.lamination_fidelity if r.lamination_fidelity is not none else '—' }}</td>
                    <td class="num">{{ r.mean_arrival_delay if r.mean_arrival_delay is not none else '—' }}</td>
                    <td class="num">{{ r.band_score if r.band_score is not none else '—' }}</td>
                    <td style="min-width:200px"><span class="pattern pattern-{{ r.pattern }}">{{ r.pattern | replace('_', ' ') }}</span>
                        <div>{% for p in s.activated_phenotypes %}<a class="hp-pill" href="{{ p.id | curie_to_url }}" target="_blank" rel="noopener">{{ p.label }}</a>{% else %}<span class="muted small">no phenotype activated</span>{% endfor %}</div></td>
                </tr>
                {% endfor %}
                </tbody>
            </table>
            </div>
            {% if results.pattern_thresholds %}
            <details style="margin-top:.8rem"><summary class="small">Pattern thresholds</summary>
                <table class="data" style="max-width:520px;margin-top:.4rem"><tbody>
                {% for k, v in results.pattern_thresholds.items() %}<tr><td><code>{{ k }}</code></td><td class="num">{{ v }}</td></tr>{% endfor %}
                </tbody></table>
            </details>
            {% endif %}
        </section>

        <section class="panel" id="sweeps">
            <h2>Parameter sweeps</h2>
            <p class="section-intro">One input varied at a time with the others held fixed.</p>
            {% for name in m.spec.sweeps if name in results.sweeps %}
            {% set sweep = results.sweeps[name] %}
            <h3><code>{{ name }}</code> <span class="muted small">vary {{ sweep.vary }}{% if sweep.fixed %}; fixed {% for k, v in sweep.fixed.items() %}{{ k }}={{ v }}{% if not loop.last %}, {% endif %}{% endfor %}{% endif %}</span></h3>
            <div class="table-scroll">
            <table class="data">
                <thead><tr><th class="num">{{ sweep.vary }}</th><th class="num">Plate</th><th class="num">Arrested</th><th class="num">In transit</th><th class="num">Fidelity</th><th class="num">Delay</th><th class="num">Band</th><th>Pattern</th><th>Phenotypes</th></tr></thead>
                <tbody>
                {% for row in sweep.rows %}
                <tr>
                    <td class="num">{{ row[sweep.vary] }}</td>
                    <td class="num">{{ row.cortical_plate_fraction }}</td>
                    <td class="num">{{ row.arrested_fraction }}</td>
                    <td class="num">{{ row.in_transit_fraction }}</td>
                    <td class="num">{{ row.lamination_fidelity if row.lamination_fidelity is not none else '—' }}</td>
                    <td class="num">{{ row.mean_arrival_delay if row.mean_arrival_delay is not none else '—' }}</td>
                    <td class="num">{{ row.band_score if row.band_score is not none else '—' }}</td>
                    <td><span class="pattern pattern-{{ row.pattern }}">{{ row.pattern | replace('_', ' ') }}</span></td>
                    <td class="small">{{ row.activated_phenotypes | join(', ') or '—' }}</td>
                </tr>
                {% endfor %}
                </tbody>
            </table>
            </div>
            {% endfor %}
        </section>
        {% elif results.intervention_scan %}
        {# --- Boolean-network results: attractors + intervention scan --- #}
        <section class="panel" id="scenarios">
            <h2>Committed scenarios</h2>
            <p class="section-intro">From <code>{{ m.folder }}/results.json</code>. Each scenario holds its listed inputs on and every other input off, then reports the attractor the network settles into.</p>
            <div class="table-scroll">
            <table class="data">
                <thead><tr><th>Scenario</th><th>Active inputs</th><th>Attractor</th><th>Active phenotypes</th></tr></thead>
                <tbody>
                {% for name in m.spec.scenarios if name in results.scenarios %}
                {% set s = results.scenarios[name] %}
                <tr>
                    <td><code>{{ name }}</code><div class="muted small">{{ s.label }}</div></td>
                    <td class="small">{{ s.active_inputs | join(', ') or '—' }}</td>
                    <td class="small">{{ (s.attractor_type or '') | replace('_', ' ') }}</td>
                    <td>{% for p in s.active_phenotypes %}<span class="hp-pill">{{ p | replace('_', ' ') }}</span>{% else %}<span class="muted">none</span>{% endfor %}</td>
                </tr>
                {% endfor %}
                </tbody>
            </table>
            </div>
        </section>
        {% set scan = results.intervention_scan %}
        <section class="panel" id="interventions">
            <h2>Intervention scan</h2>
            <p class="section-intro">Interventions applied singly and in combination to the <code>{{ scan.scenario }}</code> scenario. Baseline phenotypes: {{ scan.baseline_active_phenotypes | join(', ') | replace('_', ' ') }}.</p>
            <div class="table-scroll">
            <table class="data">
                <thead><tr><th>Interventions</th><th>Cleared</th><th>Persisting</th></tr></thead>
                <tbody>
                {% for name, row in scan.results.items() %}
                <tr>
                    <td class="small">{{ row.interventions | join(' + ') | replace('_', ' ') }}</td>
                    <td class="small">{{ row.cleared | join(', ') | replace('_', ' ') or '—' }}</td>
                    <td class="small">{{ row.persisting | join(', ') | replace('_', ' ') or '—' }}</td>
                </tr>
                {% endfor %}
                </tbody>
            </table>
            </div>
        </section>
        {% else %}
        <section class="panel"><h2>Results</h2><p class="section-intro">See <a href="{{ m.folder_url }}/results.json">results.json</a>.</p></section>
        {% endif %}
        {% endif %}

        {% if m.kind == 'authored' %}
        <section class="panel" id="rules">
            <h2>Rules and where each comes from</h2>
            <p class="section-intro">Each rule transcribes a node or causal edge curated on {% if m.source %}<a href="{{ m.source.page_href }}">{{ m.source.entry_name }}</a>{% else %}the source entry{% endif %}. A rule no curated edge states is marked as a background assumption.</p>
            {% for group_title, rows in [('Inputs', m.inputs), ('Interventions', m.interventions), ('Rules', m.rules), ('Outputs', m.outputs)] %}
            {% if rows %}
            <h3>{{ group_title }}</h3>
            {% for row in rows %}
            <div class="rule{% if row.background_assumption %} assumption{% endif %}">
                <div class="rule-name">{{ row.name }}{% if row.background_assumption %}<span class="badge-assumption">background assumption</span>{% endif %}</div>
                {% if row.rule %}<div class="rule-expr">{{ row.rule }}</div>{% endif %}
                {% if row.description %}<div class="rule-meta">{{ row.description }}</div>{% endif %}
                {% if row.default is not none and row.default is defined %}<div class="rule-meta">Default {{ row.default }}{% if row.range %}; range {{ row.range | join('–') }}{% endif %}</div>{% elif row.range %}<div class="rule-meta">Range {{ row.range | join('–') }}</div>{% endif %}
                {% if row.maps_to %}<div class="rule-meta">Maps to {% if row.maps_to.href %}<a href="{{ row.maps_to.href }}">{{ row.maps_to.text }}</a>{% else %}{{ row.maps_to.text }}{% endif %}</div>{% endif %}
                {% if row.provenance and not row.background_assumption %}
                <div class="rule-meta">Provenance:<ul>{% for p in row.provenance %}<li>{{ p }}</li>{% endfor %}</ul></div>
                {% endif %}
                {% if row.decision %}<div class="rule-decision"><strong>Decision.</strong> {{ row.decision }}</div>{% endif %}
            </div>
            {% endfor %}
            {% endif %}
            {% endfor %}
        </section>
        {% endif %}

        {% if m.kind == 'perturb' %}
        {% if m.run %}
        <section class="panel" id="run">
            <h2>Committed run</h2>
            <p class="section-intro">From <code>exports/model_runs/{{ m.model_id }}.json</code>, regenerated by <code>just gen-model-results</code>. Scenario roots link to the mechanism node they drive on the entry page.</p>
            {% set run = m.run %}{% set run_open = true %}
            {% include "_model_run_results.html.j2" %}
            {% if run.thresholds %}
            <h3>Phenotype thresholds</h3>
            <div class="table-scroll">
            <table class="data">
                <thead><tr><th>Phenotype</th><th>Variable</th><th>Direction</th><th class="num">Threshold</th><th>Reading</th></tr></thead>
                <tbody>
                {% for t in run.thresholds %}
                <tr>
                    <td><a href="{{ t.hp_id | curie_to_url }}" target="_blank" rel="noopener">{{ t.hp_label }}</a></td>
                    <td><code>{{ t.model_variable }}</code></td>
                    <td>{{ t.direction }}</td>
                    <td class="num">{{ t.threshold }}</td>
                    <td class="small">{{ 'ratio of baseline' if t.threshold_kind == 'ratio_of_baseline' else 'absolute' }}</td>
                </tr>
                {% endfor %}
                </tbody>
            </table>
            </div>
            {% endif %}
        </section>
        {% endif %}
        {% if m.gene_effects %}
        <section class="panel" id="gene-effects">
            <h2>Gene effects</h2>
            <p class="section-intro">How <code>config.yaml</code> turns a gene perturbation into a model parameter change: the multiplier applied for a loss- or gain-of-function.</p>
            <div class="table-scroll">
            <table class="data">
                <thead><tr><th>Gene</th><th>Parameter</th><th>Effect</th><th>Rationale</th></tr></thead>
                <tbody>
                {% for g in m.gene_effects %}
                <tr>
                    <td><code>{{ g.gene }}</code></td>
                    <td><code>{{ g.parameter }}</code></td>
                    <td class="small">{% for k, v in g.effects.items() %}{{ k }} &times;{{ v }}{% if not loop.last %}, {% endif %}{% endfor %}</td>
                    <td class="small">{{ g.description or '' }}</td>
                </tr>
                {% endfor %}
                </tbody>
            </table>
            </div>
        </section>
        {% endif %}
        {% endif %}

        <section class="panel" id="run-locally">
            <h2>Run it locally</h2>
            {% for cmd in m.run_commands or [] %}<code class="cmd">{{ cmd }}</code>{% endfor %}
            <h3>Files</h3>
            <div class="file-list">{% for f in m.files %}<a href="{{ f.url }}" target="_blank" rel="noopener">{{ f.name }}</a>{% endfor %}</div>
        </section>

        {% include "_disclaimer_footer.html.j2" %}
    </main>
</body>
</html>
