{#
  Pathograph links for a model (experimental / animal / computational). All
  three use the same ModelMechanismLink object, so they share one renderer:
  what the model does to the node, how faithfully, at what scale, the caveat,
  its typed divergences, and the outcome measures that ground the claim. A
  readout's `target` repeats the link's target by design, so it is suppressed.
  Expects `links` (resolved by render._annotate_model_links) plus
  render_experiment_readout and render_evidence in context.
#}
{% if links %}
<div class="crosslink-block">
    <div class="crosslink-title">Pathograph links</div>
    <div class="crosslink-list">
        {% for link in links %}
        <div class="crosslink-item">
            <a href="#{{ link._target_anchor }}">{{ link.target }}</a>
            {% if link.relationship %}
            <span class="crosslink-meta">{{ link.relationship | replace('_', ' ') | lower }}</span>
            {% endif %}
            {% if link.fidelity %}
            <span class="crosslink-meta">fidelity: {{ link.fidelity | lower }}</span>
            {% endif %}
            {% if link.model_scale %}
            <span class="model-link-scale" title="The biological scale the model observes, which may be below the scale of the node it is linked to.">observes: {{ link.model_scale | lower }}</span>
            {% endif %}
            {% if link.description %}
            <span class="crosslink-desc">{{ link.description }}</span>
            {% endif %}
            {% if link.limitations %}
            <div class="mapping-notes">Limitations: {{ link.limitations }}</div>
            {% endif %}
            {% if link.divergences %}
            <div class="experiment-section">
                <div class="experiment-section-title">Divergences from the human mechanism</div>
                {% for divergence in link.divergences %}
                <div class="model-divergence">
                    <span class="model-divergence-type">{{ divergence.divergence_type | replace('_', ' ') | lower }}</span>
                    {% if divergence.materiality %}
                    <span class="model-materiality model-materiality-{{ divergence.materiality }}">{{ divergence.materiality | lower }}</span>
                    {% endif %}
                    {% if divergence.description %}
                    <div class="mapping-notes">{{ divergence.description }}</div>
                    {% endif %}
                </div>
                {% endfor %}
            </div>
            {% endif %}
            {% if link.readouts %}
            <div class="experiment-section">
                <div class="experiment-section-title">Readouts</div>
                {% for readout in link.readouts %}
                {{ render_experiment_readout(readout, show_target=false) }}
                {% endfor %}
            </div>
            {% endif %}
            {{ render_evidence(link.evidence, max_visible=1) }}
        </div>
        {% endfor %}
    </div>
</div>
{% endif %}
