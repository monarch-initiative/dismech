<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Module Collections - dismech</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin="anonymous">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous">
    <link href="https://fonts.googleapis.com/css2?family=Lora:wght@400;600;700&display=swap" rel="stylesheet">
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        {% include '_palette.css.j2' %}
        {% include '_disclaimer.css.j2' %}
        body { font-family: var(--font); color: var(--gray-800); line-height: 1.65; background: var(--gray-50); }
        a { color: var(--teal); text-decoration: none; }
        a:hover { text-decoration: underline; }
        nav { padding: .75rem 1.5rem; background: #fff; border-bottom: 1px solid var(--gray-200); }
        .nav-inner { max-width: 960px; margin: auto; display: flex; justify-content: space-between; }
        .nav-links { display: flex; gap: 1rem; font-size: .86rem; }
        header { padding: 4rem 1.5rem 2.5rem; background: var(--teal-50); border-bottom: 1px solid var(--gray-200); }
        .inner { max-width: 960px; margin: auto; }
        h1 { color: var(--teal); font-size: 2.2rem; }
        header p { max-width: 650px; margin-top: .6rem; color: var(--gray-600); }
        main { max-width: 960px; margin: auto; padding: 2rem 1.5rem 4rem; }
        .collection-list { display: grid; gap: .8rem; margin-top: 1.2rem; }
        .collection { padding: 1.15rem; border: 1px solid var(--gray-200); border-radius: 10px; background: #fff; }
        .collection h2 { font-size: 1.08rem; }
        .collection p { margin-top: .35rem; color: var(--gray-600); font-size: .9rem; }
        .meta { margin-top: .65rem; color: var(--teal); font-size: .76rem; font-weight: 700; }
    </style>
</head>
<body>
    {% include '_disclaimer.html.j2' %}
    <nav><div class="nav-inner"><a href="../../"><strong>dismech</strong></a><div class="nav-links"><a href="../modules/">Modules</a><a href="../groupings/">Disease groupings</a></div></div></nav>
    <header><div class="inner"><h1>Module Collections</h1><p>Curated scientific frameworks and navigational families for exploring conserved mechanism modules. Collections are separate from disease groupings.</p></div></header>
    <main>
        <p><a href="../../">Home</a> / Module collections</p>
        <div class="collection-list">
            {% for collection in collections %}
            <article class="collection"><h2><a href="{{ collection.page_name }}">{{ collection.display_name or collection.name }}</a></h2>{% if collection.description %}<p>{{ collection.description }}</p>{% endif %}<div class="meta">{{ collection.collection_type | replace('_', ' ') | title }} · {{ collection.module_count }} modules</div></article>
            {% endfor %}
        </div>
    </main>
</body>
</html>
