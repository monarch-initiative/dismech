    {# ExternalAssertion is bound to both Variant and Disease, so its rendering
       lives in a shared macro: variants call it inline (issue #8037/#8042) and
       the disease-level "External Assertions" card calls it too (issue #8044).
       External assertions are not pathograph nodes -- dismech.graph emits none
       -- so the cards carry a stable anchor id but no data-dismech-node pair. #}
    {% macro render_external_assertion_body(assertion) %}
    {% if assertion.name %}
    <div class="item-name">{{ assertion.name }}</div>
    {% endif %}
    <div class="item-meta">
        {% if assertion.source %}
        <span class="tag" style="background: #e0f2fe; color: #0369a1;">{{ assertion.source }}</span>
        {% endif %}
        {% if assertion.assertion_type %}
        <span class="tag" style="background: #f1f5f9; color: #475569;">{{ assertion.assertion_type | replace('_', ' ') }}</span>
        {% endif %}
        {% if assertion.external_id %}
        {% set assertion_id = assertion.external_id | string %}
        {# Only link out over http(s); a curated javascript: URL must not become clickable. #}
        {% if assertion.url and (assertion.url | string | lower).startswith(('http://', 'https://')) %}
        <a class="curie-chip" href="{{ assertion.url }}" target="_blank" rel="noopener noreferrer" title="Open {{ assertion_id }}">{{ assertion_id }}</a>
        {% elif is_curie(assertion_id) %}
        {# No usable URL, but a CURIE goes through the same `curie_to_url` every
           other identifier chip on the page uses -- ORPHA:558 and OMIM:154700
           should not be dead grey text. Neither prefix is in the schema prefix
           map, so both take that helper's bioregistry fallback, which is also
           how they already render as evidence references further down. #}
        {{ render_curie_link(assertion_id) }}
        {% else %}
        <span class="tag" style="background: #f1f5f9; color: #475569;">{{ assertion_id }}</span>
        {% endif %}
        {% endif %}
    </div>
    {% if assertion.description %}
    <div class="item-desc">{{ assertion.description }}</div>
    {% endif %}
    {# `notes` often records how the external record's scope differs from this
       entry's -- a lump/split caveat that contradicts the description if the
       reader only sees the description. #}
    {% if assertion.notes %}
    <div class="mapping-notes">{{ assertion.notes }}</div>
    {% endif %}
    {{ render_evidence(assertion.evidence) }}
    {% endmacro %}

    {% macro render_external_assertions_block(assertions) %}
    {% if assertions %}
    <div class="crosslink-block">
        <div class="crosslink-title">External assertions</div>
        {% for assertion in assertions %}
        <div class="variant-effect">
            {{ render_external_assertion_body(assertion) }}
        </div>
        {% endfor %}
    </div>
    {% endif %}
    {% endmacro %}

    {% macro render_variant_body(variant) %}
    <div class="item-name">
        {{ variant.name }}
        {% if variant.clinical_significance %}
        <span class="variant-significance variant-significance-{{ variant.clinical_significance | lower | replace('_', '-') }}">{{ variant.clinical_significance | replace('_', ' ') | title }}</span>
        {% endif %}
    </div>
    {% if variant.gene or variant.type or variant.regulatory_category or variant.sequence_length %}
    <div class="item-meta">
        {% if variant.gene %}
        {% set variant_gene_label = variant.gene.preferred_term or (variant.gene.term.label if variant.gene.term else '') %}
        {% set variant_gene_id = variant.gene.term.id if variant.gene.term else none %}
        {% set tooltip = term_tooltip(variant.gene, "variant.gene") %}
        {% set pill_tips.n = pill_tips.n + 1 %}{% set tip_id = "pill-tip-" ~ pill_tips.n %}
        <span class="tag" style="background: #dbeafe; color: #1e40af;">
            Gene: {{ variant_gene_label }}{% if variant_gene_id %} {{ render_curie_link(variant_gene_id, describedby=tip_id) }}{% endif %}
            {% if tooltip %}<span class="pill-tip" role="tooltip" id="{{ tip_id }}">{{ tooltip }}</span>{% endif %}
        </span>
        {% endif %}
        {% if variant.type %}
        <span class="tag" style="background: #e0e7ff; color: #3730a3;">{{ variant.type | replace('_', ' ') }}</span>
        {% endif %}
        {% if variant.regulatory_category %}
        <span class="tag" style="background: #fef3c7; color: #92400e;">{{ variant.regulatory_category | replace('_', ' ') }}</span>
        {% endif %}
        {% if variant.sequence_length %}
        <span class="tag" style="background: #f1f5f9; color: #475569;">{{ variant.sequence_length }} bp</span>
        {% endif %}
    </div>
    {% endif %}
    {% if variant.description %}
    <div class="item-desc">{{ variant.description }}</div>
    {% endif %}
    {% if variant.synonyms %}
    <div class="item-meta">
        <strong style="font-size: 0.8rem; color: #6b7280;">Also known as:</strong>
        {% for synonym in variant.synonyms %}
        <span class="tag" style="background: #f1f5f9; color: #475569;">{{ synonym }}</span>
        {% endfor %}
    </div>
    {% endif %}
    {% if variant.identifiers %}
    <div class="item-meta">
        <strong style="font-size: 0.8rem; color: #6b7280;">Identifiers:</strong>
        {% for identifier in variant.identifiers %}
        {{ render_curie_link(identifier) }}
        {% endfor %}
    </div>
    {% endif %}
    {% if variant.functional_effects %}
    <div class="crosslink-block">
        <div class="crosslink-title">Functional effects</div>
        {% for effect in variant.functional_effects %}
        <div class="variant-effect">
            {% if effect.function or effect.type or effect.regulatory_category or effect.regulatory_element_type %}
            <div class="item-meta">
                {% if effect.function %}
                <span class="tag" style="background: #dcfce7; color: #166534;">{{ effect.function }}</span>
                {% endif %}
                {% if effect.type %}
                <span class="tag" style="background: #e0e7ff; color: #3730a3;">{{ effect.type | replace('_', ' ') }}</span>
                {% endif %}
                {% if effect.regulatory_category %}
                <span class="tag" style="background: #fef3c7; color: #92400e;">{{ effect.regulatory_category | replace('_', ' ') }}</span>
                {% endif %}
                {% if effect.regulatory_element_type %}
                <span class="tag" style="background: #fce7f3; color: #9d174d;">{{ effect.regulatory_element_type | replace('_', ' ') }}</span>
                {% endif %}
            </div>
            {% endif %}
            {% if effect.description %}
            <div class="item-desc">{{ effect.description }}</div>
            {% endif %}
            {% if effect.regulatory_mechanism %}
            <div class="item-desc"><strong>Mechanism:</strong> {{ effect.regulatory_mechanism }}</div>
            {% endif %}
            {% if effect.affected_cell_types %}
            <div class="item-meta">
                <strong style="font-size: 0.8rem; color: #6b7280;">Affected cell types:</strong>
                {{ render_descriptor_tags(effect.affected_cell_types, "tag-cell", false, "effect.affected_cell_types") }}
            </div>
            {% endif %}
            {% if effect.affected_developmental_stage %}
            <div class="item-desc"><strong>Developmental stage:</strong> {{ effect.affected_developmental_stage }}</div>
            {% endif %}
        </div>
        {% endfor %}
    </div>
    {% endif %}
    {{ render_external_assertions_block(variant.external_assertions) }}
    {{ render_evidence(variant.evidence) }}
    {% endmacro %}

    {# A variant may share its name with its parent gene (or, rarely, another
       variant). Gene cards render first, so findCardForNode's first-match-wins
       lands on the enclosing gene card, which contains the variant anyway --
       this is deliberate, not a collision to "fix". #}
    {% macro render_variant_card(variant, box_class="variant-box") %}
    <div class="item-box {{ box_class }} anchor-target"{% if variant._anchor_id %} id="{{ variant._anchor_id }}"{% endif %} data-dismech-node="{{ variant.name | e }}" data-dismech-type="genetic">
        {{ render_variant_body(variant) }}
    </div>
    {% endmacro %}

