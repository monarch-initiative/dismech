        <!-- Mechanistic Hypotheses -->
        {% if disorder.mechanistic_hypotheses %}
        <div class="card" id="mechanistic-hypotheses">
            <div class="card-header">
                <div class="card-icon" style="background: #ecfdf5; color: #059669;">◈</div>
                <h2 class="card-title">Mechanistic Hypotheses</h2>
                <span class="card-count">{{ disorder.mechanistic_hypotheses | length }}</span>
            </div>
            {% for hypothesis in disorder.mechanistic_hypotheses %}
            <div class="item-box hypothesis-box anchor-target{% if hypothesis.status == 'DEPRECATED' %} hypothesis-deprecated{% endif %}"{% if hypothesis._anchor_id %} id="{{ hypothesis._anchor_id }}"{% endif %}>
                <div class="item-name">{{ hypothesis.hypothesis_label or hypothesis.hypothesis_group_id }}</div>
                <div class="item-meta">
                    {% if hypothesis.hypothesis_group_id %}
                    <span class="tag tag-parent">{{ hypothesis.hypothesis_group_id }}</span>
                    {% endif %}
                    {% if hypothesis.status %}
                    <span class="tag tag-mechanistic tag-hypothesis-{{ hypothesis.status }}">{% if hypothesis.status == 'DEPRECATED' %}⚠ {% endif %}{{ hypothesis.status }}</span>
                    {% endif %}
                    {% for subtype in hypothesis.applies_to_subtypes or [] %}
                    <span class="tag tag-classification">{{ subtype }}</span>
                    {% endfor %}
                </div>
                {% if hypothesis.status == 'DEPRECATED' %}
                <div class="hypothesis-overturned">
                    <div class="hypothesis-overturned-title">⚠ Overturned model &mdash; shown for reference, not as current mechanism</div>
                    <p>
                        DisMech records superseded hypotheses explicitly rather than deleting
                        them, so that claims still circulating in reviews, textbooks and older
                        diagnostic criteria can be checked against an assessment. This model is
                        <strong>not</strong> part of the disease mechanism DisMech asserts.
                    </p>
                    <p>
                        Citation volume does not decide standing here. A hypothesis may retain
                        more supporting than refuting citations simply because the supporting
                        literature accumulated for decades before the refutation landed; where
                        the two conflict, DisMech follows the more recent and more direct
                        evidence. Supporting citations below are retained for the historical
                        record.
                    </p>
                </div>
                {% endif %}
                {% if hypothesis._evidence_tally %}
                <div class="hypothesis-evidence-balance">
                    <span class="hypothesis-evidence-balance-label">Evidence balance</span>
                    {% for bucket in hypothesis._evidence_tally %}
                    <span class="evidence-support support-{{ bucket.supports }}">{{ bucket.count }} {{ bucket.supports | replace('_', ' ') | lower }}</span>
                    {% endfor %}
                </div>
                {% endif %}
                {% if hypothesis.description %}
                <div class="item-desc" style="margin-top: 8px;">{{ hypothesis.description }}</div>
                {% endif %}
                {% if hypothesis.notes %}
                <div class="mapping-notes">{{ hypothesis.notes }}</div>
                {% endif %}
                {% if hypothesis._pathograph_links %}
                <div class="crosslink-block">
                    <div class="crosslink-title">Pathograph links</div>
                    <div class="crosslink-list">
                        {% for link in hypothesis._pathograph_links %}
                        <div class="crosslink-item">
                            {% if link.source_anchor %}
                            <a href="#{{ link.source_anchor }}">{{ link.source }}</a>
                            {% else %}
                            <span class="crosslink-meta">{{ link.source }}</span>
                            {% endif %}
                            <span class="crosslink-desc">-&gt;</span>
                            {% if link.target_anchor %}
                            <a href="#{{ link.target_anchor }}">{{ link.target }}</a>
                            {% else %}
                            <a href="#pathograph">{{ link.target }}</a>
                            {% endif %}
                            {% if link.causal_link_type %}
                            <span class="crosslink-meta">{{ link.causal_link_type | replace('_', ' ') }}</span>
                            {% endif %}
                            {% if link.description %}
                            <span class="crosslink-desc">{{ link.description }}</span>
                            {% endif %}
                            {% if link.intermediate_mechanisms %}
                            <span class="crosslink-desc">Intermediates: {{ link.intermediate_mechanisms | join('; ') }}</span>
                            {% endif %}
                        </div>
                        {% endfor %}
                    </div>
                </div>
                {% endif %}
                {% if hypothesis._research_reports %}
                <div class="crosslink-block">
                    <div class="crosslink-title">Deep research</div>
                    <div class="crosslink-list">
                        {% for report in hypothesis._research_reports %}
                        <div class="crosslink-item">
                            <a href="{{ report.href }}" target="_blank">{{ report.provider_label }}</a>
                            {% if report.citations_href %}
                            <a href="{{ report.citations_href }}" target="_blank" style="margin-left: 8px;">citations</a>
                            {% endif %}
                            {% if report.citation_count is not none %}
                            <span class="reference-summary">{{ report.citation_count }} citations</span>
                            {% endif %}
                            {% if report.end_time %}
                            <span class="report-meta-text">{{ report.end_time }}</span>
                            {% endif %}
                        </div>
                        {% endfor %}
                    </div>
                </div>
                {% endif %}
                {{ render_evidence(hypothesis.evidence) }}
            </div>
            {% endfor %}
        </div>
        {% endif %}

