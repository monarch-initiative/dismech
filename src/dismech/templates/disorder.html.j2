            {% if literature_count %}
            <a class="stat-link" href="#literature-summaries">
            <div class="stat-item">
                <div class="stat-icon" aria-hidden="true">🔭</div>
                <div class="stat-value">{{ literature_count }}</div>
                <div class="stat-label">Deep Research</div>
            </div>
            </a>
            {% endif %}
            {% if hypothesis_research_count and mechanistic_hypotheses_count %}
            <a class="stat-link" href="#mechanistic-hypotheses">
            <div class="stat-item">
                <div class="stat-icon" aria-hidden="true">◈</div>
                <div class="stat-value">{{ hypothesis_research_count }}</div>
                <div class="stat-label">Hyp. Reports</div>
            </div>
            </a>
            {% endif %}
        </div>

        <!-- Classifications -->
        {% if disorder.classifications %}
        {# Slots whose values are mechanism/pathway statements rather than nosology #}
        {# placements; styled differently, as they were before this became a loop.  #}
        {% set mechanistic_slots = ['mechanistic_category', 'lysosomal_storage_category', 'channelopathy_category'] %}
        {% set groups_with_content = [] %}
        {% for group in classification_spec %}
        {% set present = [] %}
        {% for member in group.members %}
        {% if disorder.classifications.get(member.slot) %}{% set _ = present.append(member) %}{% endif %}
        {% endfor %}
        {% if present %}{% set _ = groups_with_content.append({'label': group.label, 'members': present, 'multi': group.members | length > 1}) %}{% endif %}
        {% endfor %}
        {% if groups_with_content %}
        <div class="card">
            <div class="card-header">
                <div class="card-icon" style="background: #fef3c7; color: #d97706;">🏷</div>
                <h2 class="card-title">Classifications</h2>
            </div>
            {# Driven by classification_spec, derived from DiseaseClassifications in the   #}
            {# schema, so a newly added classification slot renders with no template edit. #}
            {# Labels are the slots' LinkML `title`; nesting follows their `slot_group`.   #}
            {% for group in groups_with_content %}
            <div style="margin-bottom: 16px;">
                <div class="classification-category">{{ group.label }}</div>
                {% for member in group.members %}
                {% set entry = disorder.classifications[member.slot] %}
                {% set items = entry if entry is sequence and entry is not mapping else [entry] %}
                <div class="tag-list">
                    {# A grouped slot needs its own sub-label; a lone slot would just #}
                    {# repeat the group heading it is the sole member of.             #}
                    {% if group.multi %}
                    <span style="font-size: 0.78rem; color: #6b7280;">{{ member.label }}</span>
                    {% endif %}
                    {% for item in items %}
                    {% set value = item.classification_value %}
                    <span class="tag {{ 'tag-mechanistic' if member.slot in mechanistic_slots else 'tag-classification' }}"{% if item.notes %} title="{{ item.notes }}"{% endif %}>{{ value | replace('_', ' ') }}{% if value is string and value.startswith('suspected_') %} (Annex II — suspected){% endif %}</span>
                    {% endfor %}
                </div>
                {% endfor %}
            </div>
            {% endfor %}
        </div>
        {% endif %}
        {% endif %}

        <!-- Mappings -->
        {% if disorder.mappings %}
        <div class="card" id="mappings">
            <div class="card-header">
                <div class="card-icon" style="background: #e0f2fe; color: #0369a1;">🔗</div>
                <h2 class="card-title">Mappings</h2>
            </div>
            {% if disorder.mappings.mondo_mappings %}
            <div class="mapping-section">
                <div class="classification-category">MONDO</div>
                {% for mapping in disorder.mappings.mondo_mappings %}
                {% set mapping_term_id = mapping.term.id if mapping.term and mapping.term.id else None %}
                {% set mapping_has_local_page = (mapping_term_id | has_local_disorder_page) if mapping_term_id else False %}
                {% set mapping_dismech_href = (mapping_term_id | dismech_page_url) if mapping_term_id else None %}
                {# Mapping is ontology grounding only (not a separate curation target) when either #}
                {# (a) the predicate is skos:exactMatch, or #}
                {# (b) the mapped term IS this page's own disease_term (a self-mapping under any predicate). #}
                {# Case (b) covers the closeMatch self-mappings — refined / metastatic / molecular-subtype lenses #}
                {# on the same MONDO term (e.g., Metastatic_NSCLC.yaml closeMatch MONDO:0005233) — for which #}
                {# flagging "Not Yet Curated" against the page's own term is misleading (#1307). #}
                {% set mapping_is_exact = mapping.mapping_predicate == "skos:exactMatch" %}
                {% set disease_term_id = disorder.disease_term.term.id if disorder.disease_term and disorder.disease_term.term else None %}
                {% set mapping_is_self_mapping = mapping_term_id and disease_term_id and mapping_term_id == disease_term_id %}
                {% set mapping_flag_missing = mapping_term_id and not mapping_has_local_page and not mapping_is_exact and not mapping_is_self_mapping %}
                <div class="mapping-item">
                    <div class="mapping-title">
                        {% if mapping_term_id %}
                        <a href="{{ mapping_term_id | curie_to_url }}" target="_blank"{% if mapping_flag_missing %} class="missing-ontology-link"{% endif %}>{{ mapping_term_id }}</a>
                        {% endif %}
                        {% if mapping.term and mapping.term.label %}
