        {% endif %}
        {% if perturbation.gene %}
        <div class="item-meta">{{ render_descriptor_tag(perturbation.gene, "tag-gene", false, "perturbation.gene") }}</div>
        {% endif %}
        {{ render_descriptor_tags(perturbation.genes, "tag-gene", false, "perturbation.gene") }}
        {{ render_descriptor_tags(perturbation.chemical_entities, "tag-chemical", false, "perturbation.chemical_entities") }}
