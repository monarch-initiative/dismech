    {% endif %}
    {% if descriptor.severity %}
    <span class="tag tag-classification">Severity: {{ descriptor.severity | replace('_', ' ') }}</span>
    {% endif %}
    {% if descriptor.onset %}
    {{ render_onset_badge(descriptor.onset) }}
    {% endif %}
    {% endif %}
    {% endmacro %}

    {# `tooltip` (issue #8310) spells the annotation out in plain language.
       Most chips sit inside a pill that already carries it: those pass
       `inherits_title=tooltip` and set no title of their own, since HTML resolves
       `title` from the nearest titled ancestor -- so the hover text does not
       change as the pointer crosses from the label onto the identifier, without
       repeating the string. Only a chip rendered OUTSIDE its pill (the
       treatment/regimen sites below) passes `tooltip` and carries its own. With
       neither, the chip falls back to "Open <CURIE>". #}
    {% macro render_curie_link(curie, describedby="") %}
    {% if curie %}
    {% set curie_prefix = curie.split(':')[0] | lower | replace('_', '-') %}
    <a href="{{ curie | curie_to_url }}" target="_blank" class="curie-chip curie-chip-{{ curie_prefix }}"{% if describedby %} aria-describedby="{{ describedby }}"{% else %} title="Open {{ curie }}"{% endif %}>{{ curie }}</a>
    {% endif %}
    {% endmacro %}

    {% macro render_descriptor_tag(descriptor, tag_class="tag-bio", show_term_id=false, role="") %}
    {% if descriptor %}
    {% set term_label = descriptor.term.label if descriptor.term else '' %}
    {% set display = descriptor.preferred_term or term_label or descriptor.name or '' %}
    {% set tooltip = term_tooltip(descriptor, role) %}
    {% if display %}
    {% set pill_tips.n = pill_tips.n + 1 %}{% set tip_id = "pill-tip-" ~ pill_tips.n %}
    {# The chip is conditional, so the pill only needs its own tab stop when no
       chip renders -- otherwise the chip is the single stop that both reveals
       the tooltip (via :focus-within) and announces it (via aria-describedby). #}
    {% set has_chip = descriptor.term and descriptor.term.id %}
    <span class="tag {{ tag_class }}"{% if tooltip and not has_chip %} tabindex="0" aria-describedby="{{ tip_id }}"{% endif %}>
        {% if has_chip %}
        {{ display }} {{ render_curie_link(descriptor.term.id, describedby=tip_id) }}
        {% else %}
        {{ display }}
        {% endif %}
        {% if tooltip %}<span class="pill-tip" role="tooltip" id="{{ tip_id }}">{{ tooltip }}</span>{% endif %}
    </span>
    {{ render_descriptor_qualifiers(descriptor) }}
    {% endif %}
    {% endif %}
    {% endmacro %}

    {% macro render_descriptor_tags(descriptors, tag_class="tag-bio", show_term_id=false, role="") %}
    {% if descriptors %}
    <div class="item-meta">
        {% for descriptor in descriptors %}
        {{ render_descriptor_tag(descriptor, tag_class, show_term_id, role) }}
        {% endfor %}
    </div>
    {% endif %}
    {% endmacro %}

