                <div class="item-name">{{ discussion.prompt }}</div>
                <div class="item-meta">
                    {% if discussion.kind %}
                    <span class="tag tag-discussion-kind">{{ discussion.kind | replace('_', ' ') }}</span>
                    {% endif %}
                    {% if discussion.status %}
                    <span class="tag tag-discussion-status">{{ discussion.status | replace('_', ' ') }}</span>
                    {% endif %}
                    {% if discussion.discussion_id %}
                    <span class="entity-ref-chip">{{ discussion.discussion_id }}</span>
                    {% endif %}
                </div>
                {% if discussion.attaches_to %}
                <div class="experiment-section">
                    <div class="experiment-section-title">Attached to</div>
                    <div class="entity-ref-list">
                        {% for ref in discussion.attaches_to %}
                        {{ render_entity_ref(ref) }}
                        {% endfor %}
                    </div>
                </div>
                {% endif %}
                {% if discussion.rationale %}
                <div class="item-desc" style="margin-top: 10px;">{{ discussion.rationale }}</div>
                {% endif %}
                {% if discussion.proposed_experiments %}
                <div class="experiment-section">
                    <div class="experiment-section-title">Proposed experiments</div>
                    <div class="experiment-list">
                        {% for experiment in discussion.proposed_experiments %}
                        {{ render_experiment(experiment) }}
                        {% endfor %}
                    </div>
                </div>
                {% endif %}
                {% if discussion.posed_by or discussion.posed_date or discussion.resolved_date %}
                <div class="item-meta">
                    {% if discussion.posed_by %}
                    <span class="tag tag-discussion-status">Posed by {{ discussion.posed_by }}</span>
                    {% endif %}
                    {% if discussion.posed_date %}
                    <span class="tag tag-discussion-status">Posed {{ discussion.posed_date }}</span>
                    {% endif %}
                    {% if discussion.resolved_date %}
                    <span class="tag tag-discussion-status">Resolved {{ discussion.resolved_date }}</span>
                    {% endif %}
                </div>
                {% endif %}
                {% if discussion.resolution_note %}
                <div class="mapping-notes">Resolution: {{ discussion.resolution_note }}</div>
                {% endif %}
                {% if discussion.notes %}
                <div class="mapping-notes">{{ discussion.notes }}</div>
                {% endif %}
                {{ render_evidence(discussion.evidence) }}
            </div>
            {% endfor %}
        </div>
        {% endif %}

        <!-- Pathophysiology -->
        {% if disorder.pathophysiology %}
        <div class="card" id="pathophysiology">
            <div class="card-header">
                <div class="card-icon" style="background: #fef3c7; color: #d97706;">⚙</div>
                <h2 class="card-title">Pathophysiology</h2>
                <span class="card-count">{{ disorder.pathophysiology | length }}</span>
            </div>
            {% for patho in disorder.pathophysiology %}
            <div class="item-box pathophys-box anchor-target" id="{{ patho._anchor_id }}" data-dismech-node="{{ patho.name | e }}" data-dismech-type="pathophysiology">
                <div class="item-name">{{ patho.name }}</div>
                {% if patho.description %}
                <div class="item-desc">{{ patho.description }}</div>
                {% endif %}
                {% if patho._hypothesis_links %}
                <div class="item-meta">
                    {% for link in patho._hypothesis_links %}
                    <span class="tag tag-mechanistic{% if link.status == 'DEPRECATED' %} tag-hypothesis-link-DEPRECATED{% endif %}"{% if link.status == 'DEPRECATED' %} title="Overturned hypothesis: retained for reference, not asserted as current mechanism"{% endif %}>
                        {% if link.status == 'DEPRECATED' %}⚠ {% endif %}
                        {% if link.anchor_id %}
                        <a href="#{{ link.anchor_id }}">{{ link.hypothesis_label }}</a>
                        {% else %}
                        {{ link.hypothesis_label }}
                        {% endif %}
                    </span>
                    {% endfor %}
                </div>
                {% endif %}
                {% if patho.cell_types %}
                <div class="item-meta">
                    {% for ct in patho.cell_types %}
                    {% set tooltip = term_tooltip(ct, "pathophysiology.cell_types") %}
                    {% set pill_tips.n = pill_tips.n + 1 %}{% set tip_id = "pill-tip-" ~ pill_tips.n %} {% set has_chip = ct.term and ct.term.id %}
                    <span class="tag tag-cell"{% if tooltip and not has_chip %} tabindex="0" aria-describedby="{{ tip_id }}"{% endif %}>
                        {{ ct.preferred_term or ct.term.label }}
                        {% if has_chip %}
                        {{ render_curie_link(ct.term.id, describedby=tip_id) }}
                        {% endif %}
                        {% if tooltip %}<span class="pill-tip" role="tooltip" id="{{ tip_id }}">{{ tooltip }}</span>{% endif %}
                    </span>
                    {{ render_descriptor_qualifiers(ct) }}
                    {% endfor %}
                </div>
                {% endif %}
                {% if patho.gene %}
                <div class="item-meta">
                    {{ render_descriptor_tag(patho.gene, "tag-gene", true, "pathophysiology.gene") }}
                </div>
                {% endif %}
                {% if patho.genes %}
                <div class="item-meta">
                    {% for g in patho.genes %}
                    {{ render_descriptor_tag(g, "tag-gene", true, "pathophysiology.gene") }}
                    {% endfor %}
                </div>
                {% endif %}
                {{ render_genetic_context(patho.genetic_context) }}
                {% if patho.protein_complexes %}
                <div class="item-meta">
                    {% for pc in patho.protein_complexes %}
                    {% set tooltip = term_tooltip(pc, "pathophysiology.protein_complexes") %}
                    {% set pill_tips.n = pill_tips.n + 1 %}{% set tip_id = "pill-tip-" ~ pill_tips.n %} {% set has_chip = pc.term and pc.term.id %}
                    <span class="tag tag-complex"{% if tooltip and not has_chip %} tabindex="0" aria-describedby="{{ tip_id }}"{% endif %}>
                        {{ pc.preferred_term or pc.term.label }}
                        {% if has_chip %}
                        {{ render_curie_link(pc.term.id, describedby=tip_id) }}
                        {% endif %}
                        {% if tooltip %}<span class="pill-tip" role="tooltip" id="{{ tip_id }}">{{ tooltip }}</span>{% endif %}
                    </span>
                    {% endfor %}
                </div>
                {% endif %}
                {% if patho.biological_processes %}
                <div class="item-meta">
                    {% for bp in patho.biological_processes %}
                    {% set tooltip = term_tooltip(bp, "pathophysiology.biological_processes") %}
                    {% set pill_tips.n = pill_tips.n + 1 %}{% set tip_id = "pill-tip-" ~ pill_tips.n %} {% set has_chip = bp.term and bp.term.id %}
                    <span class="tag tag-bio"{% if tooltip and not has_chip %} tabindex="0" aria-describedby="{{ tip_id }}"{% endif %}>
                        {{ bp.preferred_term or bp.term.label }}
                        {% if has_chip %}
                        {{ render_curie_link(bp.term.id, describedby=tip_id) }}
                        {% endif %}
                        {% if tooltip %}<span class="pill-tip" role="tooltip" id="{{ tip_id }}">{{ tooltip }}</span>{% endif %}
                    </span>
                    {{ render_descriptor_qualifiers(bp) }}
                    {% endfor %}
                </div>
                {% endif %}
                {% if patho.molecular_functions %}
                <div class="item-meta">
                    {% for mf in patho.molecular_functions %}
                    {% set tooltip = term_tooltip(mf, "pathophysiology.molecular_functions") %}
                    {% set pill_tips.n = pill_tips.n + 1 %}{% set tip_id = "pill-tip-" ~ pill_tips.n %} {% set has_chip = mf.term and mf.term.id %}
                    <span class="tag tag-bio"{% if tooltip and not has_chip %} tabindex="0" aria-describedby="{{ tip_id }}"{% endif %}>
                        {{ mf.preferred_term or mf.term.label }}
                        {% if has_chip %}
                        {{ render_curie_link(mf.term.id, describedby=tip_id) }}
                        {% endif %}
                        {% if tooltip %}<span class="pill-tip" role="tooltip" id="{{ tip_id }}">{{ tooltip }}</span>{% endif %}
                    </span>
                    {{ render_descriptor_qualifiers(mf) }}
                    {% endfor %}
                </div>
                {% endif %}
                {% if patho.cellular_components %}
                <div class="item-meta">
                    {% for cc in patho.cellular_components %}
                    {% set tooltip = term_tooltip(cc, "pathophysiology.cellular_components") %}
                    {% set pill_tips.n = pill_tips.n + 1 %}{% set tip_id = "pill-tip-" ~ pill_tips.n %} {% set has_chip = cc.term and cc.term.id %}
                    <span class="tag tag-component"{% if tooltip and not has_chip %} tabindex="0" aria-describedby="{{ tip_id }}"{% endif %}>
                        {{ cc.preferred_term or cc.term.label }}
                        {% if has_chip %}
                        {{ render_curie_link(cc.term.id, describedby=tip_id) }}
                        {% endif %}
                        {% if tooltip %}<span class="pill-tip" role="tooltip" id="{{ tip_id }}">{{ tooltip }}</span>{% endif %}
                    </span>
                    {% endfor %}
                </div>
                {% endif %}
                {% if patho.locations %}
                <div class="item-meta">
                    {% for loc in patho.locations %}
                    {% set tooltip = term_tooltip(loc, "pathophysiology.locations") %}
                    {% set pill_tips.n = pill_tips.n + 1 %}{% set tip_id = "pill-tip-" ~ pill_tips.n %} {% set has_chip = loc.term and loc.term.id %}
                    <span class="tag tag-location"{% if tooltip and not has_chip %} tabindex="0" aria-describedby="{{ tip_id }}"{% endif %}>
                        {{ loc.preferred_term or loc.term.label }}
                        {% if has_chip %}
                        {{ render_curie_link(loc.term.id, describedby=tip_id) }}
                        {% endif %}
                        {% if tooltip %}<span class="pill-tip" role="tooltip" id="{{ tip_id }}">{{ tooltip }}</span>{% endif %}
                    </span>
                    {% endfor %}
                </div>
                {% endif %}
                {% if patho._experimental_model_links %}
                <div class="crosslink-block">
                    <div class="crosslink-title">Experimental models</div>
                    <div class="crosslink-list">
                        {% for link in patho._experimental_model_links %}
                        <div class="crosslink-item">
                            <a href="#{{ link.model_anchor }}">{{ link.model_name }}</a>
                            {% if link.experimental_model_type %}
                            <span class="crosslink-meta">{{ link.experimental_model_type | replace('_', ' ') }}</span>
                            {% endif %}
                            {% if link.description %}
                            <span class="crosslink-desc">{{ link.description }}</span>
                            {% endif %}
                        </div>
                        {% endfor %}
                    </div>
                </div>
                {% endif %}
                {% if patho._animal_model_links %}
                <div class="crosslink-block">
                    <div class="crosslink-title">Animal models</div>
                    <div class="crosslink-list">
                        {% for link in patho._animal_model_links %}
                        <div class="crosslink-item">
                            <a href="#{{ link.model_anchor }}">{{ link.model_name }}</a>
                            {% if link.species %}
                            <span class="crosslink-meta">{{ link.species }}</span>
                            {% endif %}
                            {% if link.relationship %}
                            <span class="crosslink-meta">{{ link.relationship | replace('_', ' ') | lower }}</span>
                            {% endif %}
                            {% if link.description %}
                            <span class="crosslink-desc">{{ link.description }}</span>
                            {% endif %}
                        </div>
                        {% endfor %}
                    </div>
                </div>
                {% endif %}
	                {% if patho._computational_model_links %}
	                <div class="crosslink-block">
	                    <div class="crosslink-title">Computational models</div>
                    <div class="crosslink-list">
                        {% for link in patho._computational_model_links %}
                        <div class="crosslink-item">
                            <a href="#{{ link.model_anchor }}">{{ link.model_name }}</a>
                            {% if link.model_type %}
                            <span class="crosslink-meta">{{ link.model_type | replace('_', ' ') }}</span>
                            {% endif %}
                            {% if link.model_software %}
                            <span class="crosslink-meta">{{ link.model_software }}</span>
                            {% endif %}
                            {% if link.description %}
                            <span class="crosslink-desc">{{ link.description }}</span>
                            {% endif %}
                        </div>
                        {% endfor %}
	                    </div>
	                </div>
	                {% endif %}
	                {% if patho.downstream %}
	                <div class="crosslink-block">
	                    <div class="crosslink-title">Downstream</div>
	                    <div class="crosslink-list">
	                        {% for edge in patho.downstream %}
	                        <div class="crosslink-item">
	                            <span class="crosslink-meta">{{ edge.target }}</span>
	                            {% if edge.description %}
	                            <span class="crosslink-desc">{{ edge.description }}</span>
	                            {% endif %}
                                {% if edge._hypothesis_links %}
                                <span class="tag-list" style="margin-top: 4px;">
                                    {% for link in edge._hypothesis_links %}
                                    <span class="tag tag-mechanistic{% if link.status == 'DEPRECATED' %} tag-hypothesis-link-DEPRECATED{% endif %}"{% if link.status == 'DEPRECATED' %} title="Overturned hypothesis: retained for reference, not asserted as current mechanism"{% endif %}>
                                        {% if link.status == 'DEPRECATED' %}⚠ {% endif %}
                                        {% if link.anchor_id %}
                                        <a href="#{{ link.anchor_id }}">{{ link.hypothesis_label }}</a>
                                        {% else %}
                                        {{ link.hypothesis_label }}
                                        {% endif %}
                                    </span>
                                    {% endfor %}
                                </span>
                                {% endif %}
	                        </div>
	                        {% endfor %}
	                    </div>
	                </div>
	                {% endif %}
	                {{ render_evidence(patho.evidence) }}
	            </div>
	            {% endfor %}
        </div>
        {% endif %}

        <!-- Histopathology -->
        {% if disorder.histopathology %}
        <div class="card" id="histopathology">
            <div class="card-header">
                <div class="card-icon" style="background: #ffedd5; color: #c2410c;">✶</div>
                <h2 class="card-title">Histopathology</h2>
                <span class="card-count">{{ disorder.histopathology | length }}</span>
            </div>
            {% for histo in disorder.histopathology %}
            <div class="item-box histopathology-box anchor-target"{% if histo._anchor_id %} id="{{ histo._anchor_id }}"{% endif %}>
                <div class="item-name">
                    {{ histo.name }}
                    {% if histo.frequency %}
                    <span class="histopathology-freq">{{ histo.frequency }}</span>
                    {% endif %}
                </div>
                {% if histo.description %}
                <div class="item-desc">{{ histo.description }}</div>
                {% endif %}
                {{ render_evidence(histo.evidence) }}
            </div>
            {% endfor %}
        </div>
        {% endif %}

        <!-- Causal Graph (Pathograph) -->
        {% if pathograph_data %}
        <div class="card">
            <div class="card-header">
                <div class="card-icon" style="background: #e0e7ff; color: #4f46e5;">⬡</div>
                <h2 class="card-title">Pathograph</h2>
            </div>
            <div class="graph-note">Use the checkboxes to hide or show graph categories. Hover nodes for evidence and cross-linked metadata.</div>
            {% if graph_issues %}
            <div class="graph-warning">
                <strong>Referential integrity issues ({{ graph_issues | length }}):</strong>
                <ul>
                    {% for issue in graph_issues[:5] %}
                    <li>{{ issue }}</li>
                    {% endfor %}
                    {% if graph_issues | length > 5 %}
                    <li><em>... and {{ graph_issues | length - 5 }} more</em></li>
                    {% endif %}
                </ul>
            </div>
            {% endif %}
            <div class="pathograph-container" id="pathograph">
                <div class="pathograph-legend" id="pathograph-legend"></div>
                <svg id="pathograph-svg" role="img">
                    <title>Pathograph: causal mechanism network for {{ disorder.name }}</title>
                    <desc>Interactive directed graph showing how pathophysiology mechanisms, phenotypes, genetic factors and variants, experimental models, environmental triggers, and treatments relate through causal and linked edges.</desc>
                </svg>
                <div class="pathograph-tooltip" id="pathograph-tooltip"></div>
            </div>
            <script>
            (function() {
                var graphData = JSON.parse({{ pathograph_data | tojson }});
                renderPathograph("pathograph", graphData);
            })();
            </script>
        </div>
        {% endif %}

        <!-- Phenotypes -->
        {% if disorder.phenotypes %}
        <div class="card" id="phenotypes">
            <div class="card-header">
                <div class="card-icon" style="background: #dcfce7; color: #16a34a;">●</div>
                <h2 class="card-title">Phenotypes</h2>
                <span class="card-count">{{ disorder.phenotypes | length }}</span>
            </div>
            {% if phenotype_groups and phenotype_groups | length > 1 %}
            {# --- TOC strip --- #}
            <div class="pheno-toc">
                {% for category_name, phenos in phenotype_groups %}
                <button type="button" class="pheno-toc-pill" data-target="pheno-cat-{{ loop.index }}">{{ category_name }}<span class="pill-count">({{ phenos | length }})</span></button>
                {% endfor %}
                <button class="pheno-toggle-all" id="phenoToggleAll">Expand all</button>
            </div>
            {# --- Collapsible groups --- #}
            {% for category_name, phenos in phenotype_groups %}
            <details class="phenotype-category-group" id="pheno-cat-{{ loop.index }}">
                <summary>
                    <svg class="chevron" viewBox="0 0 16 16" fill="currentColor"><path d="M6 3l5 5-5 5V3z"/></svg>
                    {{ category_name }}
                    <span class="cat-count">{{ phenos | length }}</span>
                </summary>
                {% for pheno in phenos %}
                <div class="item-box phenotype-box anchor-target"{% if pheno._anchor_id %} id="{{ pheno._anchor_id }}"{% endif %} data-dismech-node="{{ pheno.name | e }}" data-dismech-type="phenotype">
                    <div class="item-name">
                        {{ pheno.name }}
                        {% if pheno.frequency %}
                        <span class="phenotype-freq">{{ pheno.frequency }}</span>
                        {% endif %}
                    {% if pheno.phenotype_term and pheno.phenotype_term.term %}
                    {% set tooltip = term_tooltip(pheno.phenotype_term, "phenotype.phenotype_term") %}
                    {% set pill_tips.n = pill_tips.n + 1 %}{% set tip_id = "pill-tip-" ~ pill_tips.n %}
                    {# The card title is curator free text and the bound term carries
                       its own label, so the two routinely say the same thing (issue
                       #8402). Drop the label when the title already says it -- the
                       CURIE chip and its tooltip still name the term -- and show it
                       as its own muted pill when it does add something, so it can
                       never read as the second half of the title. The bare `term.id`
                       fallback is gone with it: the chip beside it already is the ID.
                       See `dismech.term_labels` for what "already says it" means. #}
                    {% set pheno_term_label = pheno.phenotype_term.term.label %}
                    <span class="phenotype-id">
                        {% if pheno_term_label and not label_restates_title(pheno.name, pheno_term_label) %}
                        <span class="phenotype-term-label">{{ pheno_term_label }}</span>
                        {% endif %}
                        {{ render_curie_link(pheno.phenotype_term.term.id, describedby=tip_id) }}
                        {% if tooltip %}<span class="pill-tip" role="tooltip" id="{{ tip_id }}">{{ tooltip }}</span>{% endif %}
                    </span>
                    {% endif %}
                    </div>
                    {% if pheno.phenotype_term and (pheno.phenotype_term.modifier or pheno.phenotype_term.laterality or pheno.phenotype_term.spatial_extent or pheno.phenotype_term.temporality or pheno.phenotype_term.clinical_course or pheno.phenotype_term.severity or pheno.phenotype_term.onset) %}
                    <div class="item-meta">
                        {{ render_descriptor_qualifiers(pheno.phenotype_term) }}
                    </div>
                    {% endif %}
                    {% if pheno.notes %}
                    <div class="item-desc">{{ pheno.notes }}</div>
                    {% endif %}
                    {% if pheno.sequelae %}
                    <div class="item-meta">
                        <strong style="font-size: 0.8rem; color: #166534;">Sequelae:</strong>
                        {% for seq in pheno.sequelae %}
                        <span class="tag" style="background: #bbf7d0; color: #166534;">{{ seq.target }}</span>
                        {% endfor %}
                    </div>
                    {% endif %}
                    {{ render_evidence(pheno.evidence) }}
                    {{ render_phenotype_contexts(pheno.phenotype_contexts) }}
                </div>
                {% endfor %}
            </details>
            {% endfor %}
            <script>
            (function() {
                // TOC pill click: expand target group and scroll to it
                document.querySelectorAll('.pheno-toc-pill').forEach(function(pill) {
                    pill.addEventListener('click', function() {
                        var target = document.getElementById(pill.dataset.target);
                        if (target) {
                            target.open = true;
                            target.scrollIntoView({behavior: 'smooth', block: 'start'});
                        }
                    });
                });
                // Expand/collapse all toggle
                var btn = document.getElementById('phenoToggleAll');
                if (btn) {
                    btn.addEventListener('click', function() {
                        var groups = document.querySelectorAll('.phenotype-category-group');
                        var anyOpen = Array.from(groups).some(function(g) { return g.open; });
                        groups.forEach(function(g) { g.open = !anyOpen; });
                        btn.textContent = anyOpen ? 'Expand all' : 'Collapse all';
                    });
                }
            })();
            </script>
            {% else %}
            {# --- Flat list fallback (single or no groups) --- #}
            {% for pheno in disorder.phenotypes %}
            <div class="item-box phenotype-box anchor-target"{% if pheno._anchor_id %} id="{{ pheno._anchor_id }}"{% endif %} data-dismech-node="{{ pheno.name | e }}" data-dismech-type="phenotype">
                <div class="item-name">
                    {{ pheno.name }}
                    {% if pheno.frequency %}
                    <span class="phenotype-freq">{{ pheno.frequency }}</span>
                    {% endif %}
                    {% if pheno.category %}
                    <span class="phenotype-category">{{ pheno.category }}</span>
                    {% endif %}
                    {% if pheno.phenotype_term and pheno.phenotype_term.term %}
                    {% set tooltip = term_tooltip(pheno.phenotype_term, "phenotype.phenotype_term") %}
                    {% set pill_tips.n = pill_tips.n + 1 %}{% set tip_id = "pill-tip-" ~ pill_tips.n %}
                    <span class="phenotype-id">
                        {{ render_curie_link(pheno.phenotype_term.term.id, describedby=tip_id) }}
                        {% if tooltip %}<span class="pill-tip" role="tooltip" id="{{ tip_id }}">{{ tooltip }}</span>{% endif %}
                    </span>
                    {% endif %}
                </div>
                {% if pheno.phenotype_term and (pheno.phenotype_term.modifier or pheno.phenotype_term.laterality or pheno.phenotype_term.spatial_extent or pheno.phenotype_term.temporality or pheno.phenotype_term.clinical_course or pheno.phenotype_term.severity or pheno.phenotype_term.onset) %}
                <div class="item-meta">
                    {{ render_descriptor_qualifiers(pheno.phenotype_term) }}
                </div>
                {% endif %}
                {% if pheno.notes %}
                <div class="item-desc">{{ pheno.notes }}</div>
                {% endif %}
                {% if pheno.sequelae %}
                <div class="item-meta">
                    <strong style="font-size: 0.8rem; color: #166534;">Sequelae:</strong>
                    {% for seq in pheno.sequelae %}
                    <span class="tag" style="background: #bbf7d0; color: #166534;">{{ seq.target }}</span>
                    {% endfor %}
                </div>
                {% endif %}
                {{ render_evidence(pheno.evidence) }}
                {{ render_phenotype_contexts(pheno.phenotype_contexts) }}
            </div>
            {% endfor %}
            {% endif %}
        </div>
        {% endif %}

        <!-- Genetic Associations -->
        {% if disorder.genetic %}
        <div class="card" id="genetic">
            <div class="card-header">
                <div class="card-icon" style="background: #dbeafe; color: #2563eb;">🧬</div>
                <h2 class="card-title">Genetic Associations</h2>
                <span class="card-count">{{ disorder.genetic | length }}</span>
            </div>
            {% for gene in disorder.genetic %}
            <div class="item-box genetic-box anchor-target"{% if gene._anchor_id %} id="{{ gene._anchor_id }}"{% endif %} data-dismech-node="{{ gene.name | e }}" data-dismech-type="genetic">
                <div class="item-name">
                    {{ gene.name }}
                    {% if gene.association %}
                    <span style="font-size: 0.8rem; font-weight: normal; opacity: 0.8;">({{ gene.association }})</span>
                    {% endif %}
                </div>
                {% if gene.gene_term or gene.relationship_type or gene.variant_origin %}
                <div class="item-meta">
                    {% if gene.gene_term %}
                    {% set gene_label = gene.gene_term.preferred_term or (gene.gene_term.term.label if gene.gene_term.term else gene.name) %}
                    {% set gene_id = gene.gene_term.term.id if gene.gene_term.term else none %}
                    {% set tooltip = term_tooltip(gene.gene_term, "gene.gene_term") %}
                    {% set pill_tips.n = pill_tips.n + 1 %}{% set tip_id = "pill-tip-" ~ pill_tips.n %}
                    <span class="tag" style="background: #dbeafe; color: #1e40af;">
                        Gene: {{ gene_label }}{% if gene_id %} {{ render_curie_link(gene_id, describedby=tip_id) }}{% endif %}
                        {% if tooltip %}<span class="pill-tip" role="tooltip" id="{{ tip_id }}">{{ tooltip }}</span>{% endif %}
                    </span>
                    {% endif %}
                    {% if gene.relationship_type %}
                    <span class="tag" style="background: #e0e7ff; color: #3730a3;">relationship_type: {{ gene.relationship_type }}</span>
                    {% endif %}
                    {% if gene.variant_origin %}
                    <span class="tag" style="background: #ede9fe; color: #5b21b6;">variant_origin: {{ gene.variant_origin }}</span>
                    {% endif %}
                </div>
                {% endif %}
                {% if gene.inheritance %}
                <div class="item-meta">
                    {% for inheritance_item in gene.inheritance %}
                    <span class="tag" style="background: #bfdbfe; color: #1e40af;">{{ inheritance_item.name }}</span>
                    {% endfor %}
                </div>
                {% endif %}
                {{ render_evidence(gene.evidence) }}
                {% if gene.variants %}
                <details class="variant-list">
                    <summary class="variant-list-toggle">Variants ({{ gene.variants | length }})</summary>
                    {% for variant in gene.variants %}
                    {{ render_variant_card(variant, "variant-box variant-box-nested") }}
                    {% endfor %}
                </details>
                {% endif %}
            </div>
            {% endfor %}
        </div>
        {% endif %}

        <!-- Variants recorded at the disease level -->
        {% if disorder.variants %}
        <div class="card" id="variants">
            <div class="card-header">
                <div class="card-icon" style="background: #ede9fe; color: #6d28d9;">🔬</div>
                <h2 class="card-title">Variants</h2>
                <span class="card-count">{{ disorder.variants | length }}</span>
            </div>
            {% for variant in disorder.variants %}
            {{ render_variant_card(variant) }}
            {% endfor %}
        </div>
        {% endif %}

        <!-- Registry / external-database assertions recorded at the disease level -->
        {% if disorder.external_assertions %}
        <div class="card" id="external-assertions">
            <div class="card-header">
                <div class="card-icon" style="background: #e0f2fe; color: #0369a1;">🗃️</div>
                <h2 class="card-title">External Assertions</h2>
                <span class="card-count">{{ disorder.external_assertions | length }}</span>
            </div>
            {% for assertion in disorder.external_assertions %}
            <div class="item-box anchor-target"{% if assertion._anchor_id %} id="{{ assertion._anchor_id }}"{% endif %}>
                {{ render_external_assertion_body(assertion) }}
            </div>
            {% endfor %}
        </div>
        {% endif %}

        <!-- Medical actions -->
        {% if disorder.treatments %}
        <div class="card" id="treatments">
            <div class="card-header">
                <div class="card-icon" style="background: #ede9fe; color: #7c3aed;">💊</div>
                <h2 class="card-title">Medical Actions</h2>
                <span class="card-count">{{ disorder.treatments | length }}</span>
            </div>
            {% for tx in disorder.treatments %}
            <div class="item-box treatment-box anchor-target"{% if tx._anchor_id %} id="{{ tx._anchor_id }}"{% endif %} data-dismech-node="{{ tx.name | e }}" data-dismech-type="treatment">
                <div class="item-name">
                    {{ tx.name }}
                </div>
                {% if tx.action_category or (tx.treatment_term and tx.treatment_term.term) or (tx.regimen_term and tx.regimen_term.term) -%}
                <div class="item-meta">
                    {% if tx.action_category -%}
                    {% set category_value = tx.action_category | string -%}
                    {% set category_display = "Counseling / Informational" if category_value == "COUNSELING_INFORMATIONAL" else (category_value | replace('_', ' ') | title) -%}
                    <strong style="font-size: 0.8rem; color: #5b21b6;">Category:</strong>
                    <span class="tag tag-treatment">{{ category_display }}</span>
                    {% endif -%}
                    {% if tx.treatment_term and tx.treatment_term.term -%}
                    {% set tx_term_id = tx.treatment_term.term.id -%}
                    {% set tx_term_label = tx.treatment_term.term.label -%}
                    {% set tx_term_display = tx.treatment_term.preferred_term or tx_term_label -%}
                    <strong style="font-size: 0.8rem; color: #5b21b6;{% if tx.action_category %} margin-left: 12px;{% endif %}">Action:</strong>
                    {% set tooltip = term_tooltip(tx.treatment_term, "treatment.treatment_term") %}
                    {% set pill_tips.n = pill_tips.n + 1 %}{% set tip_id = "pill-tip-" ~ pill_tips.n %}
                    <span class="tag tag-treatment"{% if tooltip %} tabindex="0" aria-describedby="{{ tip_id }}"{% endif %}>{{ tx_term_display }}{% if tooltip %}<span class="pill-tip" role="tooltip" id="{{ tip_id }}">{{ tooltip }}</span>{% endif %}
                    </span>
                    {% if tx_term_label and tx_term_display and tx_term_label != tx_term_display -%}
                    <span class="tag" style="background: #f3e8ff; color: #6b21a8;">Ontology label: {{ tx_term_label }}</span>
                    {% endif %}
                    {% if tx_term_id %}
                    {{ render_curie_link(tx_term_id) }}
                    {% endif %}
                    {{ render_descriptor_qualifiers(tx.treatment_term) }}
                    {% endif -%}
                    {% if tx.regimen_term and tx.regimen_term.term -%}
                    {% set regimen_id = tx.regimen_term.term.id -%}
                    {% set regimen_label = tx.regimen_term.term.label -%}
                    {% set regimen_display = tx.regimen_term.preferred_term or regimen_label -%}
                    <strong style="font-size: 0.8rem; color: #5b21b6; margin-left: 12px;">Regimen:</strong>
                    {% set tooltip = term_tooltip(tx.regimen_term, "regimen.treatment_term") %}
                    {% set pill_tips.n = pill_tips.n + 1 %}{% set tip_id = "pill-tip-" ~ pill_tips.n %}
                    <span class="tag tag-treatment"{% if tooltip %} tabindex="0" aria-describedby="{{ tip_id }}"{% endif %}>{{ regimen_display }}{% if tooltip %}<span class="pill-tip" role="tooltip" id="{{ tip_id }}">{{ tooltip }}</span>{% endif %}
                    </span>
                    {% if regimen_label and regimen_display and regimen_label != regimen_display -%}
                    <span class="tag" style="background: #f3e8ff; color: #6b21a8;">Ontology label: {{ regimen_label }}</span>
                    {% endif %}
                    {% if regimen_id %}
                    {{ render_curie_link(regimen_id) }}
                    {% endif %}
                    {{ render_descriptor_qualifiers(tx.regimen_term) }}
                    {% endif -%}
                </div>
                {% endif %}
                {% if (tx.treatment_term and tx.treatment_term.located_in) or (tx.regimen_term and tx.regimen_term.located_in) %}
                <div class="item-meta">
                    {% if tx.treatment_term and tx.treatment_term.located_in %}
                    {% set tx_loc = tx.treatment_term.located_in %}
                    {% set tx_loc_id = tx_loc.term.id if tx_loc.term else None %}
                    {% set tx_loc_label = tx_loc.term.label if tx_loc.term else None %}
                    {% set tx_loc_display = tx_loc.preferred_term or tx_loc_label %}
                    <strong style="font-size: 0.8rem; color: #5b21b6;">Located in:</strong>
                    {% set tooltip = term_tooltip(tx_loc, "treatment.location") %}
                    {% set pill_tips.n = pill_tips.n + 1 %}{% set tip_id = "pill-tip-" ~ pill_tips.n %}
                    <span class="tag tag-bio"{% if tooltip %} tabindex="0" aria-describedby="{{ tip_id }}"{% endif %}>{{ tx_loc_display }}{% if tooltip %}<span class="pill-tip" role="tooltip" id="{{ tip_id }}">{{ tooltip }}</span>{% endif %}
                    </span>
                    {% if tx_loc_label and tx_loc_display and tx_loc_label != tx_loc_display %}
                    <span class="tag" style="background: #f5f3ff; color: #6b21a8;">Ontology label: {{ tx_loc_label }}</span>
                    {% endif %}
                    {% if tx_loc_id %}
                    {{ render_curie_link(tx_loc_id) }}
                    {% endif %}
                    {% endif %}
                    {% if tx.regimen_term and tx.regimen_term.located_in %}
                    {% set regimen_loc = tx.regimen_term.located_in %}
                    {% set regimen_loc_id = regimen_loc.term.id if regimen_loc.term else None %}
                    {% set regimen_loc_label = regimen_loc.term.label if regimen_loc.term else None %}
                    {% set regimen_loc_display = regimen_loc.preferred_term or regimen_loc_label %}
                    <strong style="font-size: 0.8rem; color: #5b21b6; margin-left: 12px;">Regimen location:</strong>
                    {% set tooltip = term_tooltip(regimen_loc, "regimen.location") %}
                    {% set pill_tips.n = pill_tips.n + 1 %}{% set tip_id = "pill-tip-" ~ pill_tips.n %}
                    <span class="tag tag-bio"{% if tooltip %} tabindex="0" aria-describedby="{{ tip_id }}"{% endif %}>{{ regimen_loc_display }}{% if tooltip %}<span class="pill-tip" role="tooltip" id="{{ tip_id }}">{{ tooltip }}</span>{% endif %}
                    </span>
                    {% if regimen_loc_label and regimen_loc_display and regimen_loc_label != regimen_loc_display %}
                    <span class="tag" style="background: #f5f3ff; color: #6b21a8;">Ontology label: {{ regimen_loc_label }}</span>
                    {% endif %}
                    {% if regimen_loc_id %}
                    {{ render_curie_link(regimen_loc_id) }}
                    {% endif %}
                    {% endif %}
                </div>
                {% endif %}
                {% if tx.treatment_term and tx.treatment_term.therapeutic_agent %}
                <div class="item-meta">
                    <strong style="font-size: 0.8rem; color: #5b21b6;">Agent:</strong>
                    {% for agent in tx.treatment_term.therapeutic_agent %}
                    {% set tooltip = term_tooltip(agent, "treatment.therapeutic_agent") %}
                    {% set pill_tips.n = pill_tips.n + 1 %}{% set tip_id = "pill-tip-" ~ pill_tips.n %} {% set has_chip = agent.term and agent.term.id %}
                    <span class="tag tag-treatment"{% if tooltip and not has_chip %} tabindex="0" aria-describedby="{{ tip_id }}"{% endif %}>
                        {{ agent.preferred_term or agent.term.label }}
                        {% if has_chip %}
                        {{ render_curie_link(agent.term.id, describedby=tip_id) }}
                        {% endif %}
                        {% if tooltip %}<span class="pill-tip" role="tooltip" id="{{ tip_id }}">{{ tooltip }}</span>{% endif %}
                    </span>
                    {% endfor %}
                </div>
                {% endif %}
                {% if tx.treatment_term and tx.treatment_term.dietary_modifications %}
                <div class="item-meta">
                    <strong style="font-size: 0.8rem; color: #5b21b6;">Diet:</strong>
                    {% for mod in tx.treatment_term.dietary_modifications %}
                    {% if mod.food %}
                    {% set tooltip = term_tooltip(mod.food, "treatment.food") %}
                    {% set pill_tips.n = pill_tips.n + 1 %}{% set tip_id = "pill-tip-" ~ pill_tips.n %} {% set has_chip = mod.food.term and mod.food.term.id %}
                    <span class="tag tag-bio"{% if tooltip and not has_chip %} tabindex="0" aria-describedby="{{ tip_id }}"{% endif %}>
                        {{ mod.action | lower }} {{ mod.food.preferred_term or (mod.food.term.label if mod.food.term else 'food') }}
                        {% if has_chip %}
                        {{ render_curie_link(mod.food.term.id, describedby=tip_id) }}
                        {% endif %}
                        {% if tooltip %}<span class="pill-tip" role="tooltip" id="{{ tip_id }}">{{ tooltip }}</span>{% endif %}
                    </span>
                    {% endif %}
                    {% endfor %}
                </div>
                {% endif %}
                {% if tx.description %}
                <div class="item-desc">{{ tx.description }}</div>
                {% endif %}
                {% if tx.target_mechanisms %}
                <div class="item-meta" style="margin-top: 8px;">
                    <strong style="font-size: 0.8rem; color: #7c3aed;">Mechanism Target:</strong>
                    {% for tm in tx.target_mechanisms %}
                    <div style="margin: 4px 0 4px 12px; font-size: 0.88rem;">
                        <span class="tag" style="background: #f3e8ff; color: #6b21a8; font-size: 0.8rem;">
                            {{ tm.treatment_effect }}
                        </span>
                        <strong style="color: #5b21b6;">{{ tm.target }}</strong>
                        {% if tm.description %}
                        <span style="color: #7c3aed;"> &mdash; {{ tm.description }}</span>
                        {% endif %}
                        {{ render_evidence(tm.evidence) }}
                    </div>
                    {% endfor %}
                </div>
                {% endif %}
                {% if tx.target_phenotypes %}
                <div class="item-meta" style="margin-top: 8px;">
                    <strong style="font-size: 0.8rem; color: #6b21a8;">Target Phenotypes:</strong>
                    {% for pheno in tx.target_phenotypes %}
                    {% set tooltip = term_tooltip(pheno, "treatment.target_phenotype") %}
                    {% set pill_tips.n = pill_tips.n + 1 %}{% set tip_id = "pill-tip-" ~ pill_tips.n %} {% set has_chip = pheno.term and pheno.term.id %}
                    <span class="tag" style="background: #ede9fe; color: #6b21a8; font-size: 0.8rem;"{% if tooltip and not has_chip %} tabindex="0" aria-describedby="{{ tip_id }}"{% endif %}>
                        {{ pheno.preferred_term or pheno.term.label }}
                        {% if has_chip %}
                        {{ render_curie_link(pheno.term.id, describedby=tip_id) }}
                        {% endif %}
                        {% if tooltip %}<span class="pill-tip" role="tooltip" id="{{ tip_id }}">{{ tooltip }}</span>{% endif %}
                    </span>
                    {% endfor %}
                </div>
                {% endif %}
                {% if tx.pdb_structures %}
                <div class="item-meta" style="margin-top: 8px;">
                    <strong style="font-size: 0.8rem; color: #5b21b6;">🔬 3D Structures:</strong>
                    {% for struct in tx.pdb_structures %}
                    <div style="margin: 8px 0 8px 12px;">
                        <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 4px;">
                            <span class="tag" style="background: #dbeafe; color: #1e40af; font-size: 0.8rem; font-weight: 600;">
                                {{ struct.pdb_id }}
                            </span>
                            {% if struct.method %}
                            <span style="font-size: 0.75rem; color: #6b7280;">{{ struct.method }}</span>
                            {% endif %}
                            {% if struct.resolution_angstrom %}
                            <span style="font-size: 0.75rem; color: #6b7280;">{{ struct.resolution_angstrom }} Å</span>
                            {% endif %}
                            {% if struct.ligand %}
                            <span class="tag" style="background: #fef3c7; color: #92400e; font-size: 0.75rem;">
                                ⚗️ {{ struct.ligand }}
                            </span>
                            {% endif %}
                        </div>
                        {% if struct.description %}
                        <div style="font-size: 0.85rem; color: #4b5563; margin-bottom: 6px;">{{ struct.description }}</div>
                        {% endif %}
                        {% if struct.pdb_id[:2] == 'AF' %}
                        {# AF-P02766-F1 → P02766 (strip AF- prefix and -F1/-F2 suffix) #}
                        {% set af_parts = struct.pdb_id.split('-') %}
                        {% set af_uniprot = af_parts[1] if af_parts | length >= 2 else struct.pdb_id %}
                        <div class="molstar-viewer" style="border: 1px solid #e5e7eb; border-radius: 8px; overflow: hidden; margin-bottom: 4px;">
                            <iframe
                                src="https://alphafold.ebi.ac.uk/entry/{{ af_uniprot }}"
                                style="width: 100%; height: 320px; border: none;"
                                loading="lazy"
                                title="AlphaFold structure {{ struct.pdb_id }}"
                            ></iframe>
                        </div>
                        {% else %}
                        <div class="molstar-viewer" style="border: 1px solid #e5e7eb; border-radius: 8px; overflow: hidden; margin-bottom: 4px;">
                            <iframe
                                src="https://www.rcsb.org/3d-view/{{ struct.pdb_id }}"
                                style="width: 100%; height: 320px; border: none;"
                                loading="lazy"
                                title="3D structure {{ struct.pdb_id }}"
                            ></iframe>
                        </div>
                        {% endif %}
                    </div>
                    {% endfor %}
                </div>
                {% endif %}
                {{ render_evidence(tx.evidence) }}
            </div>
            {% endfor %}
        </div>
        {% endif %}

        <!-- Environmental Factors -->
        {% if disorder.environmental %}
        <div class="card">
            <div class="card-header">
                <div class="card-icon" style="background: #ccfbf1; color: #0d9488;">🌍</div>
                <h2 class="card-title">Environmental Factors</h2>
                <span class="card-count">{{ disorder.environmental | length }}</span>
            </div>
            {% for env in disorder.environmental %}
            <div class="item-box environmental-box anchor-target"{% if env._anchor_id %} id="{{ env._anchor_id }}"{% endif %} data-dismech-node="{{ env.name | e }}" data-dismech-type="environmental">
                <div class="item-name">{{ env.name }}</div>
                {% if env.exposure_term or env.environment_context or env.food_source %}
                <div class="tag-list" style="margin: 10px 0 8px 0;">
                    {% if env.exposure_term %}
                    {% set tooltip = term_tooltip(env.exposure_term, "environment.exposure_term") %}
                    {% set pill_tips.n = pill_tips.n + 1 %}{% set tip_id = "pill-tip-" ~ pill_tips.n %} {% set has_chip = env.exposure_term.term and env.exposure_term.term.id %}
                    <span class="tag tag-env"{% if tooltip and not has_chip %} tabindex="0" aria-describedby="{{ tip_id }}"{% endif %}>
                        {{ env.exposure_term.preferred_term or (env.exposure_term.term.label if env.exposure_term.term else 'Exposure term') }}
                        {% if has_chip %}
                        {{ render_curie_link(env.exposure_term.term.id, describedby=tip_id) }}
                        {% endif %}
                        {% if tooltip %}<span class="pill-tip" role="tooltip" id="{{ tip_id }}">{{ tooltip }}</span>{% endif %}
                    </span>
                    {% endif %}
                    {% if env.environment_context %}
                    {% set tooltip = term_tooltip(env.environment_context, "environment.environment_context") %}
                    {% set pill_tips.n = pill_tips.n + 1 %}{% set tip_id = "pill-tip-" ~ pill_tips.n %} {% set has_chip = env.environment_context.term and env.environment_context.term.id %}
                    <span class="tag tag-location"{% if tooltip and not has_chip %} tabindex="0" aria-describedby="{{ tip_id }}"{% endif %}>
                        {{ env.environment_context.preferred_term or (env.environment_context.term.label if env.environment_context.term else 'Environment context') }}
                        {% if has_chip %}
                        {{ render_curie_link(env.environment_context.term.id, describedby=tip_id) }}
                        {% endif %}
                        {% if tooltip %}<span class="pill-tip" role="tooltip" id="{{ tip_id }}">{{ tooltip }}</span>{% endif %}
                    </span>
                    {% endif %}
                    {% if env.food_source %}
                    {% set tooltip = term_tooltip(env.food_source, "environment.food_source") %}
                    {% set pill_tips.n = pill_tips.n + 1 %}{% set tip_id = "pill-tip-" ~ pill_tips.n %} {% set has_chip = env.food_source.term and env.food_source.term.id %}
                    <span class="tag tag-bio"{% if tooltip and not has_chip %} tabindex="0" aria-describedby="{{ tip_id }}"{% endif %}>
                        {{ env.food_source.preferred_term or (env.food_source.term.label if env.food_source.term else 'Food source') }}
                        {% if has_chip %}
                        {{ render_curie_link(env.food_source.term.id, describedby=tip_id) }}
                        {% endif %}
                        {% if tooltip %}<span class="pill-tip" role="tooltip" id="{{ tip_id }}">{{ tooltip }}</span>{% endif %}
                    </span>
                    {% endif %}
                </div>
                {% endif %}
                {# Exposure/agent-level classifications: hazard type, route, duration, IARC group, #}
                {# GHS class, exposome domain. These classify the AGENT, not the disease, which is #}
                {# why they render on the exposure card rather than in the Classifications card. #}
                {% if env.exposure_classifications %}
                {% set exposure_axes = [
                    ("Hazard type", env.exposure_classifications.hazard_agent_type),
                    ("Route", env.exposure_classifications.exposure_route),
                    ("Duration", env.exposure_classifications.exposure_duration),
                    ("IARC group", env.exposure_classifications.iarc_carcinogen_group),
                    ("GHS hazard class", env.exposure_classifications.ghs_health_hazard_class),
                    ("Exposome domain", env.exposure_classifications.exposome_domain)
                ] %}
                <div class="item-meta" style="margin-top: 8px;">
                    {% for axis_label, axis_value in exposure_axes %}
                    {% if axis_value %}
                    {% set axis_items = axis_value if axis_value is sequence and axis_value is not mapping else [axis_value] %}
                    <div style="margin: 4px 0; font-size: 0.85rem;">
                        <strong style="font-size: 0.8rem; color: #0f766e;">{{ axis_label }}:</strong>
                        {% for assignment in axis_items %}
                        <span class="tag tag-classification"{% if assignment.notes %} title="{{ assignment.notes }}"{% endif %}>{{ assignment.classification_value | replace('_', ' ') }}</span>
                        {% endfor %}
                    </div>
                    {% endif %}
                    {% endfor %}
                </div>
                {% endif %}
                {% if env.notes %}
                <div class="item-desc">{{ env.notes }}</div>
                {% endif %}
                {% if env.description %}
                <div class="item-desc">{{ env.description }}</div>
                {% endif %}
                {{ render_evidence(env.evidence) }}
                {% if env.influences_mechanisms %}
                <div class="item-meta" style="margin-top: 8px;">
                    <strong style="font-size: 0.8rem; color: #0f766e;">Mechanism Target:</strong>
                    {% for link in env.influences_mechanisms %}
                    <div style="margin: 4px 0 4px 12px; font-size: 0.88rem;">
                        {% if link.environmental_effect %}
                        <span class="tag" style="background: #ccfbf1; color: #115e59; font-size: 0.8rem;">
                            {{ link.environmental_effect }}
                        </span>
                        {% endif %}
                        <strong style="color: #115e59;">{{ link.target }}</strong>
                        {% if link.description %}
                        <span style="color: #0d9488;"> &mdash; {{ link.description }}</span>
                        {% endif %}
                        {{ render_evidence(link.evidence) }}
                    </div>
                    {% endfor %}
                </div>
                {% endif %}
            </div>
            {% endfor %}
        </div>
        {% endif %}

        <!-- Biochemical Markers -->
        {% if disorder.biochemical %}
        <div class="card">
            <div class="card-header">
                <div class="card-icon" style="background: #fef3c7; color: #d97706;">🔬</div>
                <h2 class="card-title">Biochemical Markers</h2>
                <span class="card-count">{{ disorder.biochemical | length }}</span>
            </div>
            {% for bio in disorder.biochemical %}
            <div class="item-box biochemical-box anchor-target"{% if bio._anchor_id %} id="{{ bio._anchor_id }}"{% endif %} data-dismech-node="{{ bio.name | e }}" data-dismech-type="biochemical">
                <div class="item-name">
                    {{ bio.name }}
                    {% if bio.presence %}
                    <span style="font-size: 0.8rem; font-weight: normal; opacity: 0.8;">({{ bio.presence }})</span>
                    {% endif %}
                </div>
                {% if bio.context %}
                <div class="item-desc">Context: {{ bio.context }}</div>
                {% endif %}
                {% if bio.readouts %}
                <div class="biomarker-readouts">
                    <div class="biomarker-readouts-title">Pathograph Readouts</div>
                    {% for readout in bio.readouts %}
                    <div class="biomarker-readout">
                        <span class="tag" style="background: #e0e7ff; color: #3730a3; font-size: 0.78rem;">
                            {{ readout.relationship | replace('_', ' ') | title }}
                        </span>
                        <span class="readout-target">{{ readout.target }}</span>
                        {% if readout.direction %}
                        <span class="tag" style="background: #fef3c7; color: #92400e; font-size: 0.78rem;">
                            {{ readout.direction | replace('_', ' ') | title }}
                        </span>
                        {% endif %}
                        {% if readout.endpoint_context %}
                        <span class="tag" style="background: #f1f5f9; color: #475569; font-size: 0.78rem;">
                            {{ readout.endpoint_context | replace('_', ' ') | title }}
                        </span>
                        {% endif %}
                        {% if readout.interpretation %}
                        <div class="readout-interpretation">{{ readout.interpretation }}</div>
                        {% elif readout.description %}
                        <div class="readout-interpretation">{{ readout.description }}</div>
                        {% endif %}
                        {% if readout.get('_regulatory_endpoints') %}
                        <div class="regulatory-endpoints">
                            {% for endpoint in readout.get('_regulatory_endpoints') %}
                            <div class="regulatory-endpoint">
                                <div>
                                    {% if endpoint.source_url %}
                                    <a class="regulatory-endpoint-id" href="{{ endpoint.source_url }}" target="_blank" rel="noopener">{{ endpoint.row_id }}</a>
                                    {% else %}
                                    <span class="regulatory-endpoint-id">{{ endpoint.row_id }}</span>
                                    {% endif %}
                                    <span class="tag" style="background: #dbeafe; color: #1d4ed8; font-size: 0.72rem;">FDA</span>
                                </div>
                                <div class="regulatory-endpoint-title">{{ endpoint.surrogate_endpoint }}</div>
                                <div class="regulatory-endpoint-meta">
                                    {% if endpoint.approval_type %}
                                    <span class="tag" style="background: #e0e7ff; color: #3730a3; font-size: 0.72rem;">
                                        {{ endpoint.approval_type | replace('_', ' ') | title }}
                                    </span>
                                    {% endif %}
                                    {% if endpoint.endpoint_validation_level %}
                                    <span class="tag" style="background: #dcfce7; color: #166534; font-size: 0.72rem;">
                                        {{ endpoint.endpoint_validation_level | replace('_', ' ') | title }}
                                    </span>
                                    {% endif %}
                                </div>
                                {% if endpoint.patient_population %}
                                <div style="margin-top: 5px; color: #4f46e5;">{{ endpoint.patient_population }}</div>
                                {% endif %}
                            </div>
                            {% endfor %}
                        </div>
                        {% endif %}
                        {% if readout.get('_missing_regulatory_endpoint_refs') %}
                        <div class="item-desc">
                            Missing regulatory endpoint refs:
                            {{ readout.get('_missing_regulatory_endpoint_refs') | join(', ') }}
                        </div>
                        {% endif %}
                        {{ render_evidence(readout.evidence) }}
                    </div>
                    {% endfor %}
                </div>
                {% endif %}
                {% if bio.reference_ranges %}
                <div class="reference-ranges">
                    <div class="reference-ranges-title">Reference Ranges</div>
                    {% for rr in bio.reference_ranges %}
                    <div class="reference-range">
                        {% if rr.loinc_term and rr.loinc_term.id %}
                        <a href="{{ rr.loinc_term.id | curie_to_url }}" target="_blank" rel="noopener" class="readout-target">{{ rr.loinc_term.label or rr.loinc_term.id }}</a>
                        {% endif %}
                        <span class="reference-range-interval">
                            {% if rr.lower_bound is not none and rr.upper_bound is not none %}
                            {{ rr.lower_bound }}–{{ rr.upper_bound }}{% if rr.unit %} {{ rr.unit }}{% endif %}
                            {% elif rr.upper_bound is not none %}
                            ≤ {{ rr.upper_bound }}{% if rr.unit %} {{ rr.unit }}{% endif %}
                            {% elif rr.lower_bound is not none %}
                            ≥ {{ rr.lower_bound }}{% if rr.unit %} {{ rr.unit }}{% endif %}
                            {% endif %}
                        </span>
                        {% if rr.population %}
                        <span class="reference-range-meta">({{ rr.population }})</span>
                        {% endif %}
                        {% if rr.interpretation_bands %}
                        <div class="reference-range-bands">
                            {% for band in rr.interpretation_bands %}
                            {% set flag = (band.abnormal_flag or '') | upper %}
                            {% set sev = (band.severity or '') | string | lower %}
                            {% if flag in ('CRITICAL_LOW', 'CRITICAL_HIGH') or sev == 'severe' %}
                            {% set band_class = 'severity-severe' %}
                            {% elif sev == 'moderate' %}
                            {% set band_class = 'severity-moderate' %}
                            {% elif sev == 'mild' %}
                            {% set band_class = 'severity-mild' %}
                            {% elif flag in ('LOW', 'HIGH') %}
                            {% set band_class = 'severity-moderate' %}
                            {% else %}
                            {% set band_class = 'severity-other' %}
                            {% endif %}
                            {% set band_unit = band.unit or rr.unit %}
                            <span class="severity-pill {{ band_class }}">
                                {{ band.name }}
                                {% if band.lower_bound is not none and band.upper_bound is not none %}
                                ({{ band.lower_bound }}–{{ band.upper_bound }}{% if band_unit %} {{ band_unit }}{% endif %})
                                {% elif band.upper_bound is not none %}
                                (&lt; {{ band.upper_bound }}{% if band_unit %} {{ band_unit }}{% endif %})
                                {% elif band.lower_bound is not none %}
                                (≥ {{ band.lower_bound }}{% if band_unit %} {{ band_unit }}{% endif %})
                                {% endif %}
                                {% if band.phenotype_term and band.phenotype_term.term and band.phenotype_term.term.id %}
                                <a href="{{ band.phenotype_term.term.id | curie_to_url }}" target="_blank" rel="noopener" style="color: inherit; text-decoration: underline;" title="Mapped HP phenotype">→ {{ band.phenotype_term.term.label or band.phenotype_term.preferred_term }}</a>
                                {% endif %}
                            </span>
                            {% endfor %}
                        </div>
                        {% for band in rr.interpretation_bands %}
                        {% if band.interpretation %}
                        <div class="reference-range-band-interp"><strong>{{ band.name }}:</strong> {{ band.interpretation }}</div>
                        {% endif %}
                        {% endfor %}
                        {% endif %}
                        {% if rr.notes %}
                        <div class="reference-range-meta">{{ rr.notes }}</div>
                        {% endif %}
                        {{ render_evidence(rr.evidence) }}
                    </div>
                    {% endfor %}
                </div>
                {% endif %}
                {{ render_evidence(bio.evidence) }}
            </div>
            {% endfor %}
        </div>
        {% endif %}

        <!-- Diagnosis -->
        {% if disorder.diagnosis %}
        <div class="card" id="diagnosis">
            <div class="card-header">
                <div class="card-icon" style="background: #e0f2fe; color: #0369a1;">🔬</div>
                <h2 class="card-title">Diagnosis</h2>
                <span class="card-count">{{ disorder.diagnosis | length }}</span>
            </div>
            {% for dx in disorder.diagnosis %}
            <div class="item-box anchor-target"{% if dx._anchor_id %} id="{{ dx._anchor_id }}"{% endif %}>
                <div class="item-name">
                    {{ dx.name }}
                    {% if dx.presence %}
                    <span style="font-size: 0.8rem; font-weight: normal; opacity: 0.8;">({{ dx.presence }})</span>
                    {% endif %}
                </div>
                {% if dx.description %}
                <div class="item-desc">{{ dx.description }}</div>
                {% endif %}
                {{ render_descriptor_tag(dx.diagnosis_term, "tag-treatment") }}
                {# `markers` is `range: string` and not multivalued -- passing it to
                   render_descriptor_tags iterates it per character and renders
                   nothing. Text, like the sibling `results` slot. #}
                {% if dx.markers %}
                <div class="item-desc"><strong>Markers:</strong> {{ dx.markers }}</div>
                {% endif %}
                {% if dx.results %}
                <div class="item-desc"><strong>Results:</strong> {{ dx.results }}</div>
                {% endif %}
                {% if dx.notes %}
                <div class="item-notes">{{ dx.notes }}</div>
                {% endif %}
                {{ render_evidence(dx.evidence) }}
            </div>
            {% endfor %}
        </div>
        {% endif %}

        <!-- Imaging Findings -->
        {% if disorder.imaging_findings %}
        <div class="card" id="imaging-findings">
            <div class="card-header">
                <div class="card-icon" style="background: #ede9fe; color: #6d28d9;">🩻</div>
                <h2 class="card-title">Imaging Findings</h2>
                <span class="card-count">{{ disorder.imaging_findings | length }}</span>
            </div>
            {% for finding in disorder.imaging_findings %}
            <div class="item-box anchor-target"{% if finding._anchor_id %} id="{{ finding._anchor_id }}"{% endif %}>
                <div class="item-name">
                    {{ finding.name }}
                    {% if finding.frequency %}
                    <span class="histopathology-freq">{{ finding.frequency }}</span>
                    {% endif %}
                </div>
                {% if finding.description %}
                <div class="item-desc">{{ finding.description }}</div>
                {% endif %}
                <div class="item-meta">
                    {% if finding.modality %}
                    <span class="tag tag-classification">{{ finding.modality | replace('_', ' ') | title }}</span>
                    {% endif %}
                    {% if finding.diagnostic %}
                    <span class="tag" style="background: #dcfce7; color: #166534;">Diagnostic</span>
                    {% endif %}
                    {% if finding.laterality %}
                    <span class="tag">{{ finding.laterality | replace('_', ' ') | title }}</span>
                    {% endif %}
                    {% if finding.spatial_extent %}
                    <span class="tag">{{ finding.spatial_extent | replace('_', ' ') | title }}</span>
                    {% endif %}
                    {% if finding.subtype %}
                    <span class="tag tag-subtype">{{ finding.subtype }}</span>
                    {% endif %}
                    {% if finding.context %}
                    <span class="tag">{{ finding.context }}</span>
                    {% endif %}
                </div>
                {{ render_descriptor_tag(finding.imaging_finding_term, "tag-bio") }}
                {{ render_descriptor_tag(finding.located_in, "tag-anatomy") }}
                {{ render_descriptor_tag(finding.phenotype_term, "tag-phenotype") }}
                {% if finding.notes %}
                <div class="item-notes">{{ finding.notes }}</div>
                {% endif %}
                {{ render_evidence(finding.evidence) }}
            </div>
            {% endfor %}
        </div>
        {% endif %}

        <!-- Progression -->
        {% if disorder.progression %}
        <div class="card" id="progression">
            <div class="card-header">
                <div class="card-icon" style="background: #fef3c7; color: #b45309;">📈</div>
                <h2 class="card-title">Progression</h2>
                <span class="card-count">{{ disorder.progression | length }}</span>
            </div>
            {% for phase in disorder.progression %}
            <div class="item-box anchor-target"{% if phase._anchor_id %} id="{{ phase._anchor_id }}"{% endif %}>
                <div class="item-name">{{ phase.phase }}</div>
                <div class="item-meta">
                    {% if phase.subtype %}
                    <span class="tag tag-subtype">{{ phase.subtype }}</span>
                    {% endif %}
                    {% if phase.age_range %}
                    <span class="tag">Age: {{ phase.age_range }}</span>
                    {% endif %}
                    {% if phase.duration %}
                    <span class="tag">Duration: {{ phase.duration }}</span>
                    {% elif phase.duration_days %}
                    <span class="tag">Duration: {{ phase.duration_days }} days</span>
                    {% endif %}
                    {% if phase.incubation_days %}
                    <span class="tag">Incubation: {{ phase.incubation_days }} days</span>
                    {% elif phase.incubation_years %}
                    <span class="tag">Incubation: {{ phase.incubation_years }} years</span>
                    {% endif %}
                </div>
                {% if phase.notes %}
                <div class="item-notes">{{ phase.notes }}</div>
                {% endif %}
                {{ render_evidence(phase.evidence) }}
            </div>
            {% endfor %}
        </div>
        {% endif %}

        <!-- Stages -->
        {% if disorder.stages %}
        <div class="card" id="stages">
            <div class="card-header">
                <div class="card-icon" style="background: #fef3c7; color: #b45309;">🪜</div>
                <h2 class="card-title">Stages</h2>
                <span class="card-count">{{ disorder.stages | length }}</span>
            </div>
            {% for stage in disorder.stages %}
            <div class="item-box anchor-target"{% if stage._anchor_id %} id="{{ stage._anchor_id }}"{% endif %}>
                <div class="item-name">{{ stage.name }}</div>
                {% if stage.description %}
                <div class="item-desc">{{ stage.description }}</div>
                {% endif %}
                {% if stage.role %}
                <div class="item-meta"><span class="tag tag-classification">{{ stage.role }}</span></div>
                {% endif %}
                {% if stage.substages %}
                <div class="item-meta">
                    {% for substage in stage.substages %}
                    {# Guarded rather than `substage.name or substage`, which prints
                       a raw dict for a nameless entry -- the shape of the
                       food_source bug found in review of this PR. #}
                    {% if substage is string %}
                    <span class="tag">{{ substage }}</span>
                    {% elif substage.name %}
                    <span class="tag">{{ substage.name }}</span>
                    {% endif %}
                    {% endfor %}
                </div>
                {% endif %}
                {% if stage.pathophysiology %}
                <div class="item-meta">
                    {% for node in stage.pathophysiology %}
                    {% if node.name %}
                    <span class="tag tag-bio">{{ node.name }}</span>
                    {% endif %}
                    {% endfor %}
                </div>
                {% endif %}
                {% if stage.notes %}
                <div class="item-notes">{{ stage.notes }}</div>
                {% endif %}
                {{ render_evidence(stage.evidence) }}
            </div>
            {% endfor %}
        </div>
        {% endif %}

        <!-- Prevalence -->
        {% if disorder.prevalence %}
        <div class="card" id="prevalence">
            <div class="card-header">
                <div class="card-icon" style="background: #dcfce7; color: #15803d;">📊</div>
                <h2 class="card-title">Prevalence</h2>
                <span class="card-count">{{ disorder.prevalence | length }}</span>
            </div>
            {% for rec in disorder.prevalence %}
            <div class="item-box anchor-target"{% if rec._anchor_id %} id="{{ rec._anchor_id }}"{% endif %}>
                <div class="item-name">{{ rec.population or 'Unspecified population' }}</div>
                <div class="item-meta">
                    {% if rec.measure_type %}
                    <span class="tag tag-classification">{{ rec.measure_type | replace('_', ' ') | title }}</span>
                    {% endif %}
                    {# `.get()` rather than `rec.rate_per_100000 is not none`: a
                       missing key is Jinja's Undefined, which *passes* an
                       `is not none` test and renders an empty number while
                       suppressing the percentage fallback below. #}
                    {% if rec.get('rate_per_100000') is not none %}
                    <span class="tag" style="background: #dcfce7; color: #166534;">
                        {{ rec.rate_per_100000 }} per 100,000
                        {%- if rec.get('rate_low') is not none and rec.get('rate_high') is not none %}
                        ({{ rec.rate_low }}&ndash;{{ rec.rate_high }})
                        {%- endif %}
                    </span>
                    {# 273 records carry a range and no point rate, so this has to
                       be a sibling branch rather than nested in the one above. #}
                    {% elif rec.get('rate_low') is not none or rec.get('rate_high') is not none %}
                    <span class="tag" style="background: #dcfce7; color: #166534;">
                        {%- if rec.get('rate_low') is not none and rec.get('rate_high') is not none -%}
                        {{ rec.rate_low }}&ndash;{{ rec.rate_high }}
                        {%- elif rec.get('rate_low') is not none -%}
                        &ge;{{ rec.rate_low }}
                        {%- else -%}
                        &le;{{ rec.rate_high }}
                        {%- endif %} per 100,000
                    </span>
                    {% elif rec.percentage %}
                    <span class="tag">{{ rec.percentage }}</span>
                    {% endif %}
                    {{ render_prevalence_class(rec.prevalence_class) }}
                    {% if rec.subtype %}
                    <span class="tag tag-subtype">{{ rec.subtype }}</span>
                    {% endif %}
                </div>
                {% if rec.notes %}
                <div class="item-notes">{{ rec.notes }}</div>
                {% endif %}
                {{ render_evidence(rec.evidence) }}
            </div>
            {% endfor %}
        </div>
        {% endif %}

        <!-- Epidemiology -->
        {% if disorder.epidemiology %}
        <div class="card" id="epidemiology">
            <div class="card-header">
                <div class="card-icon" style="background: #dcfce7; color: #15803d;">🌍</div>
                <h2 class="card-title">Epidemiology</h2>
                <span class="card-count">{{ disorder.epidemiology | length }}</span>
            </div>
            {% for epi in disorder.epidemiology %}
            <div class="item-box anchor-target"{% if epi._anchor_id %} id="{{ epi._anchor_id }}"{% endif %}>
                <div class="item-name">{{ epi.name }}</div>
                {% if epi.description %}
                <div class="item-desc">{{ epi.description }}</div>
                {% endif %}
                <div class="item-meta">
                    {% if epi.mean_range %}
                    <span class="tag">{{ epi.mean_range }}{% if epi.unit %} {{ epi.unit }}{% endif %}</span>
                    {% elif epi.get('minimum_value') is not none or epi.get('maximum_value') is not none %}
                    <span class="tag">
                        {{ epi.minimum_value if epi.get('minimum_value') is not none else '?' }}&ndash;{{ epi.maximum_value if epi.get('maximum_value') is not none else '?' }}
                        {%- if epi.unit %} {{ epi.unit }}{% endif %}
                    </span>
                    {% endif %}
                    {% for factor in epi.factors or [] %}
                    <span class="tag">{{ factor }}</span>
                    {% endfor %}
                </div>
                {% if epi.notes %}
                <div class="item-notes">{{ epi.notes }}</div>
                {% endif %}
                {{ render_evidence(epi.evidence) }}
            </div>
            {% endfor %}
        </div>
        {% endif %}

        <!-- Infectious Agent -->
        {% if disorder.infectious_agent %}
        <div class="card" id="infectious-agent">
            <div class="card-header">
                <div class="card-icon" style="background: #fee2e2; color: #b91c1c;">🦠</div>
                <h2 class="card-title">Infectious Agent</h2>
                <span class="card-count">{{ disorder.infectious_agent | length }}</span>
            </div>
            {% for agent in disorder.infectious_agent %}
            <div class="item-box anchor-target"{% if agent._anchor_id %} id="{{ agent._anchor_id }}"{% endif %}>
                <div class="item-name">{{ agent.name }}</div>
                {% if agent.description %}
                <div class="item-desc">{{ agent.description }}</div>
                {% endif %}
                {{ render_descriptor_tag(agent.infectious_agent_term, "tag-bio") }}
                {% if agent.has_subtypes %}
                <div class="item-meta">
                    {% for sub in agent.has_subtypes %}
                    {% if sub is string %}
                    <span class="tag tag-subtype">{{ sub }}</span>
                    {% elif sub.name %}
                    <span class="tag tag-subtype">{{ sub.name }}</span>
                    {% endif %}
                    {% endfor %}
                </div>
                {% endif %}
                {% if agent.food_source %}
                <div class="item-desc"><strong>Food source:</strong></div>
                {{ render_descriptor_tag(agent.food_source, "tag-bio") }}
                {% endif %}
                {{ render_evidence(agent.evidence) }}
            </div>
            {% endfor %}
        </div>
        {% endif %}

        <!-- Transmission -->
        {% if disorder.transmission %}
        <div class="card" id="transmission">
            <div class="card-header">
                <div class="card-icon" style="background: #fee2e2; color: #b91c1c;">↔️</div>
                <h2 class="card-title">Transmission</h2>
                <span class="card-count">{{ disorder.transmission | length }}</span>
            </div>
            {% for route in disorder.transmission %}
            <div class="item-box anchor-target"{% if route._anchor_id %} id="{{ route._anchor_id }}"{% endif %}>
                <div class="item-name">{{ route.name }}</div>
                {% if route.description %}
                <div class="item-desc">{{ route.description }}</div>
                {% endif %}
                {% if route.effect %}
                <div class="item-meta"><span class="tag">{{ route.effect }}</span></div>
                {% endif %}
                {% if route.notes %}
                <div class="item-notes">{{ route.notes }}</div>
                {% endif %}
                {{ render_evidence(route.evidence) }}
            </div>
            {% endfor %}
        </div>
        {% endif %}

        <!-- Clinical Burden -->
        {% if disorder.clinical_burden %}
        <div class="card" id="clinical-burden">
            <div class="card-header">
                <div class="card-icon" style="background: #ffe4e6; color: #be123c;">⚖️</div>
                <h2 class="card-title">Clinical Burden</h2>
            </div>
            <div class="item-box anchor-target">
                {% if disorder.clinical_burden.burden_level %}
                <div class="item-name">{{ disorder.clinical_burden.burden_level | replace('_', ' ') | title }}</div>
                {% endif %}
                {% if disorder.clinical_burden.rationale %}
                <div class="item-desc">{{ disorder.clinical_burden.rationale }}</div>
                {% endif %}
                {% if disorder.clinical_burden.notes %}
                <div class="item-notes">{{ disorder.clinical_burden.notes }}</div>
                {% endif %}
                {{ render_evidence(disorder.clinical_burden.evidence) }}
            </div>
        </div>
        {% endif %}

        <!-- Differential Diagnoses -->
        {% if disorder.differential_diagnoses %}
        <div class="card" id="differentials">
            <div class="card-header">
                <div class="card-icon" style="background: #fef2f2; color: #dc2626;">🔀</div>
                <h2 class="card-title">Differential Diagnoses</h2>
                <span class="card-count">{{ disorder.differential_diagnoses | length }}</span>
            </div>
            <p style="margin-bottom: 16px; font-size: 0.95rem; color: var(--text-muted);">
                Conditions with similar clinical presentations that must be differentiated from {{ disorder.name }}:
            </p>
            {% for diff in disorder.differential_diagnoses %}
            {% set diff_term_id = diff.disease_term.term.id if diff.disease_term and diff.disease_term.term and diff.disease_term.term.id else None %}
            {% set diff_has_local_page = (diff_term_id | has_local_disorder_page) if diff_term_id else False %}
            <div class="item-box differential-box anchor-target"{% if diff._anchor_id %} id="{{ diff._anchor_id }}"{% endif %}>
                <div class="item-name">
                    {% if diff.dismech_page_href %}
                    <a class="item-name-link" href="{{ diff.dismech_page_href }}">{{ diff.name }}</a>
                    {% elif diff_term_id and not diff_has_local_page %}
                    <span class="missing-disease-name" title="No DisMech page yet for this disease">{{ diff.name }}</span>
                    <span class="curation-gap-badge">Not Yet Curated</span>
                    {% else %}
                    {{ diff.name }}
                    {% endif %}
                    {% if diff_term_id %}
                    <span class="phenotype-id">
                        <a href="{{ diff_term_id | curie_to_url }}" target="_blank"{% if not diff_has_local_page %} class="missing-ontology-link"{% endif %}>
                            {{ diff_term_id }}
                        </a>
                    </span>
                    {% endif %}
                </div>
                {% if diff.description %}
                <div class="differential-similarities">
                    <strong>Overlapping Features</strong>
                    {{ diff.description }}
                </div>
                {% endif %}
                {% if diff.distinguishing_features %}
                <div class="differential-distinctions">
                    <strong>Distinguishing Features</strong>
                    {% if diff.distinguishing_features is string %}
                    {{ diff.distinguishing_features }}
                    {% else %}
                    <ul>
                        {% for feature in diff.distinguishing_features %}
                        <li>{{ feature }}</li>
                        {% endfor %}
                    </ul>
                    {% endif %}
                </div>
                {% endif %}
                {{ render_evidence(diff.evidence) }}
            </div>
            {% endfor %}
        </div>
        {% endif %}

        <!-- Datasets -->
        {% if disorder.datasets %}
        <div class="card" id="datasets">
            <div class="card-header">
                <div class="card-icon" style="background: #e0f2fe; color: #0284c7;">📊</div>
                <h2 class="card-title">Related Datasets</h2>
                <span class="card-count">{{ disorder.datasets | length }}</span>
            </div>
            {% for ds in disorder.datasets %}
            <div class="item-box dataset-box anchor-target"{% if ds._anchor_id %} id="{{ ds._anchor_id }}"{% endif %}>
                <div class="item-name">
                    {{ ds.title }}
                    {% if ds.accession %}
                    <span class="dataset-accession">
                        <a href="{{ ds.accession | curie_to_url }}" target="_blank">{{ ds.accession }}</a>
                    </span>
                    {% endif %}
                </div>
                {% if ds.description %}
                <div class="item-desc">{{ ds.description }}</div>
                {% endif %}
                <div class="item-meta">
                    {% if ds.organism and ds.organism.preferred_term %}
                    <span class="tag tag-organism">{{ ds.organism.preferred_term }}</span>
                    {% endif %}
                    {% if ds.data_type %}
                    <span class="tag tag-datatype">{{ ds.data_type | replace('_', ' ') }}</span>
                    {% endif %}
                    {% if ds.sample_count %}
                    <span class="tag tag-dataset">n={{ ds.sample_count }}</span>
                    {% endif %}
                    {% if ds.platform %}
                    <span class="tag" style="background: #f1f5f9; color: #475569;">{{ ds.platform | truncate(40) }}</span>
                    {% endif %}
                </div>
                {% if ds.sample_types %}
                <div class="item-meta" style="margin-top: 6px;">
                    {% for st in ds.sample_types %}
                    {# A sample type may bind its cell type, its own term, or its
                       tissue; the chip and the tooltip both come off the same
                       chosen binding so they cannot name different CURIEs. #}
                    {% set sample = sample_type_descriptor(st) %}
                    {% set tooltip = term_tooltip(sample, "dataset.sample_types") %}
                    {% set pill_tips.n = pill_tips.n + 1 %}{% set tip_id = "pill-tip-" ~ pill_tips.n %} {% set has_chip = sample.term and sample.term.id %}
                    <span class="tag tag-cell"{% if tooltip and not has_chip %} tabindex="0" aria-describedby="{{ tip_id }}"{% endif %}>
                        {{ st.preferred_term }}
                        {% if has_chip %}
                        {{ render_curie_link(sample.term.id, describedby=tip_id) }}
                        {% endif %}
                        {% if tooltip %}<span class="pill-tip" role="tooltip" id="{{ tip_id }}">{{ tooltip }}</span>{% endif %}
                    </span>
                    {% endfor %}
                </div>
                {% endif %}
                {% if ds.conditions %}
                <div class="item-meta" style="margin-top: 6px;">
                    <strong style="font-size: 0.8rem; color: #0369a1;">Conditions:</strong>
                    {% for cond in ds.conditions %}
                    <span class="tag" style="background: #f0f9ff; color: #0369a1; font-size: 0.8rem;">{{ cond }}</span>
                    {% endfor %}
                </div>
                {% endif %}
                {% if ds.exposures %}
                <div class="item-meta" style="margin-top: 6px;">
                    <strong style="font-size: 0.8rem; color: #0d9488;">Exposures:</strong>
                    {% for exp in ds.exposures %}
                    {% set tooltip = term_tooltip(exp, "dataset.exposures") %}
                    {% set pill_tips.n = pill_tips.n + 1 %}{% set tip_id = "pill-tip-" ~ pill_tips.n %} {% set has_chip = exp.term and exp.term.id %}
                    <span class="tag tag-env"{% if tooltip and not has_chip %} tabindex="0" aria-describedby="{{ tip_id }}"{% endif %}>
                        {{ exp.preferred_term }}
                        {% if has_chip %}
                        {{ render_curie_link(exp.term.id, describedby=tip_id) }}
                        {% endif %}
                        {% if tooltip %}<span class="pill-tip" role="tooltip" id="{{ tip_id }}">{{ tooltip }}</span>{% endif %}
                    </span>
                    {% endfor %}
                </div>
                {% endif %}
                {{ render_findings(ds.findings) }}
                {% if ds.publication %}
                <div style="margin-top: 8px; font-size: 0.85rem;">
                    <a href="{{ ds.publication | curie_to_url }}" target="_blank" style="color: var(--secondary);">{{ ds.publication }}</a>
                </div>
                {% endif %}
                {% if ds.notes %}
                <div class="item-desc" style="margin-top: 8px; font-style: italic;">{{ ds.notes }}</div>
                {% endif %}
                {{ render_evidence(ds.evidence) }}
            </div>
            {% endfor %}
        </div>
        {% endif %}

        <!-- Clinical Trials -->
        {% if disorder.clinical_trials %}
        <div class="card" id="trials">
            <div class="card-header">
                <div class="card-icon" style="background: #f5f3ff; color: #a855f7;">🔬</div>
                <h2 class="card-title">Clinical Trials</h2>
                <span class="card-count">{{ disorder.clinical_trials | length }}</span>
            </div>
            {% for trial in disorder.clinical_trials %}
            <div class="item-box clinical-trial-box anchor-target"{% if trial._anchor_id %} id="{{ trial._anchor_id }}"{% endif %}>
                <div class="item-name">
                    {{ trial.name }}
                    {% if trial.phase %}
                    <span class="tag tag-phase">{{ trial.phase }}</span>
                    {% endif %}
                    {% if trial.status %}
                    <span class="tag tag-status">{{ trial.status }}</span>
                    {% endif %}
                </div>
                {% if trial.description %}
                <div class="item-desc">{{ trial.description }}</div>
                {% endif %}
                {% if trial.target_phenotypes %}
                <div class="item-meta">
                    <strong style="font-size: 0.8rem; color: #6b21a8;">Target Phenotypes:</strong>
                    {% for pheno in trial.target_phenotypes %}
                    {% set tooltip = term_tooltip(pheno, "trial.target_phenotypes") %}
                    {% set pill_tips.n = pill_tips.n + 1 %}{% set tip_id = "pill-tip-" ~ pill_tips.n %} {% set has_chip = pheno.term and pheno.term.id %}
                    <span class="tag" style="background: #ede9fe; color: #6b21a8; font-size: 0.8rem;"{% if tooltip and not has_chip %} tabindex="0" aria-describedby="{{ tip_id }}"{% endif %}>
                        {{ pheno.preferred_term or pheno.term.label }}
                        {% if has_chip %}
                        {{ render_curie_link(pheno.term.id, describedby=tip_id) }}
                        {% endif %}
                        {% if tooltip %}<span class="pill-tip" role="tooltip" id="{{ tip_id }}">{{ tooltip }}</span>{% endif %}
                    </span>
                    {% endfor %}
                </div>
                {% endif %}
                {{ render_evidence(trial.evidence) }}
            </div>
            {% endfor %}
        </div>
        {% endif %}

        <!-- Experimental Models -->
        {% if experimental_models %}
        <div id="experimental-models"></div>
        <div class="card" id="models">
            <div class="card-header">
                <div class="card-icon" style="background: #fffbeb; color: #f59e0b;">🧫</div>
                <h2 class="card-title">Experimental Models</h2>
                <span class="card-count">{{ experimental_models | length }}</span>
            </div>
            {% for model in experimental_models %}
            <div class="item-box exp-model-box anchor-target"{% if model._anchor_id %} id="{{ model._anchor_id }}"{% endif %} data-dismech-node="{{ model.name | e }}" data-dismech-type="experimental_model">
                <div class="item-name">
                    {{ model.name }}
                    {% if model.experimental_model_type %}
                    <span class="tag tag-exp-model-type">{{ model.experimental_model_type }}</span>
                    {% endif %}
                    {% if model.namo_type %}
                    <span class="tag tag-namo-type">
                        {{ render_curie_link(model.namo_type) }}
                    </span>
                    {% endif %}
                </div>
                {% if model.description %}
                <div class="item-desc">{{ model.description }}</div>
                {% endif %}
                {% if model.conditions %}
                <div class="tag-list" style="margin-top: 10px;">
                    {% for condition in model.conditions %}
                    <span class="tag tag-condition">{{ condition }}</span>
                    {% endfor %}
                </div>
                {% endif %}
                {% if model.cell_types %}
                <div class="tag-list" style="margin-top: 10px;">
                    {% for cell in model.cell_types %}
                    {% set tooltip = term_tooltip(cell, "model.cell_types") %}
                    {% set pill_tips.n = pill_tips.n + 1 %}{% set tip_id = "pill-tip-" ~ pill_tips.n %}
                    <span class="tag tag-cell">
                        {% if cell.term and cell.term.id %}
                        {{ cell.preferred_term or cell.term.label }} {{ render_curie_link(cell.term.id, describedby=tip_id) }}
                        {% else %}
                        {{ cell.preferred_term or (cell.term.label if cell.term else '') }}
                        {% endif %}
                        {% if tooltip %}<span class="pill-tip" role="tooltip" id="{{ tip_id }}">{{ tooltip }}</span>{% endif %}
                    </span>
                    {% endfor %}
                </div>
                {% endif %}
                {% if model.organism or model.tissue_term or model.cell_source or model.culture_system or model.publication %}
                <div class="model-detail-list">
                    {% if model.organism %}
                    <div class="model-detail-row">
                        <div class="model-detail-label">Organism</div>
                        {% set tooltip = term_tooltip(model.organism, "model.organism") %}
                        {% set pill_tips.n = pill_tips.n + 1 %}{% set tip_id = "pill-tip-" ~ pill_tips.n %}
                        <div class="model-detail-value">
                            {% if model.organism.term and model.organism.term.id %}
                            {{ model.organism.preferred_term or model.organism.term.label }} {{ render_curie_link(model.organism.term.id, describedby=tip_id) }}
                            {% else %}
                            {{ model.organism.preferred_term or (model.organism.term.label if model.organism.term else '') }}
                            {% endif %}
                            {% if tooltip %}<span class="pill-tip" role="tooltip" id="{{ tip_id }}">{{ tooltip }}</span>{% endif %}
                        </div>
                    </div>
                    {% endif %}
                    {% if model.tissue_term %}
                    <div class="model-detail-row">
                        <div class="model-detail-label">Tissue</div>
                        {% set tooltip = term_tooltip(model.tissue_term, "model.tissue_term") %}
                        {% set pill_tips.n = pill_tips.n + 1 %}{% set tip_id = "pill-tip-" ~ pill_tips.n %}
                        <div class="model-detail-value">
                            {% if model.tissue_term.term and model.tissue_term.term.id %}
                            {{ model.tissue_term.preferred_term or model.tissue_term.term.label }} {{ render_curie_link(model.tissue_term.term.id, describedby=tip_id) }}
                            {% else %}
                            {{ model.tissue_term.preferred_term or (model.tissue_term.term.label if model.tissue_term.term else '') }}
                            {% endif %}
                            {% if tooltip %}<span class="pill-tip" role="tooltip" id="{{ tip_id }}">{{ tooltip }}</span>{% endif %}
                        </div>
                    </div>
                    {% endif %}
                    {% if model.cell_source %}
                    <div class="model-detail-row">
                        <div class="model-detail-label">Cell source</div>
                        <div class="model-detail-value">{{ model.cell_source }}</div>
                    </div>
                    {% endif %}
                    {% if model.culture_system %}
                    <div class="model-detail-row">
                        <div class="model-detail-label">Culture</div>
                        <div class="model-detail-value">{{ model.culture_system }}</div>
                    </div>
                    {% endif %}
                    {% if model.publication %}
                    <div class="model-detail-row">
                        <div class="model-detail-label">Publication</div>
                        <div class="model-detail-value">
                            {{ render_curie_link(model.publication) }}
                        </div>
                    </div>
                    {% endif %}
                </div>
                {% endif %}
                {{ render_model_mechanism_links(model._modeled_mechanisms_resolved) }}
                {{ render_findings(model.findings) }}
                {% if model.notes %}
                <div style="margin-top: 8px; font-style: italic; font-size: 0.85rem; color: var(--text-muted);">{{ model.notes }}</div>
                {% endif %}
                {{ render_evidence(model.evidence) }}
            </div>
            {% endfor %}
        </div>
        {% endif %}

        <!-- Animal Models -->
        {% if animal_models %}
        <div id="animal-models"></div>
        <div class="card"{% if not experimental_models %} id="models"{% endif %}>
            <div class="card-header">
                <div class="card-icon" style="background: #f5f3ff; color: #8b5cf6;">🐁</div>
                <h2 class="card-title">Animal Models</h2>
                <span class="card-count">{{ animal_models | length }}</span>
            </div>
            {% for model in animal_models %}
            {% set model_label = model._display_name or model.name or model.genotype or model.species %}
            <div class="item-box exp-model-box anchor-target"{% if model._anchor_id %} id="{{ model._anchor_id }}"{% endif %} data-dismech-node="{{ model_label | e }}" data-dismech-type="animal_model">
                <div class="item-name">
                    {{ model_label }}
                    {% if model.category %}
                    <span class="tag tag-exp-model-type">{{ model.category }}</span>
                    {% endif %}
                </div>
                {% if model.description %}
                <div class="item-desc">{{ model.description }}</div>
                {% endif %}
                {% if model.associated_phenotypes %}
                <div class="tag-list" style="margin-top: 10px;">
                    {% for phenotype in model.associated_phenotypes %}
                    <span class="tag tag-phenotype">{{ phenotype }}</span>
                    {% endfor %}
                </div>
                {% endif %}
                {% if model.species or model.genotype or model.background or model.alleles or model.genes or model.publication %}
                <div class="model-detail-list">
                    {% if model.species %}
                    <div class="model-detail-row">
                        <div class="model-detail-label">Species</div>
                        <div class="model-detail-value">{{ model.species }}</div>
                    </div>
                    {% endif %}
                    {% if model.genotype %}
                    <div class="model-detail-row">
                        <div class="model-detail-label">Genotype</div>
                        <div class="model-detail-value">{{ model.genotype }}</div>
                    </div>
                    {% endif %}
                    {% if model.background %}
                    <div class="model-detail-row">
                        <div class="model-detail-label">Background</div>
                        <div class="model-detail-value">{{ model.background }}</div>
                    </div>
                    {% endif %}
                    {% if model.alleles %}
                    <div class="model-detail-row">
                        <div class="model-detail-label">Alleles</div>
                        <div class="model-detail-value">{{ model.alleles | join(', ') }}</div>
                    </div>
                    {% endif %}
                    {% if model.genes %}
                    <div class="model-detail-row">
                        <div class="model-detail-label">Genes</div>
                        <div class="model-detail-value">{{ render_descriptor_tags(model.genes, "tag-gene", false, "model.genes") }}</div>
                    </div>
                    {% endif %}
                    {% if model.publication %}
                    <div class="model-detail-row">
                        <div class="model-detail-label">Publication</div>
                        <div class="model-detail-value">
                            {{ render_curie_link(model.publication) }}
                        </div>
                    </div>
                    {% endif %}
                </div>
                {% endif %}
                {{ render_model_mechanism_links(model._modeled_mechanisms_resolved) }}
                {% if model.notes %}
                <div style="margin-top: 8px; font-style: italic; font-size: 0.85rem; color: var(--text-muted);">{{ model.notes }}</div>
                {% endif %}
                {{ render_evidence(model.evidence) }}
            </div>
            {% endfor %}
        </div>
        {% endif %}

        <!-- Computational Models -->
        {% if computational_models %}
        <div class="card"{% if not experimental_models and not animal_models %} id="models"{% endif %}>
            <div class="card-header">
                <div class="card-icon" style="background: #f0fdf4; color: #22c55e;">🧮</div>
                <h2 class="card-title">Computational Models</h2>
                <span class="card-count">{{ computational_models | length }}</span>
            </div>
            {% for model in computational_models %}
            <div class="item-box comp-model-box anchor-target"{% if model._anchor_id %} id="{{ model._anchor_id }}"{% endif %} data-dismech-node="{{ model.name | e }}" data-dismech-type="computational_model">
                <div class="item-name">
                    {{ model.name }}
                    {% if model.model_format %}
                    <span class="tag tag-format">{{ model.model_format }}</span>
                    {% endif %}
                    {% if model.model_software %}
                    <span class="tag tag-software">{{ model.model_software }}</span>
                    {% endif %}
                    {% if model.model_type %}
                    <span class="tag tag-model-type">{{ model.model_type }}</span>
                    {% endif %}
                </div>
                {% if model.description %}
                <div class="item-desc">{{ model.description }}</div>
                {% endif %}
                <div class="item-meta" style="margin-top: 8px;">
                    {% if model.repository_url %}
                    <a href="{{ model.repository_url }}" target="_blank" style="color: var(--secondary); font-size: 0.85rem; margin-right: 16px;">Repository ↗</a>
                    {% endif %}
                    {% if model.publication %}
                    {{ render_curie_link(model.publication) }}
                    {% endif %}
                    {% if model.base_model %}
                    <span style="font-size: 0.85rem; color: var(--text-muted);">Base model: {{ model.base_model }}</span>
                    {% endif %}
                </div>
                {% if model.variables %}
                <table class="model-variables-table">
                    <thead>
                        <tr>
                            <th>Variable</th>
                            <th>Model ID</th>
                            <th>Unit</th>
                            <th>Ontology Mappings</th>
                            <th>Phenotype Thresholds</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for var in model.variables %}
                        <tr>
                            <td>
                                <div class="model-var-name">{{ var.name }}</div>
                                {% if var.description %}
                                <div class="model-var-desc">{{ var.description }}</div>
                                {% endif %}
                            </td>
                            <td>
                                {% if var.dataset_identifier %}
                                <code class="model-var-id">{{ var.dataset_identifier }}</code>
                                {% endif %}
                            </td>
                            <td>{{ var.unit or '' }}</td>
                            <td>
                                {% for mapping in (var.mappings_list or []) %}
                                    {% if not mapping.threshold %}
                                    <span class="ontology-mapping-tag">
                                        {% if mapping.term and mapping.term.id %}
                                        <a href="{{ mapping.term.id | curie_to_url }}" target="_blank">{{ mapping.preferred_term or mapping.term.label }}</a>
                                        {% else %}
                                        {{ mapping.preferred_term or '' }}
                                        {% endif %}
                                    </span>
                                    {% endif %}
                                {% endfor %}
                            </td>
                            <td>
                                {% for mapping in (var.mappings_list or []) %}
                                    {% if mapping.threshold %}
                                    <div style="margin-bottom: 4px;">
                                        <span style="font-size: 0.8rem; font-weight: 500;">
                                            {% if mapping.term and mapping.term.id %}
                                            <a href="{{ mapping.term.id | curie_to_url }}" target="_blank" style="color: inherit;">{{ mapping.preferred_term or mapping.term.label }}</a>
                                            {% else %}
                                            {{ mapping.preferred_term or '' }}
                                            {% endif %}
                                            {# A ratio-of-baseline threshold is not a reading in the column's unit;
                                               without the suffix it reads ~5x off for urate. The discriminator comes
                                               from results_export.threshold_kind via render.py, so the rule lives in
                                               exactly one place. #}
                                            {% set is_ratio = mapping._threshold_kind == 'ratio_of_baseline' %}
                                            <span style="font-size: 0.75rem; color: var(--text-muted);">{{ mapping.threshold_direction or '' }} {{ mapping.threshold }}{% if is_ratio %}&times; baseline{% endif %}</span>
                                        </span>
                                        {% if mapping.severity_scale %}
                                        <div>
                                            {% for sev in mapping.severity_scale %}
                                            {% set sev_name = sev.name | lower %}
                                            {% set sev_value = sev.threshold ~ ('&times; baseline' if is_ratio else '') %}
                                            {% if sev_name in ('mild', 'growth impairment') %}
                                            <span class="severity-pill severity-mild">{{ sev.name }} {{ sev_value | safe }}</span>
                                            {% elif sev_name in ('moderate', 'moderate risk') %}
                                            <span class="severity-pill severity-moderate">{{ sev.name }} {{ sev_value | safe }}</span>
                                            {% elif sev_name in ('severe', 'high risk', 'calciphylaxis risk') %}
                                            <span class="severity-pill severity-severe">{{ sev.name }} {{ sev_value | safe }}</span>
                                            {% else %}
                                            <span class="severity-pill severity-other">{{ sev.name }} {{ sev_value | safe }}</span>
                                            {% endif %}
                                            {% endfor %}
                                        </div>
                                        {% endif %}
                                    </div>
                                    {% endif %}
                                {% endfor %}
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
                {% endif %}
                {% if model._run_results %}
                {% set run = model._run_results %}
                <details class="model-run-block">
                    <summary class="model-run-summary">
                        Simulation results &mdash; {{ run.scenarios | length }} scenario{{ '' if run.scenarios | length == 1 else 's' }}
                        <span class="model-run-note">
                            run with {{ run.provenance.runner }} over
                            {{ run.provenance.duration_hours }} h; baseline
                            {{ run.provenance.severity_dial }} = {{ run.baseline_dial }}
                        </span>
                    </summary>
                    {% if run.caveat %}
                    <div class="model-run-caveat">
                        <strong>Interpretation caveat.</strong> {{ run.caveat }}
                    </div>
                    {% endif %}
                    <div class="model-run-scroll">
                    <table class="model-variables-table model-run-table">
                        <thead>
                            <tr>
                                <th>Scenario</th>
                                {% for obs in run.observables %}
                                <th>{{ obs.label or obs.name }}</th>
                                {% endfor %}
                                <th>Activated phenotypes</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr class="model-run-baseline">
                                <td><div class="model-var-name">Healthy baseline</div>
                                    <div class="model-var-desc">{{ run.provenance.severity_dial }} = {{ run.baseline_dial }}</div>
                                </td>
                                {% for obs in run.observables %}
                                <td>{{ run['baseline'][obs.name] if obs.name in run['baseline'] else '' }}</td>
                                {% endfor %}
                                <td class="model-var-desc">reference</td>
                            </tr>
                            {% for scenario in run.scenarios %}
                            <tr>
                                <td>
                                    <div class="model-var-name">{{ scenario.label }}</div>
                                    {% if scenario.causal_root %}
                                    <div class="model-var-desc">
                                        drives
                                        {% if scenario._causal_root_anchor %}<a href="#{{ scenario._causal_root_anchor }}">{{ scenario.causal_root }}</a>{% else %}{{ scenario.causal_root }}{% endif %}
                                    </div>
                                    {% endif %}
                                </td>
                                {% for obs in run.observables %}
                                {% set value = scenario['final_values'].get(obs.name) %}
                                {% set fold = scenario['fold_change'].get(obs.name) %}
                                <td>
                                    {% if value is not none %}{{ value }}{% endif %}
                                    {% if fold is not none %}
                                    <div class="model-var-desc">{{ '%.2f' | format(fold) }}&times; baseline</div>
                                    {% endif %}
                                </td>
                                {% endfor %}
                                <td>
                                    {% for phenotype in scenario.phenotypes %}
                                    {% set sev = phenotype.severity | lower %}
                                    <span class="severity-pill severity-{{ 'mild' if sev == 'mild' else ('moderate' if sev == 'moderate' else ('severe' if sev == 'severe' else 'other')) }}"
                                          title="{{ phenotype.value_description }}">
                                        <a href="{{ phenotype.hp_id | curie_to_url }}" target="_blank" rel="noopener noreferrer">{{ phenotype.hp_label }}</a>
                                        {# Suppressed entirely when the model declares its scenarios not
                                           comparable in severity — see the caveat above. #}
                                        {% if phenotype.severity and sev != 'unknown' %}&middot; {{ phenotype.severity }}{% endif %}
                                    </span>
                                    {% else %}
                                    <span class="model-var-desc">none</span>
                                    {% endfor %}
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                    </div>
                    <div class="model-run-provenance">
                        Derived artifact, regenerated by <code>just gen-model-results</code>
                        &mdash; not curated evidence. Values rounded to
                        {{ run.provenance.rounding_decimals }} decimals.
                        Config <code>{{ run.provenance.config_sha256[:12] }}</code>,
                        {{ run.provenance.sbml_file }} <code>{{ run.provenance.sbml_sha256[:12] }}</code>.
                        Phenotypes activate per the thresholds in the table above.
                    </div>
                </details>
                {% endif %}
                {{ render_model_mechanism_links(model._modeled_mechanisms_resolved) }}
                {{ render_findings(model.findings) }}
                {% if model.notes %}
                <div style="margin-top: 8px; font-style: italic; font-size: 0.85rem; color: var(--text-muted);">{{ model.notes }}</div>
                {% endif %}
                {{ render_evidence(model.evidence) }}
            </div>
            {% endfor %}
        </div>
        {% endif %}

        <!-- Reports -->
        {% if report_sections %}
        <div class="card" id="reports">
            <div class="card-header">
                <div class="card-icon" style="background: #faf5ff; color: #a855f7;">📄</div>
                <h2 class="card-title">Reports</h2>
                <span class="card-count">{{ report_sections | length }}</span>
            </div>
            {% for report in report_sections %}
            <div style="margin-bottom: 4px;">
                <div class="report-toggle" onclick="this.nextElementSibling.classList.toggle('show'); this.querySelector('.toggle-indicator').textContent = this.nextElementSibling.classList.contains('show') ? '▾' : '▸'">
                    <span>{{ report.title }}</span>
                    <span class="toggle-indicator" style="font-size: 0.9rem;">▸</span>
                </div>
                <div class="report-body">
                    <div class="report-content">
                        {{ report.html | safe }}
                    </div>
                </div>
            </div>
            {% endfor %}
        </div>
        {% endif %}

        <!-- YAML Source -->
        <div class="card">
            <div class="card-header" style="cursor: pointer;" onclick="toggleYaml()">
                <div class="card-icon" style="background: #f1f5f9; color: #475569;">{ }</div>
                <h2 class="card-title">Source YAML</h2>
                <span class="card-count" id="yamlToggleText">click to show</span>
            </div>
            <div class="yaml-content" id="yamlContent">
                <pre class="yaml-preview">{{ yaml_content }}</pre>
            </div>
        </div>

        <!-- References & Deep Research -->
        {% if disorder.references or literature_sections %}
        <div class="card reference-card" id="references-deep-research">
            <div class="card-header">
                <div class="card-icon" style="background: #eef2ff; color: #4f46e5;">📚</div>
                <h2 class="card-title">References &amp; Deep Research</h2>
            </div>
            {% if disorder.references %}
            <div class="grouped-section anchor-target" id="references">
                <div class="grouped-section-header">
                    <h3 class="grouped-section-title">References</h3>
                    <span class="card-count">{{ disorder.references | length }}</span>
                </div>
                {% for publication in disorder.references %}
                <div class="reference-entry">
                    <div class="reference-entry-header">
                        <div>
                            <div class="reference-curie">
                                <a href="{{ publication.reference | curie_to_url }}" target="_blank">{{ publication.reference }}</a>
                            </div>
                            {% if publication.title %}
                            <div class="reference-title">{{ publication.title }}</div>
                            {% endif %}
                        </div>
                        {% if publication.findings %}
                        <span class="reference-summary">{{ publication.findings | length }} finding{{ 's' if publication.findings | length != 1 else '' }}</span>
                        {% endif %}
                    </div>
                    {% if publication.findings %}
                    {{ render_reference_findings(publication.findings) }}
                    {% else %}
                    <div class="reference-empty">No top-level findings curated for this source.</div>
                    {% endif %}
                </div>
                {% endfor %}
            </div>
            {% endif %}
            {% if literature_sections %}
            <div class="grouped-section anchor-target" id="literature-summaries">
                <div class="grouped-section-header">
                    <h3 class="grouped-section-title">Deep Research</h3>
                    <span class="card-count">{{ literature_sections | length }}</span>
                </div>
                {% for report in literature_sections %}
                <div style="margin-bottom: 4px;">
                    <div class="report-toggle" onclick="this.nextElementSibling.classList.toggle('show'); this.querySelector('.toggle-indicator').textContent = this.nextElementSibling.classList.contains('show') ? '▾' : '▸'">
                        <span>{{ report.title }}</span>
                        <span class="toggle-indicator" style="font-size: 0.9rem;">▸</span>
                    </div>
                    <div class="report-body">
                        {% if report.subtitle or report.model or report.end_time or report.citation_count %}
                        <div class="report-meta">
                            {% if report.subtitle %}
                            <div class="report-subtitle">{{ report.subtitle }}</div>
                            {% endif %}
                            {% if report.model %}
                            <span class="report-badge">{{ report.model }}</span>
                            {% endif %}
                            {% if report.citation_count is not none %}
                            <span class="report-badge">{{ report.citation_count }} citations</span>
                            {% endif %}
                            {% if report.end_time %}
                            <span class="report-meta-text">{{ report.end_time }}</span>
                            {% endif %}
                        </div>
                        {% endif %}
                        <div class="report-content">
                            {{ report.html | safe }}
                        </div>
                    </div>
                </div>
                {% endfor %}
            </div>
            {% endif %}
        </div>
        {% endif %}

        <footer class="page-footer">
            <p>
                Generated from <a href="https://github.com/monarch-initiative/dismech" target="_blank">dismech</a>
                knowledge base
            </p>
            <p style="margin-top: 8px;">
                <a href="{{ source_file }}" target="_blank">View source on GitHub</a>
            </p>
            {% include "_disclaimer_footer.html.j2" %}
        </footer>
    </div>

