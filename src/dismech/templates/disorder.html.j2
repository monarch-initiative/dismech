    {# Orphanet prevalence bands read wrong when title-cased: BAND_1_5_PER_10000
       renders as "Band 1 5 Per 10000" but *means* 1-9 per 10,000 (the schema
       merges Orphanet's 1-5 and 6-9 classes into it), so the mechanical form
       understates the range. Unmapped values fall back to it rather than
       vanishing, so a new enum member still shows. #}
    {% set PREVALENCE_CLASS_LABELS = {
        "ABOVE_1_IN_1000": ">1 in 1,000",
        "BAND_1_5_PER_10000": "1–9 per 10,000",
        "BAND_1_9_PER_100000": "1–9 per 100,000",
        "BAND_1_9_PER_1000000": "1–9 per 1,000,000",
        "BELOW_1_IN_1000000": "<1 in 1,000,000",
        "NOT_YET_DOCUMENTED": "Not yet documented",
    } %}
    {% macro render_prevalence_class(value) %}
    {%- if value -%}
    <span class="tag">{{ PREVALENCE_CLASS_LABELS.get(value) or (value | replace('_', ' ') | title) }}</span>
    {%- endif -%}
    {% endmacro %}

    {% macro render_entity_refs(title, refs) %}
