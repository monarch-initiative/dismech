        {% endfor %}
        {% endif %}
        {% if control.perturbations %}
        <div class="experiment-section-title" style="margin-top: 8px;">Perturbations</div>
        {% for perturbation in control.perturbations %}
        {{ render_experiment_perturbation(perturbation) }}
        {% endfor %}
        {% endif %}
        {{ render_evidence(control.evidence, max_visible=1) }}
