        {{ render_descriptor_tags(perturbation.triggers, "tag-env", false, "perturbation.triggers") }}
        {{ render_descriptor_tags(perturbation.biological_processes, "tag-bio", false, "perturbation.biological_processes") }}
        {% if perturbation.effect %}
