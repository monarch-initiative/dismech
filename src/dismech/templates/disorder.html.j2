        <!-- Subtypes -->
        {% if disorder.has_subtypes %}
        <div class="card" id="subtypes">
            <div class="card-header">
                <div class="card-icon" style="background: #eef2ff; color: #4f46e5;">◆</div>
                <h2 class="card-title">Subtypes</h2>
                <span class="card-count">{{ disorder.has_subtypes | length }}</span>
            </div>
            {# Group subtypes by classification #}
            {% set ns = namespace(schemes={}) %}
            {% for subtype in disorder.has_subtypes %}
                {% set scheme = subtype.classification or 'General' %}
                {% if scheme not in ns.schemes %}
                    {% set _ = ns.schemes.update({scheme: []}) %}
                {% endif %}
                {% set _ = ns.schemes[scheme].append(subtype) %}
            {% endfor %}
            {% for scheme, subtypes_in_scheme in ns.schemes.items() %}
                {% if ns.schemes | length > 1 %}
                <div class="classification-header">{{ scheme | replace('_', ' ') }}</div>
                {% endif %}
                {% for subtype in subtypes_in_scheme %}
                {% set subtype_term_id = subtype.subtype_term.term.id if subtype.subtype_term and subtype.subtype_term.term and subtype.subtype_term.term.id else None %}
                {% set subtype_mondo_mappings = subtype.mappings.mondo_mappings if subtype.mappings and subtype.mappings.mondo_mappings else [] %}
                {% set subtype_ncit_mappings = subtype.mappings.ncit_mappings if subtype.mappings and subtype.mappings.ncit_mappings else [] %}
                <div class="item-box subtype-box anchor-target"{% if subtype._anchor_id %} id="{{ subtype._anchor_id }}"{% endif %}>
                    {% set subtype_display = subtype.display_name or subtype.name %}
                    <div class="item-name">
                        {{ subtype_display }}
                        {% if subtype_term_id %}
                        <a class="subtype-term-link" href="{{ subtype_term_id | curie_to_url }}" target="_blank">{{ subtype_term_id }}</a>
                        {% endif %}
                        {% for mapping in subtype_mondo_mappings %}
                                {% if mapping.term and mapping.term.id and mapping.term.id != subtype_term_id %}
                        <a class="subtype-term-link" href="{{ mapping.term.id | curie_to_url }}" target="_blank">{{ mapping.term.id }}</a>
                                {% endif %}
                        {% endfor %}
                        {% for mapping in subtype_ncit_mappings %}
                                {% if mapping.term and mapping.term.id %}
                        <a class="subtype-term-link" href="{{ mapping.term.id | curie_to_url }}" target="_blank">{{ mapping.term.id }}</a>
                                {% endif %}
                        {% endfor %}
                    </div>
                    <div class="subtype-meta">
                        {% if subtype.subtype_frequency %}
                        <span class="subtype-freq-badge">{{ subtype.subtype_frequency }}</span>
                        {% endif %}
                        {% if subtype.genes %}
                            {% for gene in subtype.genes %}
                            {% set tooltip = term_tooltip(gene, "subtype.gene") %}
                            {% set pill_tips.n = pill_tips.n + 1 %}{% set tip_id = "pill-tip-" ~ pill_tips.n %} {% set has_chip = gene.term and gene.term.id %}
                            <span class="subtype-gene-tag"{% if tooltip and not has_chip %} tabindex="0" aria-describedby="{{ tip_id }}"{% endif %}>
                                {{ gene.preferred_term or gene.term.label }}
                                {% if has_chip %}
                                {{ render_curie_link(gene.term.id, describedby=tip_id) }}
                                {% endif %}
                                {% if tooltip %}<span class="pill-tip" role="tooltip" id="{{ tip_id }}">{{ tooltip }}</span>{% endif %}
                            </span>
                            {% endfor %}
                        {% endif %}
                        {% if subtype.inheritance %}
                            {% for inheritance_item in subtype.inheritance %}
                            <span class="subtype-inheritance-tag">{{ inheritance_item.inheritance_term.preferred_term if inheritance_item.inheritance_term else inheritance_item }}</span>
                            {% endfor %}
                        {% endif %}
                        {% for mapping in subtype_mondo_mappings %}
                            {% if mapping.term and mapping.term.id and mapping.term.id != subtype_term_id %}
                            <a class="subtype-term-link" href="{{ mapping.term.id | curie_to_url }}" target="_blank">MONDO {{ mapping.term.id }}</a>
                            {% endif %}
                        {% endfor %}
                        {% for mapping in subtype_ncit_mappings %}
                            {% if mapping.term and mapping.term.id %}
                            <a class="subtype-term-link" href="{{ mapping.term.id | curie_to_url }}" target="_blank">NCIT {{ mapping.term.id }}</a>
                            {% endif %}
                        {% endfor %}
                    </div>
                    {% if subtype.description %}
