                        <strong style="font-size: 0.8rem; color: #4338ca;">NCIT:</strong>
                        {% for mapping in subtype.mappings.ncit_mappings %}
                        <span class="tag tag-classification">
                            {{ mapping.term.label }}
                            {% if mapping.mapping_predicate %}
                            ({{ mapping.mapping_predicate }})
                            {% endif %}
                        </span>
                        {% if mapping.term and mapping.term.id %}
                        <a href="{{ mapping.term.id | curie_to_url }}" target="_blank" style="font-size: 0.82rem; color: #4338ca; margin-right: 8px;">{{ mapping.term.id }}</a>
                        {% endif %}
                        {% endfor %}
                    </div>
                    {% endif %}
                    {% if subtype.children %}
                    <ul class="subtype-children">
                        {% for child_name in subtype.children %}
                        <li>{{ child_name }}</li>
                        {% endfor %}
                    </ul>
                    {% endif %}
                    {{ render_evidence(subtype.evidence) }}
                </div>
                {% endfor %}
            {% endfor %}
        </div>
        {% endif %}

