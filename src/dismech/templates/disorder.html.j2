        <span class="tag tag-classification">variant_origin: {{ gc.variant_origin }}</span>
        {% endif %}
        {% if gc.allelic_hit_role %}
        <span class="tag tag-classification">allelic_hit_role: {{ gc.allelic_hit_role }}</span>
        {% endif %}
        {% if gc.allelic_events %}
        {% for event in gc.allelic_events %}
