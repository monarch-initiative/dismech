        {% endif %}
        {% if experiment.model_systems %}
        <div class="experiment-section">
            <div class="experiment-section-title">Model systems</div>
            {% for model in experiment.model_systems %}
            {{ render_experiment_model_system(model) }}
            {% endfor %}
        </div>
        {% endif %}
        {% if experiment.perturbations %}
        <div class="experiment-section">
