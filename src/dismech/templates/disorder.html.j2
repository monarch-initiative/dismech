    {% macro render_experiment_model_system(model) %}
    <div class="experiment-subitem">
        <div class="experiment-subitem-name">{{ model.name or 'Model system' }}</div>
        {% if model.description %}
        <div>{{ model.description }}</div>
        {% endif %}
        <div class="item-meta">
            {% if model.experimental_model_type %}
            <span class="tag tag-exp-model-type">{{ model.experimental_model_type | replace('_', ' ') }}</span>
            {% endif %}
            {% if model.namo_type %}
            <span class="tag tag-namo-type">
                <a href="{{ model.namo_type | curie_to_url }}" target="_blank" style="color: inherit; text-decoration: none;">{{ model.namo_type }} link</a>
            </span>
            {% endif %}
            {% if model.publication %}
            <span class="tag tag-dataset">
                <a href="{{ model.publication | curie_to_url }}" target="_blank" style="color: inherit; text-decoration: none;">{{ model.publication }} link</a>
            </span>
            {% endif %}
            {% if is_preprint(model.publication) %}
            <span class="badge-preprint" title="This publication is a preprint and has not been peer-reviewed.">Preprint · not peer-reviewed</span>
            {% endif %}
        </div>
        {% if model.organism %}
        <div class="item-meta">{{ render_descriptor_tag(model.organism, "tag-organism", false, "model.organism") }}</div>
        {% endif %}
        {% if model.tissue_term %}
        <div class="item-meta">{{ render_descriptor_tag(model.tissue_term, "tag-location", false, "model.tissue_term") }}</div>
        {% endif %}
        {{ render_descriptor_tags(model.cell_types, "tag-cell", false, "model.cell_types") }}
        {% if model.notes %}
        <div class="mapping-notes">{{ model.notes }}</div>
        {% endif %}
    </div>
    {% endmacro %}

    {% macro render_experiment_perturbation(perturbation) %}
    <div class="experiment-subitem">
        <div class="experiment-subitem-name">{{ perturbation.name or 'Perturbation' }}</div>
        {% if perturbation.target %}
        <div class="entity-ref-list">{{ render_entity_ref(perturbation.target) }}</div>
