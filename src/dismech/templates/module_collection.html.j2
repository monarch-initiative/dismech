<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ collection.display_name or collection.name }} - dismech</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin="anonymous">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous">
    <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        {% include '_palette.css.j2' %}
        {% include '_disclaimer.css.j2' %}
        body { font-family: var(--font); color: var(--gray-800); line-height: 1.65; background: var(--gray-50); }
        a { color: var(--teal); text-decoration: none; }
        a:hover { text-decoration: underline; }
        nav { padding: .75rem 1.5rem; background: #fff; border-bottom: 1px solid var(--gray-200); }
        .nav-inner { max-width: 1040px; margin: auto; display: flex; justify-content: space-between; gap: 1rem; }
        .nav-logo { font-weight: 700; }
        .nav-links { display: flex; flex-wrap: wrap; gap: 1rem; font-size: .86rem; }
        .hero { padding: 3.5rem 1.5rem 2.5rem; background: var(--teal-50); border-bottom: 1px solid var(--gray-200); }
        .hero-inner, main { max-width: 1040px; margin: auto; }
        h1 { color: var(--teal); font-size: 2.2rem; line-height: 1.15; }
        .description { max-width: 780px; margin-top: .8rem; color: var(--gray-700); }
        .meta { display: flex; flex-wrap: wrap; gap: .45rem; margin-top: 1rem; }
        .pill { display: inline-flex; padding: .22rem .62rem; border-radius: 999px; background: #fff; border: 1px solid var(--teal-light); color: var(--teal); font-size: .74rem; font-weight: 700; }
        main { padding: 1.8rem 1.5rem 4rem; }
        .breadcrumb { margin-bottom: 1.2rem; color: var(--gray-500); font-size: .86rem; }
        .panel { margin-bottom: 1.5rem; padding: 1.25rem; border: 1px solid var(--gray-200); border-radius: 10px; background: #fff; }
        h2 { margin-bottom: .7rem; font-size: 1.18rem; }
        .member-list { overflow: hidden; border: 1px solid var(--gray-200); border-radius: 8px; }
        .member { display: grid; grid-template-columns: minmax(200px, 1fr) minmax(220px, 1fr) minmax(140px, .55fr); gap: 1rem; padding: .9rem 1rem; border-bottom: 1px solid var(--gray-200); }
        .member:last-child { border-bottom: 0; }
        .member:hover { background: var(--gray-50); }
        .member-name { color: var(--gray-900); font-weight: 700; }
        .module-id { display: block; color: var(--gray-500); font-family: var(--mono); font-size: .72rem; }
        .framework-terms { display: flex; flex-wrap: wrap; gap: .35rem; }
        .framework-term { padding: .18rem .5rem; border-radius: 999px; background: #eef2ff; color: #4338ca; font-size: .72rem; font-weight: 700; }
        .member-note, .evidence-explanation { margin-top: .45rem; color: var(--gray-600); font-size: .84rem; }
        .counts { color: var(--gray-600); font-size: .8rem; text-align: right; }
        blockquote { margin-top: .65rem; padding-left: 1rem; border-left: 3px solid var(--teal-light); color: var(--gray-700); }
        .reference { font-family: var(--mono); font-size: .8rem; }
        @media (max-width: 700px) { .member { grid-template-columns: 1fr; } .counts { text-align: left; } }
    </style>
</head>
<body>
    {% include '_disclaimer.html.j2' %}
    <nav><div class="nav-inner"><a class="nav-logo" href="../../">dismech</a><div class="nav-links"><a href="../modules/">Modules</a><a href="index.html">Collections</a><a href="../groupings/">Disease groupings</a><a href="{{ collection.source_file }}">Source</a></div></div></nav>
    <header class="hero"><div class="hero-inner">
        <h1>{{ collection.display_name or collection.name }}</h1>
        {% if collection.description %}<p class="description">{{ collection.description }}</p>{% endif %}
        <div class="meta">
            <span class="pill">{{ collection.collection_type | replace('_', ' ') | title }}</span>
            <span class="pill">{{ collection.module_count }} modules</span>
            <span class="pill">{{ collection.framework_term_count }} framework terms</span>
        </div>
    </div></header>
    <main>
        <div class="breadcrumb"><a href="../../">Home</a> / <a href="../modules/">Modules</a> / <a href="index.html">Collections</a> / {{ collection.display_name or collection.name }}</div>
        <section class="panel">
            <h2>Modules in this collection</h2>
            <div class="member-list">
                {% for member in collection.members %}
                <article class="member">
                    <div><a class="member-name" href="{{ member.href }}">{{ member.name }}</a><span class="module-id">{{ member.id }}</span></div>
                    <div><div class="framework-terms">{% for term in member.framework_terms %}<span class="framework-term">{{ term }}</span>{% endfor %}</div>{% if member.description %}<p class="member-note">{{ member.description }}</p>{% endif %}</div>
                    <div class="counts">{{ member.pathophysiology_count }} nodes<br>{{ member.disorder_count }} conforming disorders</div>
                </article>
                {% endfor %}
            </div>
        </section>
        {% if collection.evidence %}
        <section class="panel">
            <h2>Framework evidence</h2>
            {% for evidence in collection.evidence %}
            <article>
                <a class="reference" href="{{ evidence.reference | curie_to_url }}">{{ evidence.reference }}</a>{% if evidence.reference_title %} · {{ evidence.reference_title }}{% endif %}
                {% if evidence.snippet %}<blockquote>{{ evidence.snippet }}</blockquote>{% endif %}
                {% if evidence.explanation %}<p class="evidence-explanation">{{ evidence.explanation }}</p>{% endif %}
            </article>
            {% endfor %}
        </section>
        {% endif %}
        {% if collection.notes %}<section class="panel"><h2>Scope note</h2><p>{{ collection.notes }}</p></section>{% endif %}
    </main>
</body>
</html>
