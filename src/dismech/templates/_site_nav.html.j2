{#-
  The site-wide header, shared by every reader-facing page (issue #14022).

  This partial is the only place the header's links are written. Every Jinja
  template includes it, and the hand-written pages (index.html, app/*.html,
  details/index.html, contributing/index.html, downloads/index.html) carry a
  copy that `just sync-site-nav` writes between `<!-- site-nav:start -->`
  and `<!-- site-nav:end -->` markers.
  tests/test_site_nav.py fails if a page has its own header or a stale copy.

  Parameters, set with `{% with %}` around the include:
    nav_root    relative path from the page to the site root, e.g. "../../"
                for pages/<section>/<page>.html; "" for the root index.html
    nav_active  key of the link for the current section (see `links` below),
                or "" for none. The menu holding that link is marked too.

  The menus are <details> elements, so they open on click, tap, Enter and
  Space with no script. The small script below only closes an open menu when
  another opens, on a click outside it, and on Escape.
-#}
{%- set root = nav_root | default('') -%}
{%- set active = nav_active | default('') -%}
{%- set menus = [
    ('Disorders', [
        ('groupings', 'Disorder groupings', 'pages/groupings/index.html'),
        ('classifications', 'Classifications', 'pages/classifications/index.html'),
        ('trajectories', 'Trajectories', 'pages/comorbidities/index.html'),
    ]),
    ('Mechanisms', [
        ('modules', 'Modules', 'pages/modules/index.html'),
        ('module-collections', 'Module collections', 'pages/module-collections/index.html'),
        ('genes', 'Genes', 'pages/genes/index.html'),
        ('models', 'Runnable models', 'pages/models/index.html'),
        ('models-browser', 'Computational models', 'app/models/index.html'),
    ]),
    ('Research', [
        ('research', 'Research reports', 'pages/research/index.html'),
        ('discussions', 'Discussions', 'app/discussions/index.html'),
        ('projects', 'Projects', 'pages/projects/index.html'),
    ]),
    ('Data', [
        ('embeddings', 'Embeddings', 'app/embeddings/index.html'),
        ('downloads', 'Downloads', 'downloads/index.html'),
    ]),
    ('Docs', [
        ('docs', 'Documentation', 'details/index.html'),
        ('contributing', 'How to contribute', 'contributing/index.html'),
        ('schema', 'Schema', 'elements/index.html'),
    ]),
] -%}
<style>
    nav.dm-nav { --dm-nav-teal: #00838f; --dm-nav-text: #4b5563; --dm-nav-line: #e5e7eb; --dm-nav-tint: #e8f6f8;
        position: sticky; top: 0; z-index: 100; padding: 0.75rem 1.5rem; background: rgba(255, 255, 255, 0.96);
        backdrop-filter: blur(12px); border-bottom: 1px solid var(--dm-nav-line); font-size: 0.875rem; line-height: 1.4; }
    .dm-nav-inner { max-width: var(--max-width, 1200px); margin: 0 auto; display: flex; flex-wrap: wrap;
        align-items: center; justify-content: space-between; gap: 0.5rem 1rem; }
    .dm-nav a { text-decoration: none; }
    .dm-nav-logo { display: inline-flex; align-items: center; gap: 0.5rem; font-weight: 700; font-size: 1.1rem; letter-spacing: -0.02em; color: var(--dm-nav-teal); }
    .dm-nav-logo img { height: 1.55rem; width: auto; display: block; }
    .dm-nav-links { display: flex; flex-wrap: wrap; align-items: center; gap: 0.25rem 1.25rem; margin: 0; padding: 0; list-style: none; }
    .dm-nav-links > li { position: relative; }
    .dm-nav-links > li > a, .dm-nav-menu > summary { color: var(--dm-nav-text); cursor: pointer; }
    .dm-nav-links > li > a:hover, .dm-nav-menu > summary:hover,
    .dm-nav-links > li > a.active, .dm-nav-menu.active > summary { color: var(--dm-nav-teal); }
    .dm-nav-links > li > a.active, .dm-nav-menu.active > summary { font-weight: 600; }
    .dm-nav-menu > summary { list-style: none; user-select: none; }
    .dm-nav-menu > summary::-webkit-details-marker { display: none; }
    .dm-nav-menu > summary::after { content: ""; display: inline-block; margin-left: 0.35em; vertical-align: 0.2em;
        border: 0.3em solid transparent; border-top-color: currentColor; border-bottom: 0; }
    .dm-nav-menu[open] > summary::after { border-top: 0; border-bottom: 0.3em solid currentColor; }
    .dm-nav-panel { position: absolute; top: calc(100% + 0.6rem); left: -0.75rem; min-width: 12rem; margin: 0;
        padding: 0.35rem 0; list-style: none; background: #fff; border: 1px solid var(--dm-nav-line);
        border-radius: 8px; box-shadow: 0 8px 24px rgba(17, 24, 39, 0.12); }
    .dm-nav-links > li:nth-last-child(-n+3) .dm-nav-panel { left: auto; right: -0.75rem; }
    .dm-nav-panel a { display: block; padding: 0.4rem 1rem; color: var(--dm-nav-text); white-space: nowrap; }
    .dm-nav-panel a:hover, .dm-nav-panel a:focus-visible { background: var(--dm-nav-tint); color: var(--dm-nav-teal); }
    .dm-nav-panel a.active { color: var(--dm-nav-teal); font-weight: 600; }
    .dm-nav-gh { display: inline-flex; color: var(--dm-nav-text); }
    .dm-nav-gh:hover { color: var(--dm-nav-teal); }
    .dm-nav-gh svg { width: 18px; height: 18px; }
    @media (max-width: 640px) {
        nav.dm-nav { padding: 0.6rem 1rem; font-size: 0.84rem; }
        .dm-nav-links { gap: 0.25rem 0.75rem; }
        .dm-nav-menu > summary::after { margin-left: 0.25em; }
        /* Hang the open panel from the whole header (sticky, so it is the
           containing block) rather than from its button, so it never covers
           the links and always has the full width to use. */
        .dm-nav-links > li { position: static; }
        .dm-nav-panel, .dm-nav-links > li:nth-last-child(-n+3) .dm-nav-panel { top: 100%; left: 1rem; right: 1rem; min-width: 0; }
    }
</style>
<nav class="dm-nav" aria-label="Site">
    <div class="dm-nav-inner">
        <a href="{{ root }}index.html" class="dm-nav-logo"><img src="{{ root }}docs/assets/images/dismech_logo_color.png" alt="" width="605" height="835">DisMech</a>
        <ul class="dm-nav-links">
            <li><a href="{{ root }}app/index.html"{% if active == 'browse' %} class="active" aria-current="true"{% endif %}>Browse</a></li>
            {%- for title, items in menus %}
            {%- set ns = namespace(open=false) %}
            {%- for key, _label, _href in items %}{% if key == active %}{% set ns.open = true %}{% endif %}{% endfor %}
            <li>
                <details class="dm-nav-menu{% if ns.open %} active{% endif %}">
                    <summary>{{ title }}</summary>
                    <ul class="dm-nav-panel">
                        {%- for key, label, href in items %}
                        <li><a href="{{ root }}{{ href }}"{% if key == active %} class="active" aria-current="true"{% endif %}>{{ label }}</a></li>
                        {%- endfor %}
                    </ul>
                </details>
            </li>
            {%- endfor %}
            <li><a href="https://github.com/monarch-initiative/dismech" class="dm-nav-gh" aria-label="DisMech on GitHub" title="DisMech on GitHub"><svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg></a></li>
        </ul>
    </div>
</nav>
<script>
    (function () {
        var menus = document.querySelectorAll('nav.dm-nav details.dm-nav-menu');
        function closeAll(except) {
            for (var i = 0; i < menus.length; i++) { if (menus[i] !== except) { menus[i].open = false; } }
        }
        for (var i = 0; i < menus.length; i++) {
            menus[i].addEventListener('toggle', function (event) { if (event.target.open) { closeAll(event.target); } });
        }
        document.addEventListener('click', function (event) {
            if (!event.target.closest || !event.target.closest('details.dm-nav-menu')) { closeAll(null); }
        });
        document.addEventListener('keydown', function (event) {
            if (event.key !== 'Escape') { return; }
            var open = document.querySelector('nav.dm-nav details.dm-nav-menu[open]');
            if (open) { open.open = false; open.querySelector('summary').focus(); }
        });
    })();
</script>
