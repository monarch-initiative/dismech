            function formatGenomicRegion(region) {
                var parts = [region.name];
                if (region.chromosomal_region) parts.push(region.chromosomal_region);
                if (region.regulatory_element_type) parts.push(humanizeEnum(region.regulatory_element_type));
                if (region.between_genes && region.between_genes.length) {
                    parts.push("between genes: " + region.between_genes.map(formatGeneTerm).join(", "));
                }
                if (region.within_gene) parts.push("within gene: " + formatGeneTerm(region.within_gene));
                if (region.overlaps_genes && region.overlaps_genes.length) {
                    parts.push("overlaps genes: " + region.overlaps_genes.map(formatGeneTerm).join(", "));
                }
                if (region.adjacent_to_genes && region.adjacent_to_genes.length) {
                    parts.push("abuts genes (shared boundary): " + region.adjacent_to_genes.map(formatGeneTerm).join(", "));
                }
                if (region.description) parts.push(region.description);
                return parts.join("; ");
            }
