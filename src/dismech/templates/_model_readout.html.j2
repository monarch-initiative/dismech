{#
  One ExperimentalReadout (a proposed experiment's or a model link's). Wrapped
  by the render_experiment_readout macro on the disorder and module pages.
  Expects `readout` and `show_target`, plus render_entity_ref (only called when
  show_target), render_descriptor_tag(s) and render_evidence in context.
#}
<div class="experiment-subitem">
    <div class="experiment-subitem-name">{{ readout.name or 'Readout' }}</div>
    {% if readout.target and show_target %}
    <div class="entity-ref-list">{{ render_entity_ref(readout.target) }}</div>
    {% endif %}
    {% if readout.description %}
    <div style="margin-top: 6px;">{{ readout.description }}</div>
    {% endif %}
    {% if readout.phenotype_term %}
    <div class="item-meta">{{ render_descriptor_tag(readout.phenotype_term, "tag-phenotype", false, "readout.phenotype_term") }}</div>
    {% endif %}
    {% if readout.biomarker_term %}
    <div class="item-meta">{{ render_descriptor_tag(readout.biomarker_term, "tag-biomarker", false, "readout.biomarker_term") }}</div>
    {% endif %}
    {{ render_descriptor_tags(readout.biological_processes, "tag-bio", false, "readout.biological_processes") }}
    {{ render_descriptor_tags(readout.assays, "tag-dataset", false, "readout.assays") }}
    {% if readout.direction %}
    <div class="mapping-notes">Direction: {{ readout.direction | replace('_', ' ') }}</div>
    {% endif %}
    {% if readout.interpretation %}
    <div class="mapping-notes">Interpretation: {{ readout.interpretation }}</div>
    {% endif %}
    {{ render_evidence(readout.evidence, max_visible=1) }}
</div>
