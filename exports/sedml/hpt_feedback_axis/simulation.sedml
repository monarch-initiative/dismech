  <notes>
    <xhtml:p>dismech-perturb scenarios for hpt_feedback_axis (Congenital Hypothyroidism). Generated from models/hpt_feedback_axis.config.yaml by dismech.perturb.sedml_export; do not hand-edit. Scenario changes are resolved to absolute values against the SBML initial values, in the order dismech-perturb applies them: severity dial, then gene effect, then parameter overrides.</xhtml:p>
  </notes>
  <listOfModels>
    <model id="base_model" name="hpt_feedback_axis" language="urn:sedml:language:sbml" source="hpt_feedback_axis.xml" />
    <model id="model_subclinical_hypothyroidism" name="Subclinical primary hypothyroidism (S_thy=0.3)" language="urn:sedml:language:sbml" source="base_model">
      <notes>
        <xhtml:p>S_thy=0.3 (severity dial S_thy=0.3)</xhtml:p>
      </notes>
      <listOfChanges>
        <changeAttribute target="/sbml:sbml/sbml:model/sbml:listOfParameters/sbml:parameter[@id='S_thy']/@value" newValue="0.3" />
      </listOfChanges>
    </model>
    <model id="model_overt_hypothyroidism" name="Overt primary hypothyroidism (S_thy=0.1)" language="urn:sedml:language:sbml" source="base_model">
