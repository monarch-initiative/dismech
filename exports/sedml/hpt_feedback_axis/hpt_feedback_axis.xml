<?xml version="1.0" encoding="UTF-8"?>
<sbml xmlns="http://www.sbml.org/sbml/level3/version2/core" level="3" version="2">
  <model metaid="hpt_feedback_axis" id="hpt_feedback_axis">
    <listOfCompartments>
      <compartment sboTerm="SBO:0000410" id="default_compartment" spatialDimensions="3" size="1" constant="true"/>
    </listOfCompartments>
    <listOfSpecies>
      <species id="TSH" compartment="default_compartment" initialConcentration="1.5" hasOnlySubstanceUnits="false" boundaryCondition="false" constant="false"/>
      <species id="FT4" compartment="default_compartment" initialConcentration="15" hasOnlySubstanceUnits="false" boundaryCondition="false" constant="false"/>
    </listOfSpecies>
    <listOfParameters>
      <parameter id="TSH_prod" value="100" constant="true"/>
      <parameter id="kdeg_TSH" value="1" constant="true"/>
      <parameter id="Kfb" value="6.49" constant="true"/>
      <parameter id="n" value="5" constant="true"/>
      <parameter id="secr" value="0.5" constant="true"/>
      <parameter id="S_thy" value="1" constant="true"/>
      <parameter id="kdeg_T4" value="0.05" constant="true"/>
      <parameter id="LT4" value="0.01" constant="true"/>
      <parameter id="P_pit" value="1" constant="true"/>
    </listOfParameters>
    <listOfReactions>
      <reaction id="TSH_synthesis" reversible="true">
        <listOfProducts>
          <speciesReference species="TSH" stoichiometry="1" constant="true"/>
        </listOfProducts>
        <listOfModifiers>
          <modifierSpeciesReference species="FT4"/>
        </listOfModifiers>
        <kineticLaw>
          <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
              <minus/>
              <apply>
                <divide/>
                <apply>
                  <times/>
                  <ci> P_pit </ci>
                  <ci> TSH_prod </ci>
                </apply>
                <apply>
                  <plus/>
                  <cn type="integer"> 1 </cn>
                  <apply>
                    <power/>
                    <apply>
                      <divide/>
                      <ci> FT4 </ci>
                      <ci> Kfb </ci>
                    </apply>
                    <ci> n </ci>
                  </apply>
                </apply>
              </apply>
              <apply>
                <times/>
                <ci> kdeg_TSH </ci>
                <ci> TSH </ci>
              </apply>
            </apply>
          </math>
        </kineticLaw>
      </reaction>
      <reaction id="T4_synthesis" reversible="true">
        <listOfProducts>
          <speciesReference species="FT4" stoichiometry="1" constant="true"/>
        </listOfProducts>
        <listOfModifiers>
          <modifierSpeciesReference species="TSH"/>
        </listOfModifiers>
        <kineticLaw>
          <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
              <minus/>
              <apply>
                <plus/>
                <apply>
                  <times/>
                  <ci> secr </ci>
                  <ci> S_thy </ci>
                  <ci> TSH </ci>
                </apply>
                <ci> LT4 </ci>
              </apply>
              <apply>
                <times/>
                <ci> kdeg_T4 </ci>
                <ci> FT4 </ci>
              </apply>
            </apply>
          </math>
        </kineticLaw>
      </reaction>
    </listOfReactions>
  </model>
</sbml>
