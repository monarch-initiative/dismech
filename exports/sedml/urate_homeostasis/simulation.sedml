  <notes>
    <xhtml:p>dismech-perturb scenarios for urate_homeostasis (Gout). Generated from models/urate_homeostasis.config.yaml by dismech.perturb.sedml_export; do not hand-edit. Scenario changes are resolved to absolute values against the SBML initial values, in the order dismech-perturb applies them: severity dial, then gene effect, then parameter overrides.</xhtml:p>
  </notes>
  <listOfModels>
    <model id="base_model" name="urate_homeostasis" language="urn:sedml:language:sbml" source="urate_homeostasis.xml" />
    <model id="model_underexcretion_hyperuricemia" name="Underexcretion hyperuricemia (f_exc=0.5)" language="urn:sedml:language:sbml" source="base_model">
      <notes>
        <xhtml:p>f_exc=0.5 (severity dial f_exc=0.5)</xhtml:p>
      </notes>
      <listOfChanges>
        <changeAttribute target="/sbml:sbml/sbml:model/sbml:listOfParameters/sbml:parameter[@id='f_exc']/@value" newValue="0.5" />
      </listOfChanges>
    </model>
