      "records": {
        "kb/disorders/MMADHC-related_Disorder_of_Cobalamin_Metabolism_cblD_Type.yaml": {
          "blob_sha256": "b1be7702035ba664b4ccebdf25bd5f2f5f96bee69ecf5d99889607b99dc6a66d",
          "data": {
            "category": "Mendelian",
            "disease_term": {
              "preferred_term": "methylmalonic aciduria and/or homocystinuria, cblD type",
              "term": {
                "id": "MONDO:0100463",
                "label": "methylmalonic aciduria and/or homocystinuria, cblD type"
              }
            },
            "has_subtypes": [
              {
                "description": "Null alleles N-terminal to Met116. The mitochondrial arm fails, so adenosylcobalamin is not made and methylmalonate accumulates; homocysteine handling is spared.",
                "display_name": "cblD-variant 2, isolated methylmalonic aciduria",
                "evidence": [
                  {
                    "evidence_source": "IN_VITRO",
                    "explanation": "The mapping behind this row's description, showing that loss of the Met62-Met116 segment removes adenosylcobalamin synthesis while sparing methylcobalamin synthesis.",
                    "reference": "PMID:22156578",
                    "reference_title": "Molecular mechanisms leading to three different phenotypes in the cblD defect of intracellular cobalamin metabolism.",
                    "snippet": "Furthermore, our data indicate that the sequence after Met116 is sufficient for MeCbl synthesis, whereas the additional sequence between Met62 and Met116 is required for AdoCbl synthesis.",
                    "supports": "SUPPORT"
                  }
                ],
                "genes": [
                  {
                    "preferred_term": "MMADHC",
                    "term": {
                      "id": "hgnc:25221",
                      "label": "MMADHC"
                    }
                  }
                ],
                "name": "cblD-MMA",
                "subtype_term": {
                  "preferred_term": "isolated methylmalonic aciduria cblD type",
                  "term": {
                    "id": "MONDO:0700298",
                    "label": "isolated methylmalonic aciduria cblD type"
                  }
                }
              },
              {
                "description": "Missense alleles in a conserved C-terminal segment. The cytosolic arm fails, so methylcobalamin is not made and homocysteine accumulates; adenosylcobalamin synthesis is preserved.",
                "display_name": "cblD-variant 1, isolated homocystinuria",
                "evidence": [
                  {
                    "evidence_source": "HUMAN_CLINICAL",
                    "explanation": "The first description of the isolated-homocystinuria form within the cblD complementation group, later termed cblD-variant 1.",
                    "reference": "PMID:15292234",
                    "reference_title": "The cblD defect causes either isolated or combined deficiency of methylcobalamin and adenosylcobalamin synthesis.",
                    "snippet": "Two patients presented with isolated homocystinuria",
                    "supports": "SUPPORT"
                  },
                  {
                    "evidence_source": "HUMAN_CLINICAL",
                    "explanation": "Names the three clinical forms that the three subtype rows of this entry correspond to; the sentence frames the paper's own fibroblast work.",
                    "quote_role": "BACKGROUND",
                    "reference": "PMID:22156578",
                    "reference_title": "Molecular mechanisms leading to three different phenotypes in the cblD defect of intracellular cobalamin metabolism.",
                    "snippet": "The cblD defect of intracellular vitamin B(12) metabolism can lead to isolated methylmalonic aciduria (cblD-MMA) or homocystinuria (cblD-HC), or combined methylmalonic aciduria and homocystinuria (cblD-MMA/HC).",
                    "supports": "SUPPORT"
                  }
                ],
                "genes": [
                  {
                    "preferred_term": "MMADHC",
                    "term": {
                      "id": "hgnc:25221",
                      "label": "MMADHC"
                    }
                  }
                ],
                "name": "cblD-HC",
                "subtype_term": {
                  "preferred_term": "homocystinuria-megaloblastic anemia cblD type",
                  "term": {
                    "id": "MONDO:0700297",
                    "label": "homocystinuria-megaloblastic anemia cblD type"
                  }
                }
              },
              {
                "description": "Null alleles across the C-terminus. Both arms fail - the presentation of the original sibling pair in whom cblD was defined.",
                "display_name": "Classic combined cblD",
                "evidence": [
                  {
                    "evidence_source": "HUMAN_CLINICAL",
                    "explanation": "Records that the originally defined cblD presentation, in a single sibling pair, was combined homocystinuria and methylmalonic aciduria.",
                    "quote_role": "BACKGROUND",
                    "reference": "PMID:15292234",
                    "reference_title": "The cblD defect causes either isolated or combined deficiency of methylcobalamin and adenosylcobalamin synthesis.",
                    "snippet": "cblC, cblD (described in only two siblings), and cblF are associated with combined homocystinuria and methylmalonic aciduria",
                    "supports": "SUPPORT"
                  },
                  {
                    "evidence_source": "IN_VITRO",
                    "explanation": "In fibroblasts from the combined form, redirecting MMADHC to mitochondria trades methylcobalamin for adenosylcobalamin, the branch-point behaviour that lets one null allele class remove both arms.",
                    "reference": "PMID:22156578",
                    "reference_title": "Molecular mechanisms leading to three different phenotypes in the cblD defect of intracellular cobalamin metabolism.",
                    "snippet": "In cblD-MMA/HC cells, improving mitochondrial targeting of MMADHC clearly increased the formation of adenosylcobalamin (AdoCbl) with a concomitant decrease in MeCbl formation.",
                    "supports": "SUPPORT"
                  }
                ],
                "genes": [
                  {
                    "preferred_term": "MMADHC",
                    "term": {
                      "id": "hgnc:25221",
                      "label": "MMADHC"
                    }
                  }
                ],
                "name": "cblD-MMA/HC",
                "subtype_term": {
                  "preferred_term": "methylmalonic aciduria and homocystinuria type cblD",
                  "term": {
                    "id": "MONDO:0010185",
                    "label": "methylmalonic aciduria and homocystinuria type cblD"
                  }
                }
              }
            ],
            "mappings": {
              "mondo_mappings": [
                {
                  "mapping_justification": "The Orphanet-derived class (Orphanet:308380) for the isolated-homocystinuria form, curated here as the cblD-HC subtype. MONDO also carries an OMIM-derived class for the same form, MONDO:0700297 (OMIM:620952), which is that subtype's binding; the two are not linked in MONDO.",
                  "mapping_predicate": "skos:narrowMatch",
