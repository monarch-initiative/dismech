# Analyses justfile.
#
# Deliberately NOT wired into the repo's top-level justfile: nothing here runs in
# CI, and every recipe needs local semantic-sql ontology builds under
# ~/.data/oaklib/ (plus, for the boomer recipes, a boomer-py checkout). Adding
# them to `just --list` at the root would advertise recipes that fail for most
# people.
#
#   cd analyses && just --list
#
# Everything here regenerates committed output. Re-run after a MONDO refresh, or
# after KB changes that touch disease_term / subtype_term / mappings.

boomer_src := env_var_or_default("BOOMER_SRC", "~/repos/boomer-py/src")
oak_dir    := env_var_or_default("OAK_DIR", env_var("HOME") / ".data/oaklib")

_default:
    @just --list --unsorted

# Regenerate everything under boomer/ (the three recipes below, in order).
boomer-all: boomer-disorders boomer-groupings boomer-cross-source

# Per-disorder grounding analysis: one folder per disorder, plus index.tsv.
# Includes grounded subtype pairs plus the Mendelian expansion; prints progress every 50.
boomer-disorders:
    uv run --with networkx python boomer/scripts/build_analyses.py \
        --out boomer/disorders --index boomer/index.tsv \
        --boomer-src {{boomer_src}} --scope expanded --oak-dir {{oak_dir}} --with-icd10 \
        --selection-report boomer/mendelian.tsv

# Add Mendelian inputs marked NOT_RUN while preserving existing indexed results.
boomer-expand-mendelian:
    uv run --with networkx python boomer/scripts/build_analyses.py \
        --out boomer/disorders --index boomer/index.tsv \
        --scope mendelian --add-only --inputs-only --oak-dir {{oak_dir}} --with-icd10 \
        --selection-report boomer/mendelian.tsv

# One disorder only -- for iterating. e.g. `just boomer-one Adult_Refsum_Disease`
boomer-one slug:
    uv run --with networkx python boomer/scripts/build_analyses.py \
        --out boomer/disorders --index boomer/index.tsv --boomer-src {{boomer_src}} --only {{slug}} \
        --scope expanded --oak-dir {{oak_dir}} --with-icd10

# Prepare the checksum-pinned WHO ICD-10 label/hierarchy projection for OAK.
boomer-prepare-icd10:
    uv run python boomer/scripts/prepare_icd10.py --oak-dir {{oak_dir}}

# Add directional ICD hypotheses to existing Mendelian inputs; mark old solves stale.
boomer-enrich-icd10:
    uv run --with networkx python boomer/scripts/enrich_icd10_inputs.py \
        --oak-dir {{oak_dir}} --boomer-src {{boomer_src}}

# Import xref qualifiers from an explicitly pinned MONDO OBO source.
boomer-proxy-annotations obo source_url:
    uv run --with fastobo python boomer/scripts/proxy_merges.py --obo {{obo}} --source-url {{source_url}}

# Apply only annotation-supported proxy exceptions to saved Mendelian inputs.
boomer-proxy-migrate:
    uv run --with networkx python boomer/scripts/apply_proxy_merges.py --boomer-src {{boomer_src}}

# Solve the exact migrated cohort, with immutable source/input hashes and resumable checkpoints.
boomer-proxy-solve:
    uv run --with networkx python boomer/scripts/solve_pending.py --boomer-src {{boomer_src}} \
        --rerun-from boomer/proxy-merges/pending.tsv --run-name curated-proxy-merges

# Longer follow-up for seven formerly completed searches that reached the short limit.
boomer-proxy-retry:
    uv run --with networkx python boomer/scripts/solve_pending.py --boomer-src {{boomer_src}} \
        --rerun-from boomer/proxy-merges/retry.tsv --run-name curated-proxy-merges-retry \
        --timeout 300 --workers 2

boomer-proxy-summary:
    uv run python boomer/scripts/summarize_proxy_merges.py

# Recompute coverage separately from the historical pre-enrichment snapshot.
boomer-icd10-coverage:
    uv run python boomer/scripts/icd10_coverage.py --oak-dir {{oak_dir}} \
        --out boomer/icd10/current

# Fill missing external labels in existing KB inputs, without running the solver.
boomer-labels:
    uv run python boomer/scripts/build_analyses.py \
        --out boomer/disorders --labels-only --oak-dir {{oak_dir}}

# Grouping membership vs MONDO. No solver needed.
boomer-groupings:
    uv run python boomer/scripts/grouping_audit.py \
        --out boomer/groupings/violations.tsv

# dismech's direct ICD/NCIT mappings vs MONDO's own confirmed xrefs. No solver.
boomer-cross-source:
    uv run python boomer/scripts/crosssource_audit.py \
        --out boomer/cross-source/disagreements.tsv

# Solve one current input to stdout. A timeout is not a settled result; lowering
# -C can discard interacting hypotheses. Use boomer-one to regenerate saved results.
boomer-solve slug timeout="60":
    cd {{boomer_src}}/.. && uv run pyboomer solve \
        {{justfile_directory()}}/boomer/disorders/{{slug}}/kb.yaml \
        -t {{timeout}} -O markdown

# Solve every saved NOT_RUN/STALE_INPUT KB, checkpointing results without regenerating inputs.
# BOOMER_SRC must point to a clean checkout so each attempt has an exact solver revision.
boomer-solve-pending timeout="60" workers="8":
    uv run --with networkx python boomer/scripts/solve_pending.py \
        --boomer-src {{boomer_src}} --timeout {{timeout}} --workers {{workers}}

# Refresh the previously completed cohort using a clean, corrected solver checkout.
boomer-refresh-completed:
    uv run --with networkx python boomer/scripts/solve_pending.py --boomer-src {{boomer_src}} \
        --rerun-from boomer/runs/pending/attempts.tsv \
        --status ALL_MAPPINGS_CONSISTENT RETRACTED --run-name unique-solutions-completed

boomer-confidence:
    uv run python boomer/scripts/summarize_confidence.py

# Are the committed outputs still what the scripts produce? Prints a diff if not.
boomer-check:
    #!/usr/bin/env bash
    set -euo pipefail
    tmp=$(mktemp -d)
    uv run python boomer/scripts/grouping_audit.py --out "$tmp/g.tsv" >/dev/null
    uv run python boomer/scripts/crosssource_audit.py --out "$tmp/c.tsv" >/dev/null
    diff "$tmp/g.tsv" boomer/groupings/violations.tsv
    diff "$tmp/c.tsv" boomer/cross-source/disagreements.tsv
    echo "OK: solver-free outputs match the committed ones"
    echo "(boomer-disorders is not diffed here -- rerun it and check git status)"

# What ontology builds do these recipes need, and which are missing?
check-deps:
    #!/usr/bin/env bash
    missing=0
    for db in mondo doid ncit ordo omim icd10cm icd11f mesh efo; do
      if [ -f "{{oak_dir}}/$db.db" ]; then echo "  ok      $db.db"
      else echo "  MISSING $db.db"; missing=1; fi
    done
    if [ -f "{{oak_dir}}/icd10-who-2019.obo" ]; then
      echo "  ok      icd10-who-2019.obo"
    else
      echo "  MISSING WHO ICD-10 projection: run just boomer-prepare-icd10"
      missing=1
    fi
    if [ "$missing" = 1 ]; then
      echo
      echo "Fetch a missing one with:  uv run runoak -i sqlite:obo:<name> info CURIE"
      echo "mondo.db is required; the rest degrade to fewer corroborating sources."
    fi
