# Full-text PDFs downloaded by linkml-reference-validator >=0.2.1rc2
# (preprint EPMC full-text route). Binary, derived, regenerable on demand.
references_cache/files/

# openscientist run artifacts (heavy binaries; keep only the .md report + citations)
kb/hypotheses/**/openscientist_artifacts/

# Transient Monarch KG API caches for scripts/kg_*_gap_audit.py (regenerable)
research/.kg_gene_cache.json
research/.kg_pheno_cache.json

# EGA study index (regenerate with discover_ega.py --refresh)
data/ega/studies.json
data/arrayexpress/native_studies.json

# Zipped COMBINE archives — a byte-for-byte repackage of exports/sedml/<id>/,
# regenerated with `just sedml-export --omex`. The archive contents are
# committed as reviewable text; the binary zip is not.
exports/sedml/*.omex

# Ontology-label cache written by deep-research term validation
# (`just validate-research-terms`, and the `--validate-terms` flags the research
# recipes carry). Deliberately NOT `cache/`: those per-prefix CSVs are committed
# so that KB term validation is deterministic offline, and their rows correspond
# to terms actually bound in `kb/`. A provider's suggestion list is a different
# thing, and letting a research run write into the committed caches would add
# rows for terms nobody curated. Same file format, so a curator who wants the
# pre-warm can point the recipes at `cache/` for a run.
terms_cache/
